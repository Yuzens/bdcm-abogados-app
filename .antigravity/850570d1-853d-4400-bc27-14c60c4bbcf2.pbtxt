n    clientId: \'cli-5\',\n    installmentNumber: 3,\n    totalInstallments: 4,\n    dueDate: formatDate(25),\n    amount: 30,\n    currency: \'UF\',\n    status: \'PENDIENTE\',\n  },\n  {\n    id: \'inst-9\',\n    feeAgreementId: \'fee-3\',\n    caseId: \'case-3\',\n    clientId: \'cli-5\',\n    installmentNumber: 4,\n    totalInstallments: 4,\n    dueDate: formatDate(55),\n    amount: 30,\n    currency: \'UF\',\n    status: \'PENDIENTE\',\n  },\n  {\n    id: \'inst-10\',\n    feeAgreementId: \'fee-4\',\n    caseId: \'case-5\',\n    clientId: \'cli-3\',\n    installmentNumber: 1,\n    totalInstallments: 2,\n    dueDate: \'2024-05-15\',\n    amount: 1600000,\n    currency: \'CLP\',\n    status: \'PAGADA\',\n    paidDate: \'2024-05-14\',\n    paymentMethod: \'TRANSFERENCIA\',\n    receiptFolio: \'FACT-104\',\n  },\n  {\n    id: \'inst-11\',\n    feeAgreementId: \'fee-4\',\n    caseId: \'case-5\',\n    clientId: \'cli-3\',\n    installmentNumber: 2,\n    totalInstallments: 2,\n    dueDate: formatDate(10),\n    amount: 1600000,\n    currency: \'CLP\',\n    status: \'PENDIENTE\',\n    notes: \'Segunda cuota condicionada a alegatos en la Corte.\',\n  },\n];\n"
    num_lines: 639
