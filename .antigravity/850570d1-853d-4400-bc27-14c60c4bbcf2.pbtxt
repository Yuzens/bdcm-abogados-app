      thinking_signature: "\022\312\a\n\307\a\001i\024}\023\005I\a\026\"\363\341\214\213\025\305\220\2275\255/\226\211\346zK\350r\215\034`\231\f<\215\217F,{\343|\363\202\235\321\273\220\3155K*z\231\\Q\031\b<\245?nV\341r\232\376\235K\324V\316\236\337{\223$\376\302`\250\no\a\364\303\234\b~\305\277\246,A6\363\300\2353)\033\251\377\230|M\236\270\367O\3248\376>O\326\215\224s\226JSS\362k\363g\005\276K1\360\371\273\276X\361o\224\265q\355I+,\r\205\275\253Ec5Q}\214\225\017\"{\023\v\"\346\225q\363U\001\356\340]\375\217\022P\027<\374\245\374\247\nc\364\177\277qF\253\217\234@\232\353\027\301\243\354%[9Q\222(()\vM\264+\227\252\2177lX\320\362\026?\261\312\312/\247\346\317\277~\233\376<\035Tz\365\002\211\336\307\336\225\245^g\227Y\256\373\233\265\372\223\001\006?\232Ml\332p\235\274\215\347r\334c\036\214\317\037_\267\027\224@\2150\345,\304\221\241\364\262\312#\261\307\271\0352\243\037\032OX\036=\352k\253\374\327\203\r\322\306\370\f\263~-\354* 3I\031\363f\002\205\252\255\301\335)\002\261\210H@\311d]\343\375X\344\270\037\334\276\365\255\215;\270@(\253:!\320u\311\205i\253N\r|\220\031\375\213\234\226@\212\315\t\253\236\360\302?\341\362\022\225e\275[\330\354$\247G\205\215\201\363\251\003\2144\257\214\355\346\f\030pR\354\376\267=RG:\370\301a\326Z*te\3076\304\023O\311!\230\024l\bJ\000\334RW\300\306\307.L\311\024\304\214\227\037p\360\370\351,xh6\032]\227\357\252\346\303=[\365\222U\363\357\374\317\352\257h\205\253\210\\\366U\016\232\205?\376&\365p\336Wz,\351\302\224\337V}]\324\301\356`\036^\230\336v\330n,\316\271\262\221=\342,\323)of\263\023s\341M\262\225\243r\353\026\027\253=:g\306\177 \v\331\336\347]\001\025\027[\bjw\224\343C-#\212~\025\347TE\346\233\346\356\325\325F\001\031\336\244\t&\337`\327\0048Y\344\364\315D\334~\b\306\275-\207\246u\036\347\246/\266\031\322\241\223\346\246\254\201\300\237oin\311u\267}\372)\263\333\343\223\2350\262\372\306S\221\263V^S\265\320\276P\244\001\177\300\325\336F\361\177\354\372\017\036IK\032w\223zo\031\201\207\272 \037\345\n\026\246\231\241\246\tx\313A\037\3