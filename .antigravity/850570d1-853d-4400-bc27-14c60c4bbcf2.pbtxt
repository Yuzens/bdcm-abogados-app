  planner_response {
    thinking: "**Defining Hearing Modal**\n\nI\'m currently working on the `NewHearingModal` component. I\'m focusing on its core functionality, which is to create hearings. The plan is to associate it with either a specific case or a general firm meeting. It will allow selecting the hearing type (Preparatoria, Juicio Oral, Conciliaci\303\263n, etc.) and its modality (Telem\303\241tica Zoom PJUD, for now).\n\n\n"
    tool_calls {
      id: "call_302797"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useLegal } from \'../../context/LegalContext\';\\nimport { HearingType } from \'../../types\';\\nimport { X, Calendar, Video, MapPin, Users, CheckSquare } from \'lucide-react\';\\n\\ninterface Props {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  preselectedCaseId?: string;\\n}\\n\\nexport const NewHearingModal: React.FC<Props> = ({ isOpen, onClose, preselectedCaseId }) => {\\n  const { cases, addHearing, syncHearingToCalendar, googleAccessToken } = useLegal();\\n\\n  const [caseId, setCaseId] = useState(preselectedCaseId || (cases[0]?.id || \'\'));\\n  const [title, setTitle] = useState(\'\');\\n  const [type, setType] = useState<HearingType>(\'PREPARATORIA\');\\n  const [date, setDate] = useState(() => {\\n    const d = new Date();\\n    d.setDate(d.getDate() + 3);\\n    return d.toISOString().split(\'T\')[0];\\n  });\\n  const [startTime, setStartTime] = useState(\'09:30\');\\n  const [endTime, setEndTime] = useState(\'11:00\');\\n  const [modality, setModality] = useState<\'TELEMATICA_ZOOM\' | \'GOOGLE_MEET\' | \'PRESENCIAL\' | \'OTRA\'>(\'TELEMATICA_ZOOM\');\\n  const [courtRoomOrLink, setCourtRoomOrLink] = useState(\'https://pjud-cl.zoom.us/j/\');\\n  const [attendees, setAttendees] = useState(\'Abogado BDCM, Cliente\');\\n  const [notes, setNotes] = useState(\'\');\\n  const [syncToCalendarNow, setSyncToCalendarNow] = useState(true);\\n\\n  if (!isOpen) return null;\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!title.trim() || !date) {\\n      alert(\'Por favor completa el t\303\255tulo y la fecha.\');\\n      return;\\n    }\\n\\n    const newId = addHearing({\\n      caseId: caseId || undefined,\\n      title: title.trim(),\\n      type,\\n      date,\\n      startTime,\\n      endTime,\\n      modality,\\n      courtRoomOrLink: courtRoomOrLink.trim(),\\n      attendees: attendees.trim(),\\n      notes: notes.trim(),\\n      status: \'PROGRAMADA\',\\n      syncedToCalendar: false,\\n    });\\n\\n    if (syncToCalendarNow && googleAccessToken) {\\n      await syncHearingToCalendar(newId);\\n    }\\n\\n    onClose();\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs overflow-y-auto\\\">\\n      <div className=\\\"bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-150\\\">\\n        <div className=\\\"flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400\\\">\\n              <Calendar className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h2 className=\\\"text-lg font-bold text-slate-100 font-legal-heading\\\">Programar Audiencia o Reuni\303\263n</h2>\\n              <p className=\\\"text-xs text-slate-400\\\">Agenda judicial de BDCM Abogados</p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <form onSubmit={handleSubmit} className=\\\"p-6 space-y-4 max-h-[75vh] overflow-y-auto\\\">\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              Causa Vinculada (opcional)\\n            </label>\\n            <select\\n              value={caseId}\\n              onChange={(e) => setCaseId(e.target.value)}\\n              className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\\\"\\n            >\\n              <option value=\\\"\\\">-- Sin Causa (Reuni\303\263n interna del estudio) --</option>\\n              {cases.map((c) => (\\n                <option key={c.id} value={c.id}>\\n                  {c.rol} - {c.caratula} ({c.court})\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              T\303\255tulo de la Audiencia / Reuni\303\263n <span className=\\\"text-amber-400\\\">*</span>\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={title}\\n              onChange={(e) => setTitle(e.target.value)}\\n              placeholder=\\\"Ej: Audiencia Preparatoria de Juicio del Trabajo\\\"\\n              className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 font-medium\\\"\\n              required\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n                Tipo de Audiencia\\n              </label>\\n              <select\\n                value={type}\\n                onChange={(e) => setType(e.target.value as HearingType)}\\n                className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\\\"\\n              >\\n                <option value=\\\"PREPARATORIA\\\">Audiencia Preparatoria</option>\\n                <option value=\\\"JUICIO_ORAL\\\">Juicio Oral / Prueba</option>\\n                <option value=\\\"CONCILIACION\\\">Audiencia de Conciliaci\303\263n</option>\\n                <option value=\\\"MEDIDAS_CAUTELARES\\\">Formalizaci\303\263n / Cautelares</option>\\n                <option value=\\\"ALEGATOS\\\">Alegatos en Corte</option>\\n                <option value=\\\"REUNION_CLIENTE\\\">Reuni\303\263n con Cliente</option>\\n                <option value=\\\"DECLARACION\\\">Declaraci\303\263n de Testigo / Confesional</option>\\n                <option value=\\\"OTRA\\\">Otra Actuaci\303\263n</option>\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n                Modalidad\\n              </label>\\n              <select\\n                value={modality}\\n                onChange={(e) => {\\n                  const val = e.target.value as any;\\n                  setModality(val);\\n                  if (val === \'TELEMATICA_ZOOM\' && !courtRoomOrLink) {\\n                    setCourtRoomOrLink(\'https://pjud-cl.zoom.us/j/\');\\n                  } else if (val === \'GOOGLE_MEET\' && !courtRoomOrLink) {\\n                    setCourtRoomOrLink(\'https://meet.google.com/\');\\n                  }\\n                }}\\n                className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\\\"\\n              >\\n                <option value=\\\"TELEMATICA_ZOOM\\\">Telem\303\241tica (Zoom Poder Judicial)</option>\\n                <option value=\\\"GOOGLE_MEET\\\">Telem\303\241tica (Google Meet)</option>\\n                <option value=\\\"PRESENCIAL\\\">Presencial en Tribunal / Despacho</option>\\n                <option value=\\\"OTRA\\\">Otra</option>\\n              </select>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-3\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n                Fecha <span className=\\\"text-amber-400\\\">*</span>\\n              </label>\\n              <input\\n                type=\\\"date\\\"\\n                value={date}\\n                onChange={(e) => setDate(e.target.value)}\\n                className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\\\"\\n                required\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">Hora Inicio</label>\\n              <input\\n                type=\\\"time\\\"\\n                value={startTime}\\n                onChange={(e) => setStartTime(e.target.value)}\\n                className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">Hora T\303\251rmino</label>\\n              <input\\n                type=\\\"time\\\"\\n                value={endTime}\\n                onChange={(e) => setEndTime(e.target.value)}\\n                className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              Enlace de Conexi\303\263n o Sala / Direcci\303\263n\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={courtRoomOrLink}\\n              onChange={(e) => setCourtRoomOrLink(e.target.value)}\\n              placeholder=\\\"https://pjud-cl.zoom.us/j/... o Sala 304, Centro de Justicia\\\"\\n              className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 text-blue-400 font-mono-legal\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              Asistentes / Comparecientes\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={attendees}\\n              onChange={(e) => setAttendees(e.target.value)}\\n              placeholder=\\\"Abogado BDCM, Cliente, Perito, Testigos...\\\"\\n              className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\\\"\\n            />\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              Instrucciones y Minuta Previa\\n            </label>\\n            <textarea\\n              rows={2}\\n              value={notes}\\n              onChange={(e) => setNotes(e.target.value)}\\n              placeholder=\\\"Instrucciones para el cliente, puntos de prueba a acreditar, montos de conciliaci\303\263n...\\\"\\n              className=\\\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 resize-none\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"pt-1\\\">\\n            <label className=\\\"flex items-center gap-2 cursor-pointer\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={syncToCalendarNow}\\n                onChange={(e) => setSyncToCalendarNow(e.target.checked)}\\n                className=\\\"w-4 h-4 rounded-sm bg-slate-800 border-slate-700 text-amber-500 focus:ring-amber-500\\\"\\n              />\\n              <span className=\\\"text-xs text-slate-200 font-medium\\\">\\n                Sincronizar autom\303\241ticamente en Google Calendar\\n              </span>\\n            </label>\\n          </div>\\n\\n          <div className=\\\"flex items-center justify-end gap-3 pt-3 border-t border-slate-800\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              className=\\\"px-4 py-2 text-sm text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n            >\\n              Cancelar\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"px-5 py-2 bg-linear-to-r from-blue-500 to-blue-600 hover:from-blue-400 hover:to-blue-500 text-white font-semibold text-sm rounded-lg shadow-lg shadow-blue-500/20 transition-all flex items-center gap-2 cursor-pointer\\\"\\n            >\\n              <Calendar className=\\\"w-4 h-4\\\" />\\n              Agendar Audiencia\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Modal para programar audiencias y reuniones con soporte de enlaces PJUD y Google Calendar\",\"Overwrite\":true,\"TargetFile\":\"/src/components/modals/NewHearingModal.tsx\",\"toolAction\":\"Creando NewHearingModal\",\"toolSummary\":\"Crear NewHearingModal.tsx\"}"
      thinking_signature: "\022\234\005\n\231\005\001i\024}\023\353\036}\n\2361\317\343\002\177n\'\323W\3551\006\003\334\324N\237\336\230Q\314\f\301n\231\255\315!\200a;\252\276h?|\356\210W\'[M.h\\\315\321^\332\026\035\346h\314Kf\375\001)\210\220Z\r\351\335V\375\210\002\252&\220\271\b\303\002q\241\207\312\333\000\234Ab\v\233S.\245\276\312)CA\316\310|\351\035|yV\310m\370\324\\(?\213-\274\255\241\237G\305\035D\362\v&djr\215\026S\374\270\'\2664\0253`a\225,\002B;`\327O\246\202}\256\251\2563\0250\200\201g\3630\354M\225\n\377\245:i\241\023\2679\251<\030\030#\316\326l@\037\v=\245g/\352\025~Z\342\366\302>\326\330\306\3452K\223\344\226\230\227\n53\0309\003\177%\215\237\326@\"\252\2446\023<]I2\251\225\235\335\211\220\004h\242*r\r\000V$^HH\035\366c\200\247\231\207m-\350@\241\301*\345Q,\254O\3547\247\362\344~\3369\261\221\354=\251b\343\375Y\022\031%\222\353\200\362\026\363\273\373\246p2tD\317\026\336tI\335-\232\3206\325N\301\241_.\230J\370\212\035\252(\302\350V\277\233\244\320\211d)\303\363\332<\035\210\237\307\261k&\311=\240\216\253\213$\257\335\225\f,\222\376W\271\325\225m\201\005\355\317|\206\254\322\236\214\307\377\001m\264\265\244s\006jvU\313\354f\236\2327d_*Y\323rL\020\327r>p#z[\254\352|\203\027\035d\330\251lx\232\325\372{n[\236\337x\232a\353\211aX\250:\265G\353\322\303\t\001Tfb\324\216R\tu\227V\253x\313D1\360\251\224\332\242\305c$\271\375\313\000\324\240\234\277\214e\202\271\245r\022%\235\006\254\306X\204\266\247\367Wd\353\325)\033}\341\230\025\200L[\350\316j\0203\023\b6H\270\362P\312\3064B\317\001jg\332\251:F\031Ui{\337\3040\226e\362\0065\2553x\275\006|\022\327\256\320\a\276\030\364\226|\325\345\352\306\244\360\213$F\020\233\'\242F\254\321\357\000F\257O\3532%?\362\247\001zw\360J~f\365^\016*\262\251W\3346\240\212\022}\340k:\212J\314\376\207r*\\V\313\2609\333\372\322L+\242\254-\025\3359\"xq)A\2546\203\216\320\273f\030A3g\372;PA\266\314{c\332H\202\344k\324\211"
