            lines {
              text: "// Helper para calcular fechas relativas a hoy"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "const today = new Date();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "const formatDate = (offsetDays: number) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const d = new Date(today);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  d.setDate(d.getDate() + offsetDays);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return d.toISOString().split(\'T\')[0];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
