  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport {\n  Clock,\n  Plus,\n  Calendar,\n  AlertTriangle,\n  CheckCircle,\n  Trash2,\n  ExternalLink,\n  Download,\n  Calculator,\n  RefreshCw,\n  Sparkles,\n} from \'lucide-react\';\nimport {\n  formatDateCL,\n  getDaysRemaining,\n  buildGoogleCalendarUrl,\n  downloadIcsFile,\n} from \'../../utils/chileanLegal\';\n\ninterface Props {\n  onOpenNewDeadline: () => void;\n  onOpenCalculator: () => void;\n}\n\nexport const DeadlinesView: React.FC<Props> = ({ onOpenNewDeadline, onOpenCalculator }) => {\n  const {\n    deadlines,\n    cases,\n    toggleDeadlineStatus,\n    deleteDeadline,\n    syncDeadlineToCalendar,\n    syncAllToCalendar,\n    googleAccessToken,\n    connectGoogle,\n    setSelectedCaseId,\n    setActiveTab,\n  } = useLegal();\n\n  const [filter, setFilter] = useState<\'ALL\' | \'PENDING\' | \'URGENT\' | \'COMPLETED\'>(\'PENDING\');\n  const [syncingId, setSyncingId] = useState<string | null>(null);\n\n  const todayStr = new Date().toISOString().split(\'T\')[0];\n\n  const filteredDeadlines = deadlines.filter((dl) => {\n    if (filter === \'PENDING\') return dl.status === \'PENDIENTE\';\n    if (filter === \'COMPLETED\') return dl.status === \'CUMPLIDO\';\n    if (filter === \'URGENT\') {\n      return dl.status === \'PENDIENTE\' && (dl.deadlineDate <= todayStr || getDaysRemaining(dl.deadlineDate) <= 3);\n    }\n    return true;\n  }).sort((a, b) => a.deadlineDate.localeCompare(b.deadlineDate));\n\n  const handleSyncGoogle = async (deadlineId: string) => {\n    setSyncingId(deadlineId);\n    await syncDeadlineToCalendar(deadlineId);\n    setSyncingId(null);\n  };\n\n  const handleDownloadIcs = (dl: any, c: any) => {\n    downloadIcsFile({\n      filename: `Plazo_BDCM_${dl.id}`,\n      title: `[PLAZO FATAL] ${dl.title}`,\n      description: `Causa: ${c?.rol || \'\'} - ${c?.caratula || \'\'}\\nTribunal: ${c?.court || \'\'}\\nTipo plazo: ${dl.daysType}\\nNotas: ${dl.notes || \'\'}\\nEstudio: BDCM Abogados`,\n      startDate: dl.deadlineDate,\n      startTime: dl.deadlineTime || \'12:00\',\n      location: c?.court || \'Tribunales de Justicia\',\n    });\n  };\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold font-legal-heading text-slate-100 flex items-center gap-2.5\">\n            <Clock className=\"w-6 h-6 text-rose-400\" />\n            Plazos Procesales & Vencimientos Fatales\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Control de t\303\251rminos probatorios, recursos, traslados y sincronizaci\303\263n autom\303\241tica con Google Calendar\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start\">\n          <button\n            onClick={onOpenCalculator}\n            className=\"px-3 py-2 bg-slate-900 hover:bg-slate-800 text-amber-300 border border-slate-700 hover:border-amber-500/40 text-xs font-semibold rounded-xl flex items-center gap-1.5 transition-colors cursor-pointer\"\n          >\n            <Calculator className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline\">Calculadora de Plazos</span>\n          </button>\n\n          <button\n            onClick={onOpenNewDeadline}\n            className=\"px-4 py-2 bg-gradient-to-r from-rose-500 to-rose-600 hover:from-rose-400 hover:to-rose-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-rose-500/20 transition-all flex items-center gap-2 cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Nuevo Plazo\n          </button>\n        </div>\n      </div>\n\n      {/* Barra de Filtros & Sincronizaci\303\263n Google */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4\">\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => setFilter(\'PENDING\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer ${\n              filter === \'PENDING\'\n                ? \'bg-amber-500 text-slate-950\'\n                : \'bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-800\'\n            }`}\n          >\n            Pendientes ({deadlines.filter((d) => d.status === \'PENDIENTE\').length})\n          </button>\n          <button\n            onClick={() => setFilter(\'URGENT\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer ${\n              filter === \'URGENT\'\n                ? \'bg-rose-500 text-white\'\n                : \'bg-slate-900 text-rose-400 hover:text-rose-300 border border-slate-800\'\n            }`}\n          >\n            Urgentes / Hoy\n          </button>\n          <button\n            onClick={() => setFilter(\'COMPLETED\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer ${\n              filter === \'COMPLETED\'\n                ? \'bg-emerald-500 text-slate-950\'\n                : \'bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-800\'\n            }`}\n          >\n            Cumplidos ({deadlines.filter((d) => d.status === \'CUMPLIDO\').length})\n          </button>\n          <button\n            onClick={() => setFilter(\'ALL\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer ${\n              filter === \'ALL\'\n                ? \'bg-slate-700 text-slate-100\'\n                : \'bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-800\'\n            }`}\n          >\n            Todos ({deadlines.length})\n          </button>\n        </div>\n\n        <div>\n          {googleAccessToken ? (\n            <button\n              onClick={() => syncAllToCalendar()}\n              className=\"text-xs text-amber-400 hover:text-amber-300 flex items-center gap-1.5 font-medium cursor-pointer\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              Sincronizar todos a Google Calendar\n            </button>\n          ) : (\n            <button\n              onClick={connectGoogle}\n              className=\"text-xs text-amber-400 hover:text-amber-300 flex items-center gap-1.5 font-medium cursor-pointer\"\n            >\n              <Calendar className=\"w-3.5 h-3.5\" />\n              Conectar Google para sincronizar\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Lista de Plazos */}\n      <div className=\"space-y-3\">\n        {filteredDeadlines.length === 0 ? (\n          <div className=\"bg-slate-900/60 border border-slate-800 rounded-2xl p-8 text-center space-y-2\">\n            <CheckCircle className=\"w-10 h-10 text-emerald-400 mx-auto\" />\n            <p className=\"text-sm font-semibold text-slate-200\">No hay plazos en esta vista</p>\n            <p className=\"text-xs text-slate-400\">Todos los vencimientos procesales se encuentran al d\303\255a.</p>\n          </div>\n        ) : (\n          filteredDeadlines.map((dl) => {\n            const c = cases.find((item) => item.id === dl.caseId);\n            const daysLeft = getDaysRemaining(dl.deadlineDate);\n            const isToday = daysLeft === 0;\n            const isPast = daysLeft < 0;\n            const isCompleted = dl.status === \'CUMPLIDO\';\n\n            const googleDirectUrl = buildGoogleCalendarUrl({\n              title: `[PLAZO FATAL] ${dl.title}`,\n              details: `Causa: ${c?.rol || \'\'} - ${c?.caratula || \'\'}\\nTribunal: ${c?.court || \'\'}\\nTipo plazo: ${dl.daysType}\\nNotas: ${dl.notes || \'\'}`,\n              location: c?.court || \'Tribunal\',\n              startDate: dl.deadlineDate,\n              startTime: dl.deadlineTime || \'12:00\',\n            });\n\n            return (\n              <div\n                key={dl.id}\n                className={`p-4 sm:p-5 rounded-2xl border transition-all flex flex-col md:flex-row md:items-center justify-between gap-4 ${\n                  isCompleted\n                    ? \'bg-slate-950/40 border-slate-800/60 opacity-75\'\n                    : isPast\n                    ? \'bg-rose-950/20 border-rose-500/40 shadow-sm shadow-rose-500/10\'\n                    : isToday\n                    ? \'bg-amber-950/20 border-amber-500/40 shadow-sm shadow-amber-500/10\'\n                    : \'bg-slate-900/80 border-slate-800 hover:border-slate-700\'\n                }`}\n              >\n                {/* Lado izquierdo: Datos del Plazo */}\n                <div className=\"space-y-2 flex-1\">\n                  <div className=\"flex flex-wrap items-center gap-2\">\n                    {c && (\n                      <button\n                        onClick={() => {\n                          setSelectedCaseId(c.id);\n                          setActiveTab(\'cases\');\n                        }}\n                        className=\"font-mono-legal text-xs font-bold text-amber-400 hover:underline\"\n                      >\n                        {c.rol}\n                      </button>\n                    )}\n\n                    {dl.isFatal && (\n                      <span className=\"px-2 py-0.5 rounded-sm bg-rose-500/20 text-rose-300 text-[10px] font-bold border border-rose-500/30\">\n                        PLAZO FATAL\n                      </span>\n                    )}\n\n                    <span className=\"px-2 py-0.5 rounded-sm bg-slate-800 text-slate-300 text-[10px] font-medium border border-slate-700\">\n                      {dl.daysType === \'HABILES_CIVIL\'\n                        ? \'H\303\241biles Civil (CPC Art. 66)\'\n                        : dl.daysType === \'HABILES_LABORAL\'\n                        ? \'H\303\241biles Laboral (Lun-Vie)\'\n                        : \'D\303\255as Corridos\'}\n                    </span>\n\n                    {dl.syncedToCalendar && (\n                      <span className=\"px-2 py-0.5 rounded-sm bg-emerald-500/15 text-emerald-400 text-[10px] font-semibold flex items-center gap-1 border border-emerald-500/30\">\n                        <Calendar className=\"w-3 h-3\" />\n                        Sincronizado a Google Calendar\n                      </span>\n                    )}\n                  </div>\n\n                  <h3\n                    className={`text-sm sm:text-base font-bold ${\n                      isCompleted ? \'text-slate-400 line-through\' : \'text-slate-100\'\n                    }`}\n                  >\n                    {dl.title}\n                  </h3>\n\n                  {c && (\n                    <p className=\"text-xs text-slate-400 truncate max-w-xl\">\n                      {c.caratula} \342\200\242 <span className=\"text-slate-300\">{c.court}</span>\n                    </p>\n                  )}\n\n                  {dl.notes && (\n                    <p className=\"text-xs text-slate-400 bg-slate-950/60 p-2 rounded-lg border border-slate-800 max-w-xl\">\n                      {dl.notes}\n                    </p>\n                  )}\n                </div>\n\n                {/* Lado derecho: Estado de tiempo y acciones */}\n                <div className=\"flex flex-row md:flex-col items-center md:items-end justify-between gap-3 pt-3 md:pt-0 border-t md:border-t-0 border-slate-800 shrink-0\">\n                  <div className=\"text-left md:text-right\">\n                    <div className=\"text-xs font-mono-legal text-slate-300\">\n                      Vence: <span className=\"font-bold text-slate-100\">{formatDateCL(dl.deadlineDate)}</span>\n                    </div>\n                    <div className=\"text-[11px] text-slate-400 font-mono-legal\">\n                      Hora l\303\255mite: {dl.deadlineTime} hrs\n                    </div>\n\n                    {!isCompleted && (\n                      <div className=\"mt-1\">\n                        <span\n                          className={`text-xs font-bold font-mono-legal ${\n                            isPast\n                              ? \'text-rose-400\'\n                              : isToday\n                              ? \'text-amber-400 animate-pulse\'\n                              : daysLeft <= 3\n                              ? \'text-yellow-400\'\n                              : \'text-slate-400\'\n                          }`}\n                        >\n                          {isPast\n                            ? `Vencido hace ${Math.abs(daysLeft)} d\303\255as`\n                            : isToday\n                            ? \'\302\241VENCE HOY!\'\n                            : `Faltan ${daysLeft} d\303\255as`}\n                        </span>\n                      </div>\n                    )}\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    {/* Bot\303\263n Sincronizar Google */}\n                    {googleAccessToken ? (\n                      <button\n                        onClick={() => handleSyncGoogle(dl.id)}\n                        disabled={syncingId === dl.id}\n                        className=\"px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-semibold rounded-lg border border-slate-700 transition-colors flex items-center gap-1 cursor-pointer\"\n                        title=\"Sincronizar a Google Calendar del abogado\"\n                      >\n                        <Calendar className=\"w-3.5 h-3.5 text-amber-400\" />\n                        <span className=\"hidden sm:inline\">\n                          {dl.syncedToCalendar ? \'Actualizar\' : \'Google Cal\'}\n                        </span>\n                      </button>\n                    ) : (\n                      <a\n                        href={googleDirectUrl}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-semibold rounded-lg border border-slate-700 transition-colors flex items-center gap-1\"\n                        title=\"Crear evento en Google Calendar Web\"\n                      >\n                        <ExternalLink className=\"w-3.5 h-3.5 text-amber-400\" />\n                        <span className=\"hidden sm:inline\">Google Cal</span>\n                      </a>\n                    )}\n\n                    {/* Descargar ICS */}\n                    <button\n                      onClick={() => handleDownloadIcs(dl, c)}\n                      className=\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg border border-slate-700 transition-colors\"\n                      title=\"Descargar archivo de calendario .ics\"\n                    >\n                      <Download className=\"w-3.5 h-3.5\" />\n                    </button>\n\n                    {/* Cumplir / Reabrir */}\n                    <button\n                      onClick={() => toggleDeadlineStatus(dl.id)}\n                      className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${\n                        isCompleted\n                          ? \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n                          : \'bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-xs shadow-emerald-500/20\'\n                      }`}\n                    >\n                      <CheckCircle className=\"w-3.5 h-3.5\" />\n                      <span>{isCompleted ? \'Reabrir\' : \'Cumplido\'}</span>\n                    </button>\n\n                    <button\n                      onClick={() => deleteDeadline(dl.id)}\n                      className=\"p-1.5 text-slate-500 hover:text-rose-400 rounded-lg transition-colors\"\n                      title=\"Eliminar plazo\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/views/DeadlinesView.tsx"
        }
        overwrite: true
      }
    }
