              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (type === \'HABILES_LABORAL\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
