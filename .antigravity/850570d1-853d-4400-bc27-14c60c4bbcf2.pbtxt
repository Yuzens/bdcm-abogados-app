              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateLegalDeadline("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  startDateStr: string,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  daysCount: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  type: \'HABILES_CIVIL\' | \'HABILES_LABORAL\' | \'CORRIDOS\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): { deadlineDate: string; breakdown: string[] } {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [year, month, day] = startDateStr.split(\'-\').map(Number);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Comenzar al d\303\255a siguiente de la notificaci\303\263n (Art. 67 CPC chileno)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const currentDate = new Date(year, month - 1, day);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  currentDate.setDate(currentDate.getDate() + 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const breakdown: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let countedDays = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (type === \'CORRIDOS\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    while (countedDays < daysCount) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const isSun = currentDate.getDay() === 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const isHol = isHolidayInChile(currentDate);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dateStr = currentDate.toISOString().split(\'T\')[0];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      countedDays++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      breakdown.push(`D\303\255a ${countedDays}: ${dateStr} ${isHol ? \'(Feriado)\' : isSun ? \'(Domingo)\' : \'\'}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (countedDays < daysCount) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        currentDate.setDate(currentDate.getDate() + 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Si vence en d\303\255a inh\303\241bil procesal, prorrogar al primer d\303\255a h\303\241bil siguiente (Art. 67 CPC)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    while (currentDate.getDay() === 0 || isHolidayInChile(currentDate)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      currentDate.setDate(currentDate.getDate() + 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      breakdown.push(`Prorroga legal por d\303\255a inh\303\241bil: pasa al ${currentDate.toISOString().split(\'T\')[0]}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (type === \'HABILES_CIVIL\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Lunes (1) a S\303\241bado (6) h\303\241biles excepto feriados"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    while (countedDays < daysCount) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dayOfWeek = currentDate.getDay();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const isSunday = dayOfWeek === 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const isHol = isHolidayInChile(currentDate);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSunday && !isHol) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        countedDays++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        breakdown.push(`D\303\255a h\303\241bil ${countedDays}: ${currentDate.toISOString().split(\'T\')[0]}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        breakdown.push(`Inh\303\241bil saltado (${isSunday ? \'Domingo\' : \'Feriado\'}): ${currentDate.toISOString().split(\'T\')[0]}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
