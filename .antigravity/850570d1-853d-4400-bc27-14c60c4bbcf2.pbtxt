  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport { FeeInstallment } from \'../../types\';\nimport { formatCurrency, formatDateCL } from \'../../utils/chileanLegal\';\nimport { X, Printer, ShieldCheck, Scale } from \'lucide-react\';\n\ninterface Props {\n  installment: FeeInstallment | null;\n  onClose: () => void;\n}\n\nexport const ReceiptModal: React.FC<Props> = ({ installment, onClose }) => {\n  const { cases, clients } = useLegal();\n\n  if (!installment) return null;\n\n  const currentCase = cases.find((c) => c.id === installment.caseId);\n  const client = clients.find((cli) => cli.id === installment.clientId);\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs overflow-y-auto print:p-0 print:bg-white\">\n      <div className=\"bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden print:border-none print:shadow-none print:bg-white print:text-black\">\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60 print:hidden\">\n          <div className=\"flex items-center gap-2 text-amber-400\">\n            <Scale className=\"w-5 h-5\" />\n            <span className=\"font-semibold text-sm font-legal-heading\">Comprobante Oficial BDCM Abogados</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handlePrint}\n              className=\"px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-semibold rounded-lg flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              Imprimir / PDF\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Cuerpo del Recibo Formal con membrete */}\n        <div className=\"p-8 space-y-6 print:p-10 text-slate-200 print:text-slate-900 bg-slate-900 print:bg-white\">\n          <div className=\"flex items-start justify-between border-b border-slate-800 print:border-slate-300 pb-6\">\n            <div>\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400 print:text-amber-800\">\n                  <Scale className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h1 className=\"text-xl font-bold font-legal-heading text-amber-400 print:text-slate-900\">\n                    BDCM ABOGADOS\n                  </h1>\n                  <p className=\"text-[11px] text-slate-400 print:text-slate-600 tracking-wider\">\n                    ESTUDIO JUR\303\215DICO & LITIGIOS \342\200\224 CHILE\n                  </p>\n                </div>\n              </div>\n              <p className=\"text-xs text-slate-400 print:text-slate-600 mt-2\">\n                Santiago de Chile \342\200\242 www.bdcm.cl \342\200\242 contacto@bdcm.cl\n              </p>\n            </div>\n            <div className=\"text-right\">\n              <span className=\"inline-block px-3 py-1 bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 print:text-emerald-700 font-mono-legal text-xs font-bold rounded-lg mb-1\">\n                RECIBO N\302\260 {installment.id.replace(\'inst-\', \'REC-\')}\n              </span>\n              <p className=\"text-xs text-slate-400 print:text-slate-600\">\n                Fecha de Emisi\303\263n: {formatDateCL(installment.paidDate || new Date().toISOString().split(\'T\')[0])}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-6 text-xs bg-slate-950/40 print:bg-slate-50 p-4 rounded-xl border border-slate-800/80 print:border-slate-200\">\n            <div>\n              <span className=\"text-[10px] uppercase font-bold text-slate-400 print:text-slate-500 block mb-1\">\n                Cliente Patrocinado\n              </span>\n              <p className=\"font-semibold text-slate-100 print:text-slate-900 text-sm\">\n                {client?.name || \'Cliente\'}\n              </p>\n              <p className=\"text-slate-400 print:text-slate-600 font-mono-legal\">RUT: {client?.rut || \'Sin RUT\'}</p>\n              <p className=\"text-slate-400 print:text-slate-600\">{client?.email || \'\'}</p>\n              <p className=\"text-slate-400 print:text-slate-600\">{client?.phone || \'\'}</p>\n            </div>\n            <div>\n              <span className=\"text-[10px] uppercase font-bold text-slate-400 print:text-slate-500 block mb-1\">\n                Causa Judicial\n              </span>\n              <p className=\"font-semibold text-slate-100 print:text-slate-900 font-mono-legal\">\n                ROL/RIT: {currentCase?.rol || \'Sin ROL\'}\n              </p>\n              <p className=\"text-slate-300 print:text-slate-700 truncate\">{currentCase?.caratula}</p>\n              <p className=\"text-slate-400 print:text-slate-600\">{currentCase?.court}</p>\n              <p className=\"text-slate-400 print:text-slate-600\">Materia: {currentCase?.subject}</p>\n            </div>\n          </div>\n\n          <div className=\"border border-slate-800 print:border-slate-200 rounded-xl overflow-hidden\">\n            <table className=\"w-full text-left text-xs\">\n              <thead className=\"bg-slate-950/70 print:bg-slate-100 border-b border-slate-800 print:border-slate-200 text-slate-400 print:text-slate-600\">\n                <tr>\n                  <th className=\"py-2.5 px-4 font-semibold\">Concepto</th>\n                  <th className=\"py-2.5 px-4 font-semibold text-center\">Cuota</th>\n                  <th className=\"py-2.5 px-4 font-semibold text-center\">Medio de Pago</th>\n                  <th className=\"py-2.5 px-4 font-semibold text-right\">Monto</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800 print:divide-slate-200 font-mono-legal\">\n                <tr>\n                  <td className=\"py-3 px-4 font-sans text-slate-200 print:text-slate-800\">\n                    Honorarios profesionales por patrocinio y poder judicial\n                    {installment.receiptFolio && (\n                      <div className=\"text-[11px] text-amber-400 print:text-amber-800 mt-0.5\">\n                        Folio Documento Tributario: {installment.receiptFolio}\n                      </div>\n                    )}\n                  </td>\n                  <td className=\"py-3 px-4 text-center text-slate-300 print:text-slate-700\">\n                    {installment.installmentNumber} / {installment.totalInstallments}\n                  </td>\n                  <td className=\"py-3 px-4 text-center text-slate-300 print:text-slate-700\">\n                    {installment.paymentMethod || \'TRANSFERENCIA\'}\n                  </td>\n                  <td className=\"py-3 px-4 text-right font-bold text-emerald-400 print:text-emerald-700 text-sm\">\n                    {formatCurrency(installment.amount, installment.currency)}\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n\n          {installment.notes && (\n            <div className=\"p-3 bg-slate-950/40 print:bg-slate-50 border border-slate-800 print:border-slate-200 rounded-lg text-xs text-slate-400 print:text-slate-600\">\n              <span className=\"font-semibold text-slate-300 print:text-slate-700\">Observaciones: </span>\n              {installment.notes}\n            </div>\n          )}\n\n          <div className=\"pt-8 border-t border-slate-800 print:border-slate-200 grid grid-cols-2 gap-12 text-center text-xs\">\n            <div className=\"space-y-1\">\n              <div className=\"border-b border-slate-700 print:border-slate-400 w-3/4 mx-auto pb-6\">\n                <span className=\"font-serif italic text-amber-300 print:text-amber-900 text-base\">\n                  BDCM Abogados\n                </span>\n              </div>\n              <p className=\"font-semibold text-slate-200 print:text-slate-800\">BDCM ABOGADOS</p>\n              <p className=\"text-[11px] text-slate-500\">Firma Autorizada de Cobranzas</p>\n            </div>\n            <div className=\"space-y-1\">\n              <div className=\"border-b border-slate-700 print:border-slate-400 w-3/4 mx-auto pb-6\">\n                <span className=\"font-serif italic text-slate-400 print:text-slate-600 text-sm\">\n                  {client?.name?.slice(0, 24)}\n                </span>\n              </div>\n              <p className=\"font-semibold text-slate-200 print:text-slate-800\">{client?.name || \'Cliente\'}</p>\n              <p className=\"text-[11px] text-slate-500\">Conforme Receptor / Cliente</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/modals/ReceiptModal.tsx"
        }
        overwrite: true
      }
    }
