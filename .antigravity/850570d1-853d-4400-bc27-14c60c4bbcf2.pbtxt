        instruction: "export type ClientType = \'PERSONA_NATURAL\' | \'PERSONA_JURIDICA\';\n\nexport interface Client {\n  id: string;\n  rut: string;\n  name: string;\n  clientType: ClientType;\n  email: string;\n  phone: string;\n  address: string;\n  commune: string;\n  region: string;\n  representativeName?: string;\n  representativeRut?: string;\n  notes?: string;\n  createdAt: string;\n}\n\nexport type CourtType =\n  | \'CIVIL\'\n  | \'LABORAL\'\n  | \'FAMILIA\'\n  | \'GARANTIA\'\n  | \'TOP\'\n  | \'CORTE_APELACIONES\'\n  | \'CORTE_SUPREMA\'\n  | \'POLICIA_LOCAL\'\n  | \'ARBITRAL\';\n\nexport type LegalSubject =\n  | \'Civil\'\n  | \'Laboral\'\n  | \'Familia\'\n  | \'Penal\'\n  | \'Comercial\'\n  | \'Inmobiliario\'\n  | \'Polic\303\255a Local\'\n  | \'Constitucional\'\n  | \'Cobranza Judicial\'\n  | \'Corporativo\';\n\nexport type ClientRole =\n  | \'DEMANDANTE\'\n  | \'DEMANDADO\'\n  | \'QUERELLANTE\'\n  | \'IMPUTADO\'\n  | \'RECURRENTE\'\n  | \'RECURRIDO\'\n  | \'SOLICITANTE\'\n  | \'TERCERO\';\n\nexport type CaseStatus =\n  | \'TRAMITACION\'\n  | \'CITACION_SENTENCIA\'\n  | \'EN_ACUERDO\'\n  | \'SUSPENDIDA\'\n  | \'APELACION\'\n  | \'ARCHIVADA\'\n  | \'TERMINADA\';\n\nexport interface CaseEvent {\n  id: string;\n  date: string;\n  title: string;\n  description: string;\n  actor: string;\n  documentName?: string;\n}\n\nexport interface LegalCase {\n  id: string;\n  rol: string;\n  caratula: string;\n  court: string;\n  courtType: CourtType;\n  subject: LegalSubject;\n  clientId: string;\n  clientRole: ClientRole;\n  opposingParty: string;\n  opposingLawyer?: string;\n  status: CaseStatus;\n  assignedLawyer: string;\n  currency: \'CLP\' | \'UF\';\n  amount?: number;\n  pjudLink?: string;\n  notes?: string;\n  createdAt: string;\n  updatedAt: string;\n  timeline: CaseEvent[];\n}\n\nexport type DeadlineDaysType = \'HABILES_CIVIL\' | \'HABILES_LABORAL\' | \'CORRIDOS\';\n\nexport interface CaseDeadline {\n  id: string;\n  caseId: string;\n  title: string;\n  deadlineDate: string;\n  deadlineTime: string;\n  isFatal: boolean;\n  daysType: DeadlineDaysType;\n  daysCount?: number;\n  status: \'PENDIENTE\' | \'CUMPLIDO\' | \'VENCIDO\';\n  priority: \'ALTA\' | \'MEDIA\' | \'BAJA\';\n  alertDaysBefore: number;\n  notes?: string;\n  syncedToCalendar?: boolean;\n  googleEventId?: string;\n  createdAt: string;\n}\n\nexport type HearingType =\n  | \'PREPARATORIA\'\n  | \'JUICIO_ORAL\'\n  | \'CONCILIACION\'\n  | \'MEDIDAS_CAUTELARES\'\n  | \'ALEGATOS\'\n  | \'REUNION_CLIENTE\'\n  | \'DECLARACION\'\n  | \'OTRA\';\n\nexport interface Hearing {\n  id: string;\n  caseId?: string;\n  title: string;\n  type: HearingType;\n  date: string;\n  startTime: string;\n  endTime: string;\n  modality: \'PRESENCIAL\' | \'TELEMATICA_ZOOM\' | \'GOOGLE_MEET\' | \'OTRA\';\n  courtRoomOrLink: string;\n  attendees: string;\n  notes?: string;\n  status: \'PROGRAMADA\' | \'REALIZADA\' | \'SUSPENDIDA\' | \'CANCELADA\';\n  syncedToCalendar?: boolean;\n  googleEventId?: string;\n}\n\nexport type FeeType = \'FIJO\' | \'CUOTA_LITIS\' | \'MIXTO\' | \'MENSUAL\';\n\nexport interface FeeAgreement {\n  id: string;\n  caseId: string;\n  clientId: string;\n  feeType: FeeType;\n  currency: \'CLP\' | \'UF\';\n  totalAmount: number;\n  installmentsCount: number;\n  notes?: string;\n  createdAt: string;\n}\n\nexport interface FeeInstallment {\n  id: string;\n  feeAgreementId: string;\n  caseId: string;\n  clientId: string;\n  installmentNumber: number;\n  totalInstallments: number;\n  dueDate: string;\n  amount: number;\n  currency: \'CLP\' | \'UF\';\n  status: \'PENDIENTE\' | \'PAGADA\' | \'ATRASADA\';\n  paidDate?: string;\n  paymentMethod?: \'TRANSFERENCIA\' | \'VALE_VISTA\' | \'CHEQUE\' | \'WEBPAY\' | \'EFECTIVO\';\n  receiptFolio?: string;\n  notes?: string;\n}\n\nexport interface LawyerUser {\n  id: string;\n  name: string;\n  email: string;\n  role: string;\n  rut?: string;\n  avatarColor?: string;\n}\n"
