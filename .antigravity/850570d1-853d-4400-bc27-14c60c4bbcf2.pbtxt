            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Calcula la fecha de vencimiento seg\303\272n el tipo de c\303\263mputo de la ley chilena"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - H\303\241biles Civil (CPC Art. 66): Lunes a S\303\241bado, no feriados (el domingo es inh\303\241bil)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - H\303\241biles Laboral / Penal: Lunes a Viernes, no feriados (s\303\241bado y domingo inh\303\241biles)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * - Corridos: Todos los d\303\255as continuos. Si el \303\272ltimo d\303\255a es feriado o domingo, en civil pasa al primer h\303\241bil siguiente."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
