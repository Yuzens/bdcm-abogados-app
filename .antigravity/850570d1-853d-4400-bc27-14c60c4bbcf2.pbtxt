\n    currency: \'CLP\',\n    totalAmount: 4500000,\n    installmentsCount: 3,\n    notes: \'Honorario fijo de $ 4.500.000 pagadero en 3 cuotas mensuales, m\303\241s cuota litis de 10% sobre suma recuperada.\',\n    createdAt: \'2024-02-05\',\n  },\n  {\n    id: \'fee-2\',\n    caseId: \'case-2\',\n    clientId: \'cli-2\',\n    feeType: \'CUOTA_LITIS\',\n    currency: \'CLP\',\n    totalAmount: 1800000,\n    installmentsCount: 2,\n    notes: \'Gasto inicial de tramitaci\303\263n $ 600.000 + cuota litis del 20% al \303\251xito del juicio.\',\n    createdAt: \'2024-03-25\',\n  },\n  {\n    id: \'fee-3\',\n    caseId: \'case-3\',\n    clientId: \'cli-5\',\n    feeType: \'FIJO\',\n    currency: \'UF\',\n    totalAmount: 120,\n    installmentsCount: 4,\n    notes: \'Honorario integral de defensa penal etapa de investigaci\303\263n formalizada: 120 UF en 4 cuotas de 30 UF.\',\n    createdAt: \'2024-08-18\',\n  },\n  {\n    id: \'fee-4\',\n    caseId: \'case-5\',\n    clientId: \'cli-3\',\n    feeType: \'FIJO\',\n    currency: \'CLP\',\n    totalAmount: 3200000,\n    installmentsCount: 2,\n    notes: \'Patrocinio en Recurso de Protecci\303\263n: 2 cuotas de $ 1.600.000.\',\n    createdAt: \'2024-05-05\',\n  },\n];\n\nexport const INITIAL_INSTALLMENTS: FeeInstallment[] = [\n  {\n    id: \'inst-1\',\n    feeAgreementId: \'fee-1\',\n    caseId: \'case-1\',\n    clientId: \'cli-1\',\n    installmentNumber: 1,\n    totalInstallments: 3,\n    dueDate: \'2024-03-05\',\n    amount: 1500000,\n    currency: \'CLP\',\n    status: \'PAGADA\',\n    paidDate: \'2024-03-04\',\n    paymentMethod: \'TRANSFERENCIA\',\n    receiptFolio: \'BHE-842\',\n    notes: \'Transferencia Banco de Chile recibida.\',\n  },\n  {\n    id: \'inst-2\',\n    feeAgreementId: \'fee-1\',\n    caseId: \'case-1\',\n    clientId: \'cli-1\',\n    installmentNumber: 2,\n    totalInstallments: 3,\n    dueDate: formatDate(-15),\n    amount: 1500000,\n    currency: \'CLP\',\n    status: \'ATRASADA\',\n    notes: \'Se en