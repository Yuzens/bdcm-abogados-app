  view_file {
    absolute_path_uri: "file:///src/components/views/ToolsView.tsx"
    start_line: 379
    end_line: 441
    content: "            <span className=\"font-bold text-slate-200 block text-sm\">Restablecer Muestra</span>\n            <p className=\"text-slate-400\">\n              Reinicia los datos a los expedientes iniciales de prueba de BDCM Abogados en Chile.\n            </p>\n            <button\n              onClick={resetAllData}\n              className=\"w-full py-2 bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 font-semibold rounded-lg border border-rose-500/30 flex items-center justify-center gap-2 transition-colors cursor-pointer\"\n            >\n              <RefreshCw className=\"w-4 h-4\" />\n              Restablecer Datos de Ejemplo\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. INSTALACI\303\223N EN TEL\303\211FONO M\303\223VIL (APK / PWA) */}\n      <div className=\"bg-gradient-to-r from-slate-900 via-slate-900 to-amber-950/30 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400\">\n              <Smartphone className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-slate-100 font-legal-heading\">\n                Probar en Tel\303\251fono M\303\263vil & Generar Archivo .APK\n              </h2>\n              <p className=\"text-xs text-slate-400\">\n                Lleva el despacho de BDCM Abogados en tu bolsillo con acceso sin conexi\303\263n y notificaciones\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={() => setShowAPKModal(true)}\n            className=\"px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2 self-start cursor-pointer\"\n          >\n            <Smartphone className=\"w-4 h-4\" />\n            Ver Instrucciones & C\303\263digo QR\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n          <div className=\"p-4 bg-slate-950/60 border border-slate-800 rounded-xl space-y-2\">\n            <span className=\"font-bold text-amber-400 block text-sm\">\360\237\223\262 Instalaci\303\263n PWA Directa (Sin esperar compilaci\303\263n)</span>\n            <p className=\"text-slate-300 leading-relaxed\">\n              Puedes instalar la aplicaci\303\263n directamente en cualquier tel\303\251fono Android abriendo la URL del sistema en Google Chrome y pulsando <strong>\"Instalar aplicaci\303\263n\"</strong>. Quedar\303\241 anclada como app nativa sin barras de navegaci\303\263n.\n            </p>\n          </div>\n\n          <div className=\"p-4 bg-slate-950/60 border border-slate-800 rounded-xl space-y-2\">\n            <span className=\"font-bold text-blue-400 block text-sm\">\360\237\223\246 Descargar Paquete .APK para Android</span>\n            <p className=\"text-slate-300 leading-relaxed\">\n              Mediante la herramienta oficial <strong>PWABuilder</strong> o <strong>Bubblewrap</strong>, puedes convertir esta URL en un archivo instalable <code>.apk</code> firmado en un par de clics para distribuirlo o subirlo a tiendas de apps.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <APKInstallModal isOpen={showAPKModal} onClose={() => setShowAPKModal(false)} />\n    </div>\n  );\n};\n"
    num_lines: 442
    num_bytes: 20965
    line_range_bytes: 3479
  }
}
