  code_action {
    action_spec {
      create_file {
        instruction: "import React, { createContext, useContext, useState, useEffect } from \'react\';\nimport {\n  Client,\n  LegalCase,\n  CaseDeadline,\n  Hearing,\n  FeeAgreement,\n  FeeInstallment,\n  LawyerUser,\n  AppNotification,\n  CaseStatus,\n  CaseType,\n} from \'../types\';\nimport {\n  initialClients,\n  initialCases,\n  initialDeadlines,\n  initialHearings,\n  initialFeeAgreements,\n  initialInstallments,\n} from \'../data/initialData\';\nimport { getStoredAccessToken, subscribeToAuthChanges, loginWithGoogle, logoutUser } from \'../services/auth\';\nimport { createGoogleCalendarEvent } from \'../services/googleCalendar\';\nimport { playAlertSound, sendBrowserNotification } from \'../services/notifications\';\n\ninterface LegalContextType {\n  // Data\n  clients: Client[];\n  cases: LegalCase[];\n  deadlines: CaseDeadline[];\n  hearings: Hearing[];\n  feeAgreements: FeeAgreement[];\n  installments: FeeInstallment[];\n  notifications: AppNotification[];\n\n  // Auth & Calendar\n  currentUser: LawyerUser | null;\n  googleCalendarConnected: boolean;\n  isConnectingCalendar: boolean;\n  connectGoogleCalendar: () => Promise<void>;\n  disconnectGoogleCalendar: () => Promise<void>;\n\n  // Filter / Stats\n  stats: {\n    activeCases: number;\n    upcomingDeadlines: number;\n    urgentDeadlines: number;\n    upcomingHearings: number;\n    pendingFeesAmount: number;\n    totalClients: number;\n  };\n\n  // Actions - Clients\n  addClient: (client: Omit<Client, \'id\' | \'createdAt\' | \'activeCasesCount\'>) => Client;\n  updateClient: (id: string, client: Partial<Client>) => void;\n  deleteClient: (id: string) => void;\n\n  // Actions - Cases\n  addCase: (legalCase: Omit<LegalCase, \'id\' | \'createdAt\' | \'updatedAt\'>) => LegalCase;\n  updateCase: (id: string, legalCase: Partial<LegalCase>) => void;\n  deleteCase: (id: string) => void;\n\n  // Actions - Deadlines\n  addDeadline: (deadline: Omit<CaseDeadline, \'id\' | \'createdAt\' | \'completed\'>) => Promise<CaseDeadline>;\n  toggleDeadlineStatus: (id: string) => void;\n  deleteDeadline: (id: string) => void;\n\n  // Actions - Hearings\n  addHearing: (hearing: Omit<Hearing, \'id\' | \'createdAt\' | \'status\'>) => Promise<Hearing>;\n  updateHearing: (id: string, hearing: Partial<Hearing>) => void;\n  deleteHearing: (id: string) => void;\n\n  // Actions - Fees\n  addFeeAgreement: (\n    agreement: Omit<FeeAgreement, \'id\' | \'createdAt\' | \'paidAmount\' | \'pendingAmount\' | \'status\'>,\n    installmentsList: Array<{ dueDate: string; amount: number; notes?: string }>\n  ) => FeeAgreement;\n  registerInstallmentPayment: (\n    installmentId: string,\n    paymentData: { paidDate: string; paymentMethod: string; receiptNumber?: string; notes?: string }\n  ) => void;\n\n  // Sync & Export\n  syncItemToGoogleCalendar: (type: \'hearing\' | \'deadline\', itemId: string) => Promise<{ success: boolean; message: string }>;\n  markNotificationAsRead: (id: string) => void;\n  clearAllNotifications: () => void;\n  resetToDemoData: () => void;\n  exportDatabaseJson: () => void;\n  importDatabaseJson: (jsonString: string) => boolean;\n}\n\nconst LegalContext = createContext<LegalContextType | undefined>(undefined);\n\nconst STORAGE_KEYS = {\n  CLIENTS: \'bdcm_clients_v2\',\n  CASES: \'bdcm_cases_v2\',\n  DEADLINES: \'bdcm_deadlines_v2\',\n  HEARINGS: \'bdcm_hearings_v2\',\n  AGREEMENTS: \'bdcm_fee_agreements_v2\',\n  INSTALLMENTS: \'bdcm_installments_v2\',\n};\n\nexport const LegalProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  // Load initial from localStorage or defaults\n  const [clients, setClients] = useState<Client[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.CLIENTS);\n    return saved ? JSON.parse(saved) : initialClients;\n  });\n\n  const [cases, setCases] = useState<LegalCase[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.CASES);\n    return saved ? JSON.parse(saved) : initialCases;\n  });\n\n  const [deadlines, setDeadlines] = useState<CaseDeadline[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.DEADLINES);\n    return saved ? JSON.parse(saved) : initialDeadlines;\n  });\n\n  const [hearings, setHearings] = useState<Hearing[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.HEARINGS);\n    return saved ? JSON.parse(saved) : initialHearings;\n  });\n\n  const [feeAgreements, setFeeAgreements] = useState<FeeAgreement[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.AGREEMENTS);\n    return saved ? JSON.parse(saved) : initialFeeAgreements;\n  });\n\n  const [installments, setInstallments] = useState<FeeInstallment[]>(() => {\n    const saved = localStorage.getItem(STORAGE_KEYS.INSTALLMENTS);\n    return saved ? JSON.parse(saved) : initialInstallments;\n  });\n\n  const [currentUser, setCurrentUser] = useState<LawyerUser | null>(null);\n  const [googleCalendarConnected, setGoogleCalendarConnected] = useState<boolean>(false);\n  const [isConnectingCalendar, setIsConnectingCalendar] = useState<boolean>(false);\n  const [notifications, setNotifications] = useState<AppNotification[]>([]);\n\n  // Sync to localStorage\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.CLIENTS, JSON.stringify(clients));\n  }, [clients]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.CASES, JSON.stringify(cases));\n  }, [cases]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.DEADLINES, JSON.stringify(deadlines));\n  }, [deadlines]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.HEARINGS, JSON.stringify(hearings));\n  }, [hearings]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.AGREEMENTS, JSON.stringify(feeAgreements));\n  }, [feeAgreements]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEYS.INSTALLMENTS, JSON.stringify(installments));\n  }, [installments]);\n\n  // Auth listener\n  useEffect(() => {\n    const unsub = subscribeToAuthChanges((user) => {\n      setCurrentUser(user);\n      const token = getStoredAccessToken();\n      setGoogleCalendarConnected(!!token);\n    });\n    return () => unsub();\n  }, []);\n\n  // Compute pending deadlines & notifications\n  useEffect(() => {\n    const newNotifications: AppNotification[] = [];\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n\n    deadlines.forEach((d) => {\n      if (d.completed) return;\n      const target = new Date(d.dueDate);\n      target.setHours(0, 0, 0, 0);\n      const diffDays = Math.ceil((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));\n\n      if (diffDays < 0) {\n        newNotifications.push({\n          id: `notif-overdue-${d.id}`,\n          title: \'Plazo Vencido\',\n          message: `El plazo \"${d.title}\" venci\303\263 hace ${Math.abs(diffDays)} d\303\255as`,\n          type: \'urgent\',\n          timestamp: new Date().toISOString(),\n          read: false,\n          linkTo: \'deadlines\',\n        });\n      } else if (diffDays <= 2) {\n        newNotifications.push({\n          id: `notif-urgent-${d.id}`,\n          title: diffDays === 0 ? \'\302\241Vence Hoy!\' : `Vence en ${diffDays} d\303\255a(s)`,\n          message: `${d.title} (Causa: ${d.caseTitle})`,\n          type: \'urgent\',\n          timestamp: new Date().toISOString(),\n          read: false,\n          linkTo: \'deadlines\',\n        });\n      }\n    });\n\n    hearings.forEach((h) => {\n      if (h.status === \'realizada\' || h.status === \'suspendida\') return;\n      const hDate = new Date(`${h.date}T${h.time}`);\n      const now = new Date();\n      const diffHours = (hDate.getTime() - now.getTime()) / (1000 * 60 * 60);\n\n      if (diffHours > 0 && diffHours <= 48) {\n        newNotifications.push({\n          id: `notif-hearing-${h.id}`,\n          title: \'Audiencia Pr\303\263xima\',\n          message: `${h.type}: ${h.caseTitle} en ${h.court} a las ${h.time}`,\n          type: \'warning\',\n          timestamp: new Date().toISOString(),\n          read: false,\n          linkTo: \'hearings\',\n        });\n      }\n    });\n\n    setNotifications(newNotifications);\n  }, [deadlines, hearings]);\n\n  // Auth actions\n  const connectGoogleCalendar = async () => {\n    setIsConnectingCalendar(true);\n    try {\n      await loginWithGoogle();\n      setGoogleCalendarConnected(true);\n      playAlertSound(\'success\');\n      sendBrowserNotification(\'Google Calendar Conectado\', {\n        body: \'Las audiencias y plazos ahora pueden sincronizarse autom\303\241ticamente con tu cuenta.\',\n      });\n    } catch (err: any) {\n      console.error(err);\n      alert(\'No se pudo conectar a Google Calendar: \' + err.message);\n    } finally {\n      setIsConnectingCalendar(false);\n    }\n  };\n\n  const disconnectGoogleCalendar = async () => {\n    await logoutUser();\n    setGoogleCalendarConnected(false);\n  };\n\n  // Sync to Google Calendar\n  const syncItemToGoogleCalendar = async (\n    type: \'hearing\' | \'deadline\',\n    itemId: string\n  ): Promise<{ success: boolean; message: string }> => {\n    const token = getStoredAccessToken();\n    if (!token) {\n      return { success: false, message: \'Primero conecta tu cuenta de Google Calendar en la barra superior.\' };\n    }\n\n    try {\n      if (type === \'hearing\') {\n        const hearing = hearings.find((h) => h.id === itemId);\n        if (!hearing) return { success: false, message: \'Audiencia no encontrada\' };\n\n        const start = `${hearing.date}T${hearing.time}:00`;\n        // Default 1 hour\n        const [hh, mm] = hearing.time.split(\':\').map(Number);\n        const endHour = String(hh + 1).padStart(2, \'0\');\n        const end = `${hearing.date}T${endHour}:${String(mm).padStart(2, \'0\')}:00`;\n\n        const desc = `AUDIENCIA JUDICIAL - BDCM ABOGADOS\nCausa: ${hearing.caseTitle}\nTribunal: ${hearing.court}\nSala: ${hearing.room || \'No indicada\'}\nModalidad: ${hearing.modality}\n${hearing.virtualMeetingUrl ? `Enlace Virtual: ${hearing.virtualMeetingUrl}` : \'\'}\nNotas: ${hearing.notes || \'\'}`;\n\n        const res = await createGoogleCalendarEvent(token, {\n          title: `\342\232\226\357\270\217 Audiencia: ${hearing.type} - ${hearing.caseTitle}`,\n          description: desc,\n          location: hearing.court,\n          startDateTime: new Date(start).toISOString(),\n          endDateTime: new Date(end).toISOString(),\n        });\n\n        if (res.success && res.eventId) {\n          updateHearing(itemId, {\n            googleCalendarEventId: res.eventId,\n            googleCalendarSynced: true,\n          });\n          playAlertSound(\'success\');\n          return { success: true, message: \'Audiencia agendada en tu Google Calendar\' };\n        } else {\n          return { success: false, message: res.error || \'Error al crear evento\' };\n        }\n      } else {\n        const deadline = deadlines.find((d) => d.id === itemId);\n        if (!deadline) return { success: false, message: \'Plazo no encontrado\' };\n\n        const start = `${deadline.dueDate}T09:00:00`;\n        const end = `${deadline.dueDate}T10:00:00`;\n\n        const desc = `PLAZO FATAL JUDICIAL - BDCM ABOGADOS\nPlazo: ${deadline.title}\nCausa: ${deadline.caseTitle}\nTipo: ${deadline.isFatal ? \'FATAL\' : \'Ordinario\'} (CPC Chile)\nNotas: ${deadline.notes || \'\'}`;\n\n        const res = await createGoogleCalendarEvent(token, {\n          title: `\360\237\232\250 Vencimiento Plazo: ${deadline.title} - ${deadline.caseTitle}`,\n          description: desc,\n          location: \'Tribunal correspondiente\',\n          startDateTime: new Date(start).toISOString(),\n          endDateTime: new Date(end).toISOString(),\n        });\n\n        if (res.success && res.eventId) {\n          setDeadlines((prev) =>\n            prev.map((d) =>\n              d.id === itemId ? { ...d, googleCalendarEventId: res.eventId, googleCalendarSynced: true } : d\n            )\n          );\n          playAlertSound(\'success\');\n          return { success: true, message: \'Plazo agendado en tu Google Calendar\' };\n        } else {\n          return { success: false, message: res.error || \'Error al crear evento\' };\n        }\n      }\n    } catch (err: any) {\n      return { success: false, message: err.message || \'Error al sincronizar\' };\n    }\n  };\n\n  // Stats calculation\n  const stats = {\n    activeCases: cases.filter((c) => c.status === \'activo\' || c.status === \'en_tramite\' || c.status === \'urgente\').length,\n    upcomingDeadlines: deadlines.filter((d) => !d.completed).length,\n    urgentDeadlines: deadlines.filter((d) => {\n      if (d.completed) return false;\n      const today = new Date();\n      today.setHours(0, 0, 0, 0);\n      const target = new Date(d.dueDate);\n      target.setHours(0, 0, 0, 0);\n      const diffDays = Math.ceil((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));\n      return diffDays <= 3;\n    }).length,\n    upcomingHearings: hearings.filter((h) => h.status === \'programada\').length,\n    pendingFeesAmount: installments\n      .filter((i) => i.status !== \'pagada\')\n      .reduce((sum, i) => sum + i.amount, 0),\n    totalClients: clients.length,\n  };\n\n  // Client actions\n  const addClient = (data: Omit<Client, \'id\' | \'createdAt\' | \'activeCasesCount\'>): Client => {\n    const newClient: Client = {\n      ...data,\n      id: `client-${Date.now()}`,\n      createdAt: new Date().toISOString(),\n      activeCasesCount: 0,\n    };\n    setClients((prev) => [newClient, ...prev]);\n    playAlertSound(\'success\');\n    return newClient;\n  };\n\n  const updateClient = (id: string, data: Partial<Client>) => {\n    setClients((prev) => prev.map((c) => (c.id === id ? { ...c, ...data } : c)));\n  };\n\n  const deleteClient = (id: string) => {\n    if (cases.some((c) => c.clientId === id)) {\n      alert(\'No se puede eliminar el cliente porque tiene causas judiciales asociadas.\');\n      return;\n    }\n    setClients((prev) => prev.filter((c) => c.id !== id));\n  };\n\n  // Case actions\n  const addCase = (data: Omit<LegalCase, \'id\' | \'createdAt\' | \'updatedAt\'>): LegalCase => {\n    const newCase: LegalCase = {\n      ...data,\n      id: `case-${Date.now()}`,\n      createdAt: new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n    };\n    setCases((prev) => [newCase, ...prev]);\n    // update client count\n    setClients((prev) =>\n      prev.map((cl) => (cl.id === data.clientId ? { ...cl, activeCasesCount: cl.activeCasesCount + 1 } : cl))\n    );\n    playAlertSound(\'success\');\n    return newCase;\n  };\n\n  const updateCase = (id: string, data: Partial<LegalCase>) => {\n    setCases((prev) =>\n      prev.map((c) => (c.id === id ? { ...c, ...data, updatedAt: new Date().toISOString() } : c))\n    );\n  };\n\n  const deleteCase = (id: string) => {\n    const target = cases.find((c) => c.id === id);\n    if (!target) return;\n    setCases((prev) => prev.filter((c) => c.id !== id));\n    setDeadlines((prev) => prev.filter((d) => d.caseId !== id));\n    setHearings((prev) => prev.filter((h) => h.caseId !== id));\n    setFeeAgreements((prev) => prev.filter((f) => f.caseId !== id));\n    setInstallments((prev) => prev.filter((i) => i.caseId !== id));\n    // update client active cases count\n    setClients((prev) =>\n      prev.map((cl) =>\n        cl.id === target.clientId ? { ...cl, activeCasesCount: Math.max(0, cl.activeCasesCount - 1) } : cl\n      )\n    );\n  };\n\n  // Deadlines actions\n  const addDeadline = async (\n    data: Omit<CaseDeadline, \'id\' | \'createdAt\' | \'completed\'>\n  ): Promise<CaseDeadline> => {\n    const newDeadline: CaseDeadline = {\n      ...data,\n      id: `dl-${Date.now()}`,\n      createdAt: new Date().toISOString(),\n      completed: false,\n    };\n\n    setDeadlines((prev) => [newDeadline, ...prev]);\n    playAlertSound(\'notification\');\n\n    // Auto-sync if calendar connected\n    const token = getStoredAccessToken();\n    if (token) {\n      syncItemToGoogleCalendar(\'deadline\', newDeadline.id);\n    }\n\n    return newDeadline;\n  };\n\n  const toggleDeadlineStatus = (id: string) => {\n    setDeadlines((prev) =>\n      prev.map((d) => (d.id === id ? { ...d, completed: !d.completed } : d))\n    );\n  };\n\n  const deleteDeadline = (id: string) => {\n    setDeadlines((prev) => prev.filter((d) => d.id !== id));\n  };\n\n  // Hearing actions\n  const addHearing = async (\n    data: Omit<Hearing, \'id\' | \'createdAt\' | \'status\'>\n  ): Promise<Hearing> => {\n    const newHearing: Hearing = {\n      ...data,\n      id: `hr-${Date.now()}`,\n      createdAt: new Date().toISOString(),\n      status: \'programada\',\n    };\n\n    setHearings((prev) => [newHearing, ...prev]);\n    playAlertSound(\'notification\');\n\n    // Auto-sync if calendar connected\n    const token = getStoredAccessToken();\n    if (token) {\n      syncItemToGoogleCalendar(\'hearing\', newHearing.id);\n    }\n\n    return newHearing;\n  };\n\n  const updateHearing = (id: string, data: Partial<Hearing>) => {\n    setHearings((prev) => prev.map((h) => (h.id === id ? { ...h, ...data } : h)));\n  };\n\n  const deleteHearing = (id: string) => {\n    setHearings((prev) => prev.filter((h) => h.id !== id));\n  };\n\n  // Fee actions\n  const addFeeAgreement = (\n    data: Omit<FeeAgreement, \'id\' | \'createdAt\' | \'paidAmount\' | \'pendingAmount\' | \'status\'>,\n    installmentsList: Array<{ dueDate: string; amount: number; notes?: string }>\n  ): FeeAgreement => {\n    const agreementId = `fee-${Date.now()}`;\n    const newAgreement: FeeAgreement = {\n      ...data,\n      id: agreementId,\n      paidAmount: 0,\n      pendingAmount: data.totalAmount,\n      status: \'pendiente\',\n      installmentsCount: installmentsList.length,\n      createdAt: new Date().toISOString(),\n    };\n\n    const newInsts: FeeInstallment[] = installmentsList.map((inst, idx) => ({\n      id: `inst-${Date.now()}-${idx + 1}`,\n      feeAgreementId: agreementId,\n      caseId: data.caseId,\n      clientId: data.clientId,\n      installmentNumber: idx + 1,\n      totalInstallments: installmentsList.length,\n      dueDate: inst.dueDate,\n      amount: inst.amount,\n      status: \'pendiente\',\n      notes: inst.notes || \'\',\n    }));\n\n    setFeeAgreements((prev) => [newAgreement, ...prev]);\n    setInstallments((prev) => [...newInsts, ...prev]);\n    playAlertSound(\'success\');\n    return newAgreement;\n  };\n\n  const registerInstallmentPayment = (\n    installmentId: string,\n    paymentData: { paidDate: string; paymentMethod: string; receiptNumber?: string; notes?: string }\n  ) => {\n    const targetInst = installments.find((i) => i.id === installmentId);\n    if (!targetInst) return;\n\n    const updatedInst: FeeInstallment = {\n      ...targetInst,\n      status: \'pagada\',\n      paidDate: paymentData.paidDate,\n      paymentMethod: paymentData.paymentMethod as any,\n      receiptNumber: paymentData.receiptNumber,\n      notes: paymentData.notes || targetInst.notes,\n    };\n\n    // Update installments\n    setInstallments((prev) => prev.map((i) => (i.id === installmentId ? updatedInst : i)));\n\n    // Recalculate fee agreement paid amount\n    setFeeAgreements((prev) =>\n      prev.map((agr) => {\n        if (agr.id !== targetInst.feeAgreementId) return agr;\n        const allAgInsts = installments\n          .map((i) => (i.id === installmentId ? updatedInst : i))\n          .filter((i) => i.feeAgreementId === agr.id);\n        const totalPaid = allAgInsts\n          .filter((i) => i.status === \'pagada\')\n          .reduce((sum, i) => sum + i.amount, 0);\n        const pending = Math.max(0, agr.totalAmount - totalPaid);\n        const status = pending === 0 ? \'completado\' : totalPaid > 0 ? \'parcial\' : \'pendiente\';\n        return {\n          ...agr,\n          paidAmount: totalPaid,\n          pendingAmount: pending,\n          status,\n        };\n      })\n    );\n\n    playAlertSound(\'success\');\n  };\n\n  const markNotificationAsRead = (id: string) => {\n    setNotifications((prev) => prev.map((n) => (n.id === id ? { ...n, read: true } : n)));\n  };\n\n  const clearAllNotifications = () => {\n    setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));\n  };\n\n  const resetToDemoData = () => {\n    if (confirm(\'\302\277Restablecer datos de muestra del estudio BDCM Abogados?\')) {\n      setClients(initialClients);\n      setCases(initialCases);\n      setDeadlines(initialDeadlines);\n      setHearings(initialHearings);\n      setFeeAgreements(initialFeeAgreements);\n      setInstallments(initialInstallments);\n      localStorage.clear();\n      alert(\'Datos de muestra restablecidos.\');\n    }\n  };\n\n  const exportDatabaseJson = () => {\n    const db = {\n      clients,\n      cases,\n      deadlines,\n      hearings,\n      feeAgreements,\n      installments,\n      exportedAt: new Date().toISOString(),\n      firm: \'BDCM ABOGADOS CHILE\',\n    };\n    const blob = new Blob([JSON.stringify(db, null, 2)], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `BDCM_ABOGADOS_BACKUP_${new Date().toISOString().split(\'T\')[0]}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const importDatabaseJson = (jsonString: string): boolean => {\n    try {\n      const data = JSON.parse(jsonString);\n      if (!Array.isArray(data.clients) || !Array.isArray(data.cases)) {\n        throw new Error(\'Formato no v\303\241lido\');\n      }\n      setClients(data.clients);\n      setCases(data.cases);\n      setDeadlines(data.deadlines || []);\n      setHearings(data.hearings || []);\n      setFeeAgreements(data.feeAgreements || []);\n      setInstallments(data.installments || []);\n      playAlertSound(\'success\');\n      return true;\n    } catch (e) {\n      alert(\'Error al importar archivo JSON. Aseg\303\272rese de que sea un respaldo v\303\241lido de BDCM Abogados.\');\n      return false;\n    }\n  };\n\n  return (\n    <LegalContext.Provider\n      value={{\n        clients,\n        cases,\n        deadlines,\n        hearings,\n        feeAgreements,\n        installments,\n        notifications,\n        currentUser,\n        googleCalendarConnected,\n        isConnectingCalendar,\n        connectGoogleCalendar,\n        disconnectGoogleCalendar,\n        stats,\n        addClient,\n        updateClient,\n        deleteClient,\n        addCase,\n        updateCase,\n        deleteCase,\n        addDeadline,\n        toggleDeadlineStatus,\n        deleteDeadline,\n        addHearing,\n        updateHearing,\n        deleteHearing,\n        addFeeAgreement,\n        registerInstallmentPayment,\n        syncItemToGoogleCalendar,\n        markNotificationAsRead,\n        clearAllNotifications,\n        resetToDemoData,\n        exportDatabaseJson,\n        importDatabaseJson,\n      }}\n    >\n      {children}\n    </LegalContext.Provider>\n  );\n};\n\nexport const useLegal = () => {\n  const context = useContext(LegalContext);\n  if (!context) {\n    throw new Error(\'useLegal must be used within a LegalProvider\');\n  }\n  return context;\n};\n"
        path {
          absolute_uri: "file:///src/context/LegalContext.tsx"
        }
        overwrite: true
      }
    }
    action_result {
      edit {
