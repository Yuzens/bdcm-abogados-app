            }
            lines {
              text: "export function formatDateCL(dateString: string): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!dateString) return \'-\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const parts = dateString.split(\'T\')[0].split(\'-\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (parts.length !== 3) return dateString;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [year, month, day] = parts;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${day}/${month}/${year}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
