    action_spec {
      create_file {
        instruction: "export interface GoogleCalendarEventInput {\n  summary: string;\n  description: string;\n  location?: string;\n  start: {\n    dateTime?: string;\n    date?: string;\n    timeZone?: string;\n  };\n  end: {\n    dateTime?: string;\n    date?: string;\n    timeZone?: string;\n  };\n  reminders?: {\n    useDefault: boolean;\n    overrides?: Array<{\n      method: \'email\' | \'popup\';\n      minutes: number;\n    }>;\n  };\n}\n\nexport interface GoogleCalendarEventResponse {\n  id: string;\n  htmlLink: string;\n  summary: string;\n  status: string;\n}\n\n/**\n * Inserta un evento en el Google Calendar principal del usuario\n */\nexport async function createGoogleCalendarEvent(\n  accessToken: string,\n  eventData: GoogleCalendarEventInput\n): Promise<GoogleCalendarEventResponse> {\n  const response = await fetch(\n    \'https://www.googleapis.com/calendar/v3/calendars/primary/events\',\n    {\n      method: \'POST\',\n      headers: {\n        Authorization: `Bearer ${accessToken}`,\n        \'Content-Type\': \'application/json\',\n      },\n      body: JSON.stringify(eventData),\n    }\n  );\n\n  if (!response.ok) {\n    const errorText = await response.text();\n    throw new Error(`Error de Google Calendar API (${response.status}): ${errorText}`);\n  }\n\n  return (await response.json()) as GoogleCalendarEventResponse;\n}\n\n/**\n * Elimina un evento de Google Calendar (requiere confirmaci\303\263n del usuario)\n */\nexport async function deleteGoogleCalendarEvent(\n  accessToken: string,\n  eventId: string\n): Promise<boolean> {\n  const response = await fetch(\n    `https://www.googleapis.com/calendar/v3/calendars/primary/events/${encodeURIComponent(eventId)}`,\n    {\n      method: \'DELETE\',\n      headers: {\n        Authorization: `Bearer ${accessToken}`,\n      },\n    }\n  );\n\n  if (!response.ok && response.status !== 404) {\n    const errorText = await response.text();\n    throw new Error(`Error al eliminar evento en Google Calendar (${response.status}): ${errorText}`);\n  }\n\n  return true;\n}\n\n/**\n * Obtiene los pr\303\263ximos eventos del calendario\n */\nexport async function getUpcomingGoogleCalendarEvents(accessToken: string): Promise<any[]> {\n  const now = new Date().toISOString();\n  const response = await fetch(\n    `https://www.googleapis.com/calendar/v3/calendars/primary/events?timeMin=${encodeURIComponent(now)}&maxResults=15&singleEvents=true&orderBy=startTime`,\n    {\n      headers: {\n        Authorization: `Bearer ${accessToken}`,\n      },\n    }\n  );\n\n  if (!response.ok) {\n    throw new Error(\'No se pudieron obtener eventos de Google Calendar\');\n  }\n\n  const data = await response.json();\n  return data.items || [];\n}\n"
        path {
          absolute_uri: "file:///src/services/googleCalendar.ts"
        }
        overwrite: true
      }
    }
