      thinking_signature: "\022\200\a\n\375\006\001i\024}\023\242\233m\256Py.6\021\323\306\357\302d)J(\336k\236\345\373\240\211\315\356\t\322dgP\315\003\352j\023\177/>\363/\240\372.\241\213H\263\006B\031\026\311\310\207\256R\027\374\223\315\245\276\346Y\020+|;{\022\351B`\324z\f\256\253Z\037\303`\315\346\272\347@\023\031\2578!y\354K\323O\035\260;\000\372\261\346,Q\364,\022\313\253\237\b;\202\177\250\357\252\356\217\303\256\3070\260:oq\314`\n\244(Ax\267\377*b\343[t\206\230\332\312\333\263\330\232S\340m\033\224:X\320\n\337#\377\3269\301\r\212\265\254#\265\202%\373\264\342I\310/\024\255\301r\337\345-_(\207\343\322_D\263\354\371\374\3279w\025\260{\333^\341\n\026\372\327\356\245\333\307\177\320\b\300\270iK\241\375\214@G\235d\320u\031o\351E\350cdi\246\246\2717\360J\033\027?\3114;\341\232*\224\342\3332\320\306\350\300\267c\232\023\235\374\242\330U\305\a\322\ns\334\342d\314\217i\307\233\023\026\364i\v\331R\022\205\201\261%\300\354\236\2503u\031\261S\312Cd\257\"\220\312!\247Vf\330\347D\213\322\226ubp\270\323\3461\224\277\222\273\030\177\317\374\036\271C\"&\233Q\211\316\037|snYj\003\235{\243\3760h\334G\n\271J\303\031c\321\320AZ\220\337[?\373\302\a\346\n4\335N$\223\372[e\213G8?\363\373f\300/F\340\241,\326\205\377\270):\326\006s\251\371\204\354\206\375\327i\323pP\034\020u\'\252#\016\016\332\342\260\253\337\312\202&\370i\036\261\354L\372\037\375\v\357\277\361>\257.\274\031x\357;>u\027\343\0272Q\245d~\227\363b\205\342fTyv*\r\000{\b(\213\275L\210#\226\357\b\002yMml\020\300\352}\033\027\304TZ\001\231\264\376\234\266\357t\267\2029\222\367\214\002zAF\376\273~\3127\272\357-e\235H\017q\026\337S\017I\222\205\256\273\206\000^\030\264\016h\003\200\336(\327\363\233\t\331\n\\u\035\277\327\343\314\327s\021k\266a\027\241\300W.`\254p\311=\347=#\365\026\371\200,q\367e\t\342L\022\220\233oi\024(|\320\314\205\023\036\323\212\347\315DAD|\026\254\306\263u \000\254\201wRWxL\345W/*\317\300\272AVsk\275\v\205\276\203\003\270\274\266\211\365G%\350\204\374\004\335\312\v\362O\302x\311\2768\353\335\256&\370O\v\251\266%i&\347nm\026\231\251\376YB0\b\241\251\331\303K\361U\214)_%[\305\217\371-z\330\177\016\247\242\326t\202\257\003B\372s\323\202I\366\372\234=\364\177\353\210\037qY\035\271\"d\f\271\264\227s\354b\332\005\330\331\177%V\313p3\330\303K,\004\276\317j\236}\324\355\212\372\030\b\351\233\222\271V<\215\230\322A\b\267\206I\027\202\345\266\203\357/Jn\225\301\365H\351\304\347\266(\300\373U0\223\305}\016\336}\214$,\344\232aeJ*l\345uQ\277\3364\335\267\023\243\254>\244\376t\306\274\214(o$\222\036\332\017&\232\211\321\312_\234\245\376>\241\355S\'\004\301A\024\240\200\311\032H\302\nk\230\216\002\\*\300\253O"
