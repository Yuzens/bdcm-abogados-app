        instruction: "// Utilidades legales para el ejercicio del derecho en Chile\n\nexport function validateRut(rut: string): boolean {\n  if (!rut || typeof rut !== \'string\') return false;\n  \n  const cleanRut = rut.replace(/[^0-9kK]/g, \'\').toUpperCase();\n  if (cleanRut.length < 2) return false;\n\n  const body = cleanRut.slice(0, -1);\n  const dv = cleanRut.slice(-1);\n\n  if (!/^\\d+$/.test(body)) return false;\n\n  let sum = 0;\n  let multiplier = 2;\n\n  for (let i = body.length - 1; i >= 0; i--) {\n    sum += parseInt(body[i], 10) * multiplier;\n    multiplier = multiplier === 7 ? 2 : multiplier + 1;\n  }\n\n  const expectedDvNumber = 11 - (sum % 11);\n  let expectedDv = \'\';\n  if (expectedDvNumber === 11) expectedDv = \'0\';\n  else if (expectedDvNumber === 10) expectedDv = \'K\';\n  else expectedDv = expectedDvNumber.toString();\n\n  return dv === expectedDv;\n}\n\nexport function formatRut(rut: string): string {\n  if (!rut) return \'\';\n  const clean = rut.replace(/[^0-9kK]/g, \'\').toUpperCase();\n  if (clean.length < 2) return clean;\n\n  const dv = clean.slice(-1);\n  const body = clean.slice(0, -1);\n\n  let formattedBody = \'\';\n  for (let i = body.length - 1, j = 1; i >= 0; i--, j++) {\n    formattedBody = body[i] + formattedBody;\n    if (j % 3 === 0 && i !== 0) {\n      formattedBody = \'.\' + formattedBody;\n    }\n  }\n\n  return `${formattedBody}-${dv}`;\n}\n\nexport const CHILEAN_HOLIDAYS_FIXED = [\n  \'01-01\', // A\303\261o Nuevo\n  \'05-01\', // D\303\255a del Trabajador\n  \'05-21\', // Glorias Navales\n  \'06-20\', // D\303\255a Nacional de los Pueblos Ind\303\255genas\n  \'06-29\', // San Pedro y San Pablo\n  \'07-16\', // Virgen del Carmen\n  \'08-15\', // Asunci\303\263n de la Virgen\n  \'09-18\', // Fiestas Patrias\n  \'09-19\', // Glorias del Ej\303\251rcito\n  \'09-20\', // Festivo adicional fiestas patrias\n  \'10-12\', // Encuentro de Dos Mundos\n  \'10-31\', // D\303\255a de las Iglesias Evang\303\251licas y Protestantes\n  \'11-01\', // D\303\255a de Todos los Santos\n  \'12-08\', // Inmaculada Concepci\303\263n\n  \'12-25\', // Navidad\n];\n\nexport const SPECIFIC_HOLIDAYS_LIST = [\n  \'2024-03-29\', \'2024-03-30\',\n  \'2025-04-18\', \'2025-04-19\',\n  \'2026-04-03\', \'2026-04-04\',\n  \'2027-03-26\', \'2027-03-27\',\n];\n\nexport function isHolidayInChile(date: Date): boolean {\n  const yyyy = date.getFullYear();\n  const mm = String(date.getMonth() + 1).padStart(2, \'0\');\n  const dd = String(date.getDate()).padStart(2, \'0\');\n  const dateStr = `${yyyy}-${mm}-${dd}`;\n  const monthDay = `${mm}-${dd}`;\n\n  if (CHILEAN_HOLIDAYS_FIXED.includes(monthDay)) return true;\n  if (SPECIFIC_HOLIDAYS_LIST.includes(dateStr)) return true;\n  return false;\n}\n\nexport function calculateLegalDeadline(\n  startDateStr: string,\n  daysCount: number,\n  type: \'HABILES_CIVIL\' | \'HABILES_LABORAL\' | \'CORRIDOS\'\n): { deadlineDate: string; breakdown: string[] } {\n  const [year, month, day] = startDateStr.split(\'-\').map(Number);\n  const currentDate = new Date(year, month - 1, day);\n  currentDate.setDate(currentDate.getDate() + 1);\n\n  const breakdown: string[] = [];\n  let countedDays = 0;\n\n  if (type === \'CORRIDOS\') {\n    while (countedDays < daysCount) {\n      const isSun = currentDate.getDay() === 0;\n      const isHol = isHolidayInChile(currentDate);\n      const dateStr = currentDate.toISOString().split(\'T\')[0];\n      countedDays++;\n      breakdown.push(`D\303\255a ${countedDays}: ${dateStr} ${isHol ? \'(Feriado)\' : isSun ? \'(Domingo)\' : \'\'}`);\n      if (countedDays < daysCount) {\n        currentDate.setDate(currentDate.getDate() + 1);\n      }\n    }\n    while (currentDate.getDay() === 0 || isHolidayInChile(currentDate)) {\n      currentDate.setDate(currentDate.getDate() + 1);\n      breakdown.push(`Prorroga legal por d\303\255a inh\303\241bil: pasa al ${currentDate.toISOString().split(\'T\')[0]}`);\n    }\n  } else if (type === \'HABILES_CIVIL\') {\n    while (countedDays < daysCount) {\n      const dayOfWeek = currentDate.getDay();\n      const isSunday = dayOfWeek === 0;\n      const isHol = isHolidayInChile(currentDate);\n\n      if (!isSunday && !isHol) {\n        countedDays++;\n        breakdown.push(`D\303\255a h\303\241bil ${countedDays}: ${currentDate.toISOString().split(\'T\')[0]}`);\n      } else {\n        breakdown.push(`Inh\303\241bil saltado (${isSunday ? \'Domingo\' : \'Feriado\'}): ${currentDate.toISOString().split(\'T\')[0]}`);\n      }\n\n      if (countedDays < daysCount) {\n        currentDate.setDate(currentDate.getDate() + 1);\n      }\n    }\n  } else if (type === \'HABILES_LABORAL\') {\n    while (countedDays < daysCount) {\n      const dayOfWeek = currentDate.getDay();\n      const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;\n      const isHol = isHolidayInChile(currentDate);\n\n      if (!isWeekend && !isHol) {\n        countedDays++;\n        breakdown.push(`D\303\255a h\303\241bil ${countedDays}: ${currentDate.toISOString().split(\'T\')[0]}`);\n      } else {\n        breakdown.push(`Inh\303\241bil saltado (${isWeekend ? (dayOfWeek === 6 ? \'S\303\241bado\' : \'Domingo\') : \'Feriado\'}): ${currentDate.toISOString().split(\'T\')[0]}`);\n      }\n\n      if (countedDays < daysCount) {\n        currentDate.setDate(currentDate.getDate() + 1);\n      }\n    }\n  }\n\n  const y = currentDate.getFullYear();\n  const m = String(currentDate.getMonth() + 1).padStart(2, \'0\');\n  const d = String(currentDate.getDate()).padStart(2, \'0\');\n\n  return {\n    deadlineDate: `${y}-${m}-${d}`,\n    breakdown,\n  };\n}\n\nexport function formatCurrency(amount: number, currency: \'CLP\' | \'UF\' = \'CLP\'): string {\n  if (isNaN(amount)) return \'$ 0\';\n  if (currency === \'UF\') {\n    return `${amount.toLocaleString(\'es-CL\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} UF`;\n  }\n  return `$ ${amount.toLocaleString(\'es-CL\', { maximumFractionDigits: 0 })}`;\n}\n\nexport function formatDateCL(dateString: string): string {\n  if (!dateString) return \'-\';\n  const parts = dateString.split(\'T\')[0].split(\'-\');\n  if (parts.length !== 3) return dateString;\n  const [year, month, day] = parts;\n  return `${day}/${month}/${year}`;\n}\n\nexport function getDaysRemaining(targetDateStr: string): number {\n  const [y, m, d] = targetDateStr.split(\'-\').map(Number);\n  const target = new Date(y, m - 1, d);\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n  target.setHours(0, 0, 0, 0);\n\n  const diffTime = target.getTime() - today.getTime();\n  return Math.round(diffTime / (1000 * 60 * 60 * 24));\n}\n\nexport const CHILEAN_COURTS = [\n  \'1\302\260 Juzgado Civil de Santiago\',\n  \'2\302\260 Juzgado Civil de Santiago\',\n  \'3\302\260 Juzgado Civil de Santiago\',\n  \'7\302\260 Juzgado Civil de Santiago\',\n  \'14\302\260 Juzgado Civil de Santiago\',\n  \'22\302\260 Juzgado Civil de Santiago\',\n  \'1\302\260 Juzgado de Letras del Trabajo de Santiago\',\n  \'2\302\260 Juzgado de Letras del Trabajo de Santiago\',\n  \'Juzgado de Cobranza Laboral y Previsional de Santiago\',\n  \'1\302\260 Juzgado de Familia de Santiago\',\n  \'2\302\260 Juzgado de Familia de Santiago\',\n  \'3\302\260 Juzgado de Garant\303\255a de Santiago\',\n  \'7\302\260 Juzgado de Garant\303\255a de Santiago\',\n  \'4\302\260 Tribunal de Juicio Oral en lo Penal de Santiago\',\n  \'Corte de Apelaciones de Santiago\',\n  \'Corte de Apelaciones de San Miguel\',\n  \'Corte de Apelaciones de Valpara\303\255so\',\n  \'Corte de Apelaciones de Concepci\303\263n\',\n  \'Excma. Corte Suprema de Chile\',\n  \'1\302\260 Juzgado de Polic\303\255a Local de Las Condes\',\n  \'Juzgado de Letras y Garant\303\255a de Colina\',\n  \'1\302\260 Juzgado Civil de Vi\303\261a del Mar\',\n  \'Tribunal Tributario y Aduanero de la RM\',\n  \'Centro de Arbitraje y Mediaci\303\263n (CAM Santiago)\',\n];\n\nexport function buildGoogleCalendarUrl(params: {\n  title: string;\n  details: string;\n  location?: string;\n  startDate: string;\n  startTime?: string;\n  endDate?: string;\n  endTime?: string;\n}): string {\n  const { title, details, location, startDate, startTime = \'09:00\', endDate = startDate, endTime = \'10:00\' } = params;\n  \n  const startIso = `${startDate.replace(/-/g, \'\')}T${startTime.replace(/:/g, \'\')}00`;\n  const endIso = `${endDate.replace(/-/g, \'\')}T${endTime.replace(/:/g, \'\')}00`;\n\n  const url = new URL(\'https://calendar.google.com/calendar/render\');\n  url.searchParams.set(\'action\', \'TEMPLATE\');\n  url.searchParams.set(\'text\', `[BDCM] ${title}`);\n  url.searchParams.set(\'details\', details);\n  if (location) {\n    url.searchParams.set(\'location\', location);\n  }\n  url.searchParams.set(\'dates\', `${startIso}/${endIso}`);\n\n  return url.toString();\n}\n\nexport function downloadIcsFile(params: {\n  filename: string;\n  title: string;\n  description: string;\n  location?: string;\n  startDate: string;\n  startTime?: string;\n  endDate?: string;\n  endTime?: string;\n}): void {\n  const { filename, title, description, location = \'\', startDate, startTime = \'09:00\', endDate = startDate, endTime = \'10:00\' } = params;\n  const start = `${startDate.replace(/-/g, \'\')}T${startTime.replace(/:/g, \'\')}00`;\n  const end = `${endDate.replace(/-/g, \'\')}T${endTime.replace(/:/g, \'\')}00`;\n\n  const icsContent = [\n    \'BEGIN:VCALENDAR\',\n    \'VERSION:2.0\',\n    \'PRODID:-//BDCM Abogados//Gesti\303\263n Jur\303\255dica Chile//ES\',\n    \'CALSCALE:GREGORIAN\',\n    \'BEGIN:VEVENT\',\n    `SUMMARY:[BDCM Abogados] ${title}`,\n    `DESCRIPTION:${description.replace(/\\n/g, \'\\\\n\')}`,\n    `LOCATION:${location}`,\n    `DTSTART:${start}`,\n    `DTEND:${end}`,\n    \'STATUS:CONFIRMED\',\n    \'END:VEVENT\',\n    \'END:VCALENDAR\',\n  ].join(\'\\r\\n\');\n\n  const blob = new Blob([icsContent], { type: \'text/calendar;charset=utf-8\' });\n  const link = document.createElement(\'a\');\n  link.href = window.URL.createObjectURL(blob);\n  link.setAttribute(\'download\', `${filename}.ics`);\n  document.body.appendChild(link);\n  link.click();\n  document.body.removeChild(link);\n}\n"
        path {
          absolute_uri: "file:///src/utils/chileanLegal.ts"
        }
        overwrite: true
      }
    }
