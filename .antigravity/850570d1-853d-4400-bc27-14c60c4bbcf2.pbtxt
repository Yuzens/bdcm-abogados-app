  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport { CourtType, LegalSubject, ClientRole, CaseStatus } from \'../../types\';\nimport { CHILEAN_COURTS } from \'../../utils/chileanLegal\';\nimport { X, Scale, FileText, UserCheck, Building2 } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  preselectedClientId?: string;\n}\n\nexport const NewCaseModal: React.FC<Props> = ({ isOpen, onClose, preselectedClientId }) => {\n  const { clients, lawyers, addCase } = useLegal();\n\n  const [rol, setRol] = useState(\'\');\n  const [caratula, setCaratula] = useState(\'\');\n  const [court, setCourt] = useState(CHILEAN_COURTS[0]);\n  const [courtType, setCourtType] = useState<CourtType>(\'CIVIL\');\n  const [subject, setSubject] = useState<LegalSubject>(\'Civil\');\n  const [clientId, setClientId] = useState(preselectedClientId || (clients[0]?.id || \'\'));\n  const [clientRole, setClientRole] = useState<ClientRole>(\'DEMANDANTE\');\n  const [opposingParty, setOpposingParty] = useState(\'\');\n  const [opposingLawyer, setOpposingLawyer] = useState(\'\');\n  const [status, setStatus] = useState<CaseStatus>(\'TRAMITACION\');\n  const [assignedLawyer, setAssignedLawyer] = useState(lawyers[0]?.name || \'Enrique Blanco Zambrano\');\n  const [currency, setCurrency] = useState<\'CLP\' | \'UF\'>(\'CLP\');\n  const [amount, setAmount] = useState<string>(\'\');\n  const [pjudLink, setPjudLink] = useState(\'https://ojv.pjud.cl/kpitec-ojv-web/login\');\n  const [notes, setNotes] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!rol.trim() || !caratula.trim() || !clientId) {\n      alert(\'Por favor completa el ROL, car\303\241tula y selecciona el cliente.\');\n      return;\n    }\n\n    addCase({\n      rol: rol.trim(),\n      caratula: caratula.trim(),\n      court,\n      courtType,\n      subject,\n      clientId,\n      clientRole,\n      opposingParty: opposingParty.trim() || \'No informada\',\n      opposingLawyer: opposingLawyer.trim(),\n      status,\n      assignedLawyer,\n      currency,\n      amount: amount ? Number(amount) : undefined,\n      pjudLink,\n      notes: notes.trim(),\n    });\n\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-150\">\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400\">\n              <Scale className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-slate-100 font-legal-heading\">Nueva Causa Judicial</h2>\n              <p className=\"text-xs text-slate-400\">Apertura de expediente en BDCM Abogados</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-4 max-h-[75vh] overflow-y-auto\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                ROL / RIT / RUC <span className=\"text-amber-400\">*</span>\n              </label>\n              <input\n                type=\"text\"\n                value={rol}\n                onChange={(e) => setRol(e.target.value)}\n                placeholder=\"Ej: C-4521-2024 o O-812-2024\"\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 font-mono-legal\"\n                required\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Materia Judicial <span className=\"text-amber-400\">*</span>\n              </label>\n              <select\n                value={subject}\n                onChange={(e) => setSubject(e.target.value as LegalSubject)}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              >\n                <option value=\"Civil\">Civil</option>\n                <option value=\"Laboral\">Laboral</option>\n                <option value=\"Familia\">Familia</option>\n                <option value=\"Penal\">Penal</option>\n                <option value=\"Comercial\">Comercial</option>\n                <option value=\"Inmobiliario\">Inmobiliario</option>\n                <option value=\"Polic\303\255a Local\">Polic\303\255a Local</option>\n                <option value=\"Constitucional\">Constitucional</option>\n                <option value=\"Cobranza Judicial\">Cobranza Judicial</option>\n                <option value=\"Corporativo\">Corporativo</option>\n              </select>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Car\303\241tula de la Causa <span className=\"text-amber-400\">*</span>\n            </label>\n            <input\n              type=\"text\"\n              value={caratula}\n              onChange={(e) => setCaratula(e.target.value)}\n              placeholder=\"Ej: Demandante con Demandado SpA\"\n              className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 font-medium\"\n              required\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Tribunal o Corte de Radicaci\303\263n <span className=\"text-amber-400\">*</span>\n              </label>\n              <input\n                type=\"text\"\n                list=\"court-list\"\n                value={court}\n                onChange={(e) => setCourt(e.target.value)}\n                placeholder=\"Ej: 14\302\260 Juzgado Civil de Santiago\"\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n                required\n              />\n              <datalist id=\"court-list\">\n                {CHILEAN_COURTS.map((c) => (\n                  <option key={c} value={c} />\n                ))}\n              </datalist>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Tipo de Tribunal\n              </label>\n              <select\n                value={courtType}\n                onChange={(e) => setCourtType(e.target.value as CourtType)}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              >\n                <option value=\"CIVIL\">Juzgado Civil / Letras</option>\n                <option value=\"LABORAL\">Juzgado del Trabajo</option>\n                <option value=\"FAMILIA\">Juzgado de Familia</option>\n                <option value=\"GARANTIA\">Juzgado de Garant\303\255a</option>\n                <option value=\"TOP\">Tribunal Oral en lo Penal</option>\n                <option value=\"CORTE_APELACIONES\">Corte de Apelaciones</option>\n                <option value=\"CORTE_SUPREMA\">Corte Suprema</option>\n                <option value=\"POLICIA_LOCAL\">Polic\303\255a Local</option>\n                <option value=\"ARBITRAL\">Tribunal Arbitral</option>\n              </select>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Cliente Patrocinado <span className=\"text-amber-400\">*</span>\n              </label>\n              <select\n                value={clientId}\n                onChange={(e) => setClientId(e.target.value)}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n                required\n              >\n                {clients.map((cli) => (\n                  <option key={cli.id} value={cli.id}>\n                    {cli.name} ({cli.rut})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Calidad de Nuestro Cliente\n              </label>\n              <select\n                value={clientRole}\n                onChange={(e) => setClientRole(e.target.value as ClientRole)}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              >\n                <option value=\"DEMANDANTE\">Demandante / Actor</option>\n                <option value=\"DEMANDADO\">Demandado</opt