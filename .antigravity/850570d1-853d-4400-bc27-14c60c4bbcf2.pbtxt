  planner_response {
    thinking: "**Constructing The Data Layer**\n\nI\'m now focused on building the state management and data persistence layer for BDCM Abogados. I plan to use a React Context and custom hooks provider, specifically at `src/context/LegalContext.tsx`. This provider will manage and synchronize crucial data like client and case information, which I will begin populating with appropriate models.\n\n\n"
    tool_calls {
      id: "call_179834"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { createContext, useContext, useState, useEffect, ReactNode } from \'react\';\\nimport {\\n  Client,\\n  LegalCase,\\n  CaseDeadline,\\n  Hearing,\\n  FeeAgreement,\\n  FeeInstallment,\\n  LawyerUser,\\n  CaseEvent,\\n} from \'../types\';\\nimport {\\n  INITIAL_CLIENTS,\\n  INITIAL_CASES,\\n  INITIAL_DEADLINES,\\n  INITIAL_HEARINGS,\\n  INITIAL_FEE_AGREEMENTS,\\n  INITIAL_INSTALLMENTS,\\n  INITIAL_LAWYERS,\\n} from \'../data/initialData\';\\nimport {\\n  initAuth,\\n  googleSignIn,\\n  logout as authLogout,\\n  getAccessToken,\\n} from \'../services/auth\';\\nimport {\\n  createGoogleCalendarEvent,\\n  deleteGoogleCalendarEvent,\\n} from \'../services/googleCalendar\';\\nimport {\\n  soundManager,\\n  showSystemNotification,\\n  requestBrowserNotificationPermission,\\n} from \'../services/notifications\';\\nimport { User } from \'firebase/auth\';\\n\\nconst STORAGE_KEY_PREFIX = \'bdcm_abogados_v1_\';\\n\\ninterface LegalContextType {\\n  // Navigation & UI state\\n  activeTab: \'dashboard\' | \'cases\' | \'clients\' | \'deadlines\' | \'hearings\' | \'fees\' | \'tools\';\\n  setActiveTab: (tab: \'dashboard\' | \'cases\' | \'clients\' | \'deadlines\' | \'hearings\' | \'fees\' | \'tools\') => void;\\n  selectedCaseId: string | null;\\n  setSelectedCaseId: (id: string | null) => void;\\n  searchQuery: string;\\n  setSearchQuery: (q: string) => void;\\n\\n  // Data\\n  clients: Client[];\\n  cases: LegalCase[];\\n  deadlines: CaseDeadline[];\\n  hearings: Hearing[];\\n  feeAgreements: FeeAgreement[];\\n  installments: FeeInstallment[];\\n  lawyers: LawyerUser[];\\n\\n  // Google OAuth & Calendar\\n  googleUser: User | null;\\n  googleAccessToken: string | null;\\n  isConnectingGoogle: boolean;\\n  googleSyncMessage: string | null;\\n  connectGoogle: () => Promise<void>;\\n  disconnectGoogle: () => Promise<void>;\\n  syncDeadlineToCalendar: (deadlineId: string) => Promise<{ success: boolean; message: string }>;\\n  syncHearingToCalendar: (hearingId: string) => Promise<{ success: boolean; message: string }>;\\n  syncAllToCalendar: () => Promise<{ success: boolean; count: number }>;\\n\\n  // Client actions\\n  addClient: (client: Omit<Client, \'id\' | \'createdAt\'>) => string;\\n  updateClient: (id: string, client: Partial<Client>) => void;\\n  deleteClient: (id: string) => void;\\n\\n  // Case actions\\n  addCase: (legalCase: Omit<LegalCase, \'id\' | \'createdAt\' | \'updatedAt\' | \'timeline\'>) => string;\\n  updateCase: (id: string, legalCase: Partial<LegalCase>) => void;\\n  deleteCase: (id: string) => void;\\n  addCaseEvent: (caseId: string, event: Omit<CaseEvent, \'id\'>) => void;\\n\\n  // Deadline actions\\n  addDeadline: (deadline: Omit<CaseDeadline, \'id\' | \'createdAt\'>) => string;\\n  updateDeadline: (id: string, deadline: Partial<CaseDeadline>) => void;\\n  toggleDeadlineStatus: (id: string) => void;\\n  deleteDeadline: (id: string) => void;\\n\\n  // Hearing actions\\n  addHearing: (hearing: Omit<Hearing, \'id\'>) => string;\\n  updateHearing: (id: string, hearing: Partial<Hearing>) => void;\\n  deleteHearing: (id: string) => void;\\n\\n  // Fee & Installment actions\\n  addFeeAgreementWithInstallments: (\\n    agreement: Omit<FeeAgreement, \'id\' | \'createdAt\'>,\\n    customInstallments?: Array<{ dueDate: string; amount: number; notes?: string }>\\n  ) => void;\\n  markInstallmentPaid: (\\n    installmentId: string,\\n    details: {\\n      paymentMethod: \'TRANSFERENCIA\' | \'VALE_VISTA\' | \'CHEQUE\' | \'WEBPAY\' | \'EFECTIVO\';\\n      receiptFolio?: string;\\n      notes?: string;\\n    }\\n  ) => void;\\n  updateInstallment: (id: string, data: Partial<FeeInstallment>) => void;\\n\\n  // Helpers\\n  exportDataJson: () => void;\\n  importDataJson: (jsonString: string) => boolean;\\n  resetAllData: () => void;\\n  notificationsEnabled: boolean;\\n  enableNotifications: () => Promise<void>;\\n}\\n\\nconst LegalContext = createContext<LegalContextType | undefined>(undefined);\\n\\nexport const LegalProvider: React.FC<{ children: ReactNode }> = ({ children }) => {\\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'cases\' | \'clients\' | \'deadlines\' | \'hearings\' | \'fees\' | \'tools\'>(\'dashboard\');\\n  const [selectedCaseId, setSelectedCaseId] = useState<string | null>(null);\\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\\n\\n  // Local storage state with initial fallbacks\\n  const [clients, setClients] = useState<Client[]>(() => {\\n    const saved = localStorage.getItem(`${STORAGE_KEY_PREFIX}clients`);\\n    return saved ? JSON.parse(saved) : INITIAL_CLIENTS;\\n  });\\n\\n  const [cases, setCases] = useState<LegalCase[]>(() => {\\n    const saved = localStorage.getItem(`${STORAGE_KEY_PREFIX}cases`);\\n    return saved ? JSON.parse(saved) : INITIAL_CASES;\\n  });\\n\\n  const [deadlines, setDeadlines] = useState<CaseDeadline[]>(() => {\\n    const saved = localStorage.getItem(`${STORAGE_KEY_PREFIX}deadlines`);\\n    return saved ? JSON.parse(saved) : INITIAL_DEADLINES;\\n  });\\n\\n  const [hearings, setHearings] = useState<Hearing[]>(() => {\\n    const saved = localStorage.getItem(`${STORAGE_KEY_PREFIX}hearings`);\\n    return saved ? JSON.parse(saved) : INITIAL_HEARINGS;\\n  });\\n\\n  const [feeAgreements, setFeeAgreements] = useState<FeeAgreement[]>(() => {\\n    const saved = localStorage.getItem(`${STORAGE_KEY_PREFIX}fee_agreements`);\\n    return saved ? JSON.parse(saved) : INITIAL_FEE_AGREEMENTS;\\n  });\\n\\n  const [installments, setInstallments] = useState<FeeInstallment[]>(() => {\\n    const saved = localStorage.getItem(`${STORAGE_KEY_PREFIX}installments`);\\n    return saved ? JSON.parse(saved) : INITIAL_INSTALLMENTS;\\n  });\\n\\n  const [lawyers] = useState<LawyerUser[]>(INITIAL_LAWYERS);\\n\\n  // Google Auth state\\n  const [googleUser, setGoogleUser] = useState<User | null>(null);\\n  const [googleAccessToken, setGoogleAccessToken] = useState<string | null>(null);\\n  const [isConnectingGoogle, setIsConnectingGoogle] = useState(false);\\n  const [googleSyncMessage, setGoogleSyncMessage] = useState<string | null>(null);\\n  const [notificationsEnabled, setNotificationsEnabled] = useState<boolean>(() => {\\n    return typeof window !== \'undefined\' && \'Notification\' in window && Notification.permission === \'granted\';\\n  });\\n\\n  // Persist data on change\\n  useEffect(() => {\\n    localStorage.setItem(`${STORAGE_KEY_PREFIX}clients`, JSON.stringify(clients));\\n  }, [clients]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(`${STORAGE_KEY_PREFIX}cases`, JSON.stringify(cases));\\n  }, [cases]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(`${STORAGE_KEY_PREFIX}deadlines`, JSON.stringify(deadlines));\\n  }, [deadlines]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(`${STORAGE_KEY_PREFIX}hearings`, JSON.stringify(hearings));\\n  }, [hearings]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(`${STORAGE_KEY_PREFIX}fee_agreements`, JSON.stringify(feeAgreements));\\n  }, [feeAgreements]);\\n\\n  useEffect(() => {\\n    localStorage.setItem(`${STORAGE_KEY_PREFIX}installments`, JSON.stringify(installments));\\n  }, [installments]);\\n\\n  // Init auth listener\\n  useEffect(() => {\\n    const unsubscribe = initAuth(\\n      (user, token) => {\\n        setGoogleUser(user);\\n        setGoogleAccessToken(token);\\n      },\\n      () => {\\n        setGoogleUser(null);\\n        setGoogleAccessToken(null);\\n      }\\n    );\\n    return () => {\\n      if (typeof unsubscribe === \'function\') unsubscribe();\\n    };\\n  }, []);\\n\\n  // Periodic deadline monitor (detects deadlines due today or overdue)\\n  useEffect(() => {\\n    const checkDeadlines = () => {\\n      const todayStr = new Date().toISOString().split(\'T\')[0];\\n      const urgentDeadlines = deadlines.filter((d) => d.status === \'PENDIENTE\' && d.deadlineDate <= todayStr);\\n      if (urgentDeadlines.length > 0) {\\n        soundManager.playAlert();\\n      }\\n    };\\n    checkDeadlines();\\n  }, []);\\n\\n  const enableNotifications = async () => {\\n    const granted = await requestBrowserNotificationPermission();\\n    setNotificationsEnabled(granted);\\n    if (granted) {\\n      showSystemNotification(\\n        \'Alertas BDCM Activadas\',\\n        \'Recibir\303\241s recordatorios autom\303\241ticos de plazos procesales fatales y audiencias judiciales.\'\\n      );\\n    }\\n  };\\n\\n  const connectGoogle = async () => {\\n    setIsConnectingGoogle(true);\\n    setGoogleSyncMessage(null);\\n    try {\\n      const res = await googleSignIn();\\n      if (res) {\\n        setGoogleUser(res.user);\\n        setGoogleAccessToken(res.accessToken);\\n        setGoogleSyncMessage(\'Conectado exitosamente con Google Calendar\');\\n        soundManager.playChime();\\n        setTimeout(() => setGoogleSyncMessage(null), 4000);\\n      }\\n    } catch (err: any) {\\n      console.error(\'Error connecting Google:\', err);\\n      setGoogleSyncMessage(err?.message || \'Error al conectar con Google Calendar\');\\n    } finally {\\n      setIsConnectingGoogle(false);\\n    }\\n  };\\n\\n  const disconnectGoogle = async () => {\\n    const confirmed = window.confirm(\'\302\277Deseas desconectar la cuenta de Google Calendar de este dispositivo?\');\\n    if (!confirmed) return;\\n    await authLogout();\\n    setGoogleUser(null);\\n    setGoogleAccessToken(null);\\n    setGoogleSyncMessage(\'Cuenta de Google desconectada\');\\n    setTimeout(() => setGoogleSyncMessage(null), 3000);\\n  };\\n\\n  // Sincronizar un plazo con Google Calendar\\n  const syncDeadlineToCalendar = async (deadlineId: string): Promise<{ success: boolean; message: string }> => {\\n    const dl = deadlines.find((d) => d.id === deadlineId);\\n    if (!dl) return { success: false, message: \'Plazo no encontrado\' };\\n\\n    const token = googleAccessToken || (await getAccessToken());\\n    if (!token) {\\n      return { success: false, message: \'Debes iniciar sesi\303\263n con Google Calendar primero\' };\\n    }\\n\\n    const c = cases.find((item) => item.id === dl.caseId);\\n    const caseTitle = c ? `${c.rol} - ${c.caratula}` : \'BDCM Abogados\';\\n\\n    try {\\n      const summary = `\342\232\226\357\270\217 [PLAZO FATAL BDCM] ${dl.title}`;\\n      const description = `Plazo Procesal Judicial:\\\\nCausa: ${caseTitle}\\\\nTribunal: ${c?.court || \'Tribunal\'}\\\\nTipo: ${dl.daysType}\\\\nNotas: ${dl.notes || \'Sin notas adicionales\'}\\\\nEstudio: BDCM Abogados`;\\n      const time = dl.deadlineTime || \'12:00\';\\n\\n      const [hours, mins] = time.split(\':\');\\n      const startIso = `${dl.deadlineDate}T${hours.padStart(2, \'0\')}:${mins.padStart(2, \'0\')}:00`;\\n      // Evento de 30 minutos\\n      const endHour = String((Number(hours) + 1) % 24).padStart(2, \'0\');\\n      const endIso = `${dl.deadlineDate}T${endHour}:${mins.padStart(2, \'0\')}:00`;\\n\\n      const response = await createGoogleCalendarEvent(token, {\\n        summary,\\n        description,\\n        location: c?.court || \'Poder Judicial de Chile\',\\n        start: {\\n          dateTime: new Date(startIso).toISOString(),\\n          timeZone: \'America/Santiago\',\\n        },\\n        end: {\\n          dateTime: new Date(endIso).toISOString(),\\n          timeZone: \'America/Santiago\',\\n        },\\n        reminders: {\\n          useDefault: false,\\n          overrides: [\\n            { method: \'popup\', minutes: 24 * 60 }, // 1 d\303\255a antes\\n            { method: \'popup\', minutes: 120 }, // 2 horas antes\\n            { method: \'email\', minutes: 24 * 60 },\\n          ],\\n        },\\n      });\\n\\n      setDeadlines((prev) =>\\n        prev.map((d) => (d.id === deadlineId ? { ...d, syncedToCalendar: true, googleEventId: response.id } : d))\\n      );\\n\\n      soundManager.playChime();\\n      return { success: true, message: \'Plazo sincronizado exitosamente con Google Calendar\' };\\n    } catch (err: any) {\\n      console.error(\'Error syncing deadline:\', err);\\n      return { success: false, message: err?.message || \'Error al sincronizar con Google Calendar\' };\\n    }\\n  };\\n\\n  // Sincronizar una audiencia con Google Calendar\\n  const syncHearingToCalendar = async (hearingId: string): Promise<{ success: boolean; message: string }> => {\\n    const hr = hearings.find((h) => h.id === hearingId);\\n    if (!hr) return { success: false, message: \'Audiencia no encontrada\' };\\n\\n    const token = googleAccessToken || (await getAccessToken());\\n    if (!token) {\\n      return { success: false, message: \'Debes iniciar sesi\303\263n con Google Calendar primero\' };\\n    }\\n\\n    const c = cases.find((item) => item.id === hr.caseId);\\n    const caseTitle = c ? `${c.rol} - ${c.caratula}` : \'BDCM Abogados\';\\n\\n    try {\\n      const summary = `\360\237\217\233\357\270\217 [AUDIENCIA BDCM] ${hr.title}`;\\n      const description = `Audiencia Judicial:\\\\nCausa: ${caseTitle}\\\\nTribunal: ${c?.court || \'Tribunal\'}\\\\nModalidad: ${hr.modality}\\\\nConexi\303\263n/Lugar: ${hr.courtRoomOrLink}\\\\nComparecen: ${hr.attendees}\\\\nNotas previas: ${hr.notes || \'Ninguna\'}\\\\nBDCM Abogados`;\\n\\n      const startIso = `${hr.date}T${hr.startTime || \'09:00\'}:00`;\\n      const endIso = `${hr.date}T${hr.endTime || \'10:30\'}:00`;\\n\\n      const response = await createGoogleCalendarEvent(token, {\\n        summary,\\n        description,\\n        location: hr.courtRoomOrLink,\\n        start: {\\n          dateTime: new Date(startIso).toISOString(),\\n          timeZone: \'America/Santiago\',\\n        },\\n        end: {\\n          dateTime: new Date(endIso).toISOString(),\\n          timeZone: \'America/Santiago\',\\n        },\\n        reminders: {\\n          useDefault: false,\\n          overrides: [\\n            { method: \'popup\', minutes: 24 * 60 }, // 1 d\303\255a antes\\n            { method: \'popup\', minutes: 60 }, // 1 hora antes\\n            { method: \'email\', minutes: 24 * 60 },\\n          ],\\n        },\\n      });\\n\\n      setHearings((prev) =>\\n        prev.map((h) => (h.id === hearingId ? { ...h, syncedToCalendar: true, googleEventId: response.id } : h))\\n      );\\n\\n      soundManager.playChime();\\n      return { success: true, message: \'Audiencia sincronizada en Google Calendar con \303\251xito\' };\\n    } catch (err: any) {\\n      console.error(\'Error syncing hearing:\', err);\\n      return { success: false, message: err?.message || \'Error al sincronizar audiencia\' };\\n    }\\n  };\\n\\n  // Sincronizar todos los plazos y audiencias pendientes\\n  const syncAllToCalendar = async (): Promise<{ success: boolean; count: number }> => {\\n    const token = googleAccessToken || (await getAccessToken());\\n    if (!token) {\\n      return { success: false, count: 0 };\\n    }\\n\\n    let count = 0;\\n    const unsyncedDeadlines = deadlines.filter((d) => d.status === \'PENDIENTE\' && !d.syncedToCalendar);\\n    const unsyncedHearings = hearings.filter((h) => h.status === \'PROGRAMADA\' && !h.syncedToCalendar);\\n\\n    for (const dl of unsyncedDeadlines) {\\n      const res = await syncDeadlineToCalendar(dl.id);\\n      if (res.success) count++;\\n    }\\n    for (const hr of unsyncedHearings) {\\n      const res = await syncHearingToCalendar(hr.id);\\n      if (res.success) count++;\\n    }\\n\\n    return { success: true, count };\\n  };\\n\\n  // Client CRUD\\n  const addClient = (clientData: Omit<Client, \'id\' | \'createdAt\'>): string => {\\n    const id = `cli-${Date.now()}`;\\n    const newClient: Client = {\\n      ...clientData,\\n      id,\\n      createdAt: new Date().toISOString().split(\'T\')[0],\\n    };\\n    setClients((prev) => [newClient, ...prev]);\\n    soundManager.playChime();\\n    return id;\\n  };\\n\\n  const updateClient = (id: string, updated: Partial<Client>) => {\\n    setClients((prev) => prev.map((c) => (c.id === id ? { ...c, ...updated } : c)));\\n  };\\n\\n  const deleteClient = (id: string) => {\\n    const confirmed = window.confirm(\'\302\277Seguro que deseas eliminar este cliente? Se mantendr\303\241n las causas hist\303\263ricas vinculadas.\');\\n    if (!confirmed) return;\\n    setClients((prev) => prev.filter((c) => c.id !== id));\\n  };\\n\\n  // Case CRUD\\n  const addCase = (caseData: Omit<LegalCase, \'id\' | \'createdAt\' | \'updatedAt\' | \'timeline\'>): string => {\\n    const id = `case-${Date.now()}`;\\n    const nowStr = new Date().toISOString().split(\'T\')[0];\\n    const newCase: LegalCase = {\\n      ...caseData,\\n      id,\\n      createdAt: nowStr,\\n      updatedAt: nowStr,\\n      timeline: [\\n        {\\n          id: `t-${Date.now()}`,\\n          date: nowStr,\\n          title: \'Apertura de Expediente en BDCM\',\\n          description: `Causa radicada en ${caseData.court}. Car\303\241tula: ${caseData.caratula}.`,\\n          actor: caseData.assignedLawyer || \'Estudio Jur\303\255dico BDCM\',\\n        },\\n      ],\\n    };\\n    setCases((prev) => [newCase, ...prev]);\\n    soundManager.playChime();\\n    return id;\\n  };\\n\\n  const updateCase = (id: string, updated: Partial<LegalCase>) => {\\n    setCases((prev) =>\\n      prev.map((c) =>\\n        c.id === id\\n          ? {\\n              ...c,\\n              ...updated,\\n              updatedAt: new Date().toISOString().split(\'T\')[0],\\n            }\\n          : c\\n      )\\n    );\\n  };\\n\\n  const deleteCase = (id: string) => {\\n    const confirmed = window.confirm(\'\302\277Seguro que deseas eliminar esta causa? Esta acci\303\263n no se puede deshacer.\');\\n    if (!confirmed) return;\\n    setCases((prev) => prev.filter((c) => c.id !== id));\\n    if (selectedCaseId === id) setSelectedCaseId(null);\\n  };\\n\\n  const addCaseEvent = (caseId: string, eventData: Omit<CaseEvent, \'id\'>) => {\\n    const newEvent: CaseEvent = {\\n      ...eventData,\\n      id: `t-${Date.now()}`,\\n    };\\n    setCases((prev) =>\\n      prev.map((c) =>\\n        c.id === caseId\\n          ? {\\n              ...c,\\n              updatedAt: new Date().toISOString().split(\'T\')[0],\\n              timeline: [newEvent, ...c.timeline],\\n            }\\n          : c\\n      )\\n    );\\n    soundManager.playChime();\\n  };\\n\\n  // Deadline CRUD\\n  const addDeadline = (dlData: Omit<CaseDeadline, \'id\' | \'createdAt\'>): string => {\\n    const id = `dl-${Date.now()}`;\\n    const newDeadline: CaseDeadline = {\\n      ...dlData,\\n      id,\\n      createdAt: new Date().toISOString().split(\'T\')[0],\\n    };\\n    setDeadlines((prev) => [newDeadline, ...prev]);\\n    soundManager.playChime();\\n    return id;\\n  };\\n\\n  const updateDeadline = (id: string, updated: Partial<CaseDeadline>) => {\\n    setDeadlines((prev) => prev.map((d) => (d.id === id ? { ...d, ...updated } : d)));\\n  };\\n\\n  const toggleDeadlineStatus = (id: string) => {\\n    setDeadlines((prev) =>\\n      prev.map((d) => {\\n        if (d.id === id) {\\n          const nextStatus = d.status === \'PENDIENTE\' ? \'CUMPLIDO\' : \'PENDIENTE\';\\n          return { ...d, status: nextStatus };\\n        }\\n        return d;\\n      })\\n    );\\n    soundManager.playChime();\\n  };\\n\\n  const deleteDeadline = (id: string) => {\\n    const target = deadlines.find((d) => d.id === id);\\n    const confirmed = window.confirm(`\302\277Confirmas eliminar el plazo \\\"${target?.title || \'seleccionado\'}\\\"?`);\\n    if (!confirmed) return;\\n\\n    if (target?.googleEventId && googleAccessToken) {\\n      deleteGoogleCalendarEvent(googleAccessToken, target.googleEventId).catch((err) =>\\n        console.warn(\'Error deleting Google calendar event:\', err)\\n      );\\n    }\\n    setDeadlines((prev) => prev.filter((d) => d.id !== id));\\n  };\\n\\n  // Hearing CRUD\\n  const addHearing = (hrData: Omit<Hearing, \'id\'>): string => {\\n    const id = `hr-${Date.now()}`;\\n    const newHearing: Hearing = {\\n      ...hrData,\\n      id,\\n    };\\n    setHearings((prev) => [newHearing, ...prev]);\\n    soundManager.playChime();\\n    return id;\\n  };\\n\\n  const updateHearing = (id: string, updated: Partial<Hearing>) => {\\n    setHearings((prev) => prev.map((h) => (h.id === id ? { ...h, ...updated } : h)));\\n  };\\n\\n  const deleteHearing = (id: string) => {\\n    const target = hearings.find((h) => h.id === id);\\n    const confirmed = window.confirm(`\302\277Confirmas eliminar la audiencia \\\"${target?.title || \'seleccionada\'}\\\"?`);\\n    if (!confirmed) return;\\n\\n    if (target?.googleEventId && googleAccessToken) {\\n      deleteGoogleCalendarEvent(googleAccessToken, target.googleEventId).catch((err) =>\\n        console.warn(\'Error deleting Google event:\', err)\\n      );\\n    }\\n    setHearings((prev) => prev.filter((h) => h.id !== id));\\n  };\\n\\n  // Fee & Installment actions\\n  const addFeeAgreementWithInstallments = (\\n    agreementData: Omit<FeeAgreement, \'id\' | \'createdAt\'>,\\n    customInstallments?: Array<{ dueDate: string; amount: number; notes?: string }>\\n  ) => {\\n    const agreementId = `fee-${Date.now()}`;\\n    const nowStr = new Date().toISOString().split(\'T\')[0];\\n    const newAgreement: FeeAgreement = {\\n      ...agreementData,\\n      id: agreementId,\\n      createdAt: nowStr,\\n    };\\n    setFeeAgreements((prev) => [newAgreement, ...prev]);\\n\\n    // Generar cuotas si no se especificaron manualmente\\n    const generatedInstallments: FeeInstallment[] = [];\\n    const count = agreementData.installmentsCount || 1;\\n\\n    if (customInstallments && customInstallments.length > 0) {\\n      customInstallments.forEach((ci, idx) => {\\n        generatedInstallments.push({\\n          id: `inst-${Date.now()}-${idx}`,\\n          feeAgreementId: agreementId,\\n          caseId: agreementData.caseId,\\n          clientId: agreementData.clientId,\\n          installmentNumber: idx + 1,\\n          totalInstallments: customInstallments.length,\\n          dueDate: ci.dueDate,\\n          amount: ci.amount,\\n          currency: agreementData.currency,\\n          status: \'PENDIENTE\',\\n          notes: ci.notes,\\n        });\\n      });\\n    } else {\\n      const quotaAmount = agreementData.totalAmount / count;\\n      for (let i = 1; i <= count; i++) {\\n        const d = new Date();\\n        d.setMonth(d.getMonth() + (i - 1));\\n        const dueDate = d.toISOString().split(\'T\')[0];\\n\\n        generatedInstallments.push({\\n          id: `inst-${Date.now()}-${i}`,\\n          feeAgreementId: agreementId,\\n          caseId: agreementData.caseId,\\n          clientId: agreementData.clientId,\\n          installmentNumber: i,\\n          totalInstallments: count,\\n          dueDate,\\n          amount: Math.round(quotaAmount),\\n          currency: agreementData.currency,\\n          status: \'PENDIENTE\',\\n        });\\n      }\\n    }\\n\\n    setInstallments((prev) => [...generatedInstallments, ...prev]);\\n    soundManager.playChime();\\n  };\\n\\n  const markInstallmentPaid = (\\n    installmentId: string,\\n    details: {\\n      paymentMethod: \'TRANSFERENCIA\' | \'VALE_VISTA\' | \'CHEQUE\' | \'WEBPAY\' | \'EFECTIVO\';\\n      receiptFolio?: string;\\n      notes?: string;\\n    }\\n  ) => {\\n    setInstallments((prev) =>\\n      prev.map((inst) =>\\n        inst.id === installmentId\\n          ? {\\n              ...inst,\\n              status: \'PAGADA\',\\n              paidDate: new Date().toISOString().split(\'T\')[0],\\n              paymentMethod: details.paymentMethod,\\n              receiptFolio: details.receiptFolio,\\n              notes: details.notes || inst.notes,\\n            }\\n          : inst\\n      )\\n    );\\n    soundManager.playChime();\\n  };\\n\\n  const updateInstallment = (id: string, data: Partial<FeeInstallment>) => {\\n    setInstallments((prev) => prev.map((inst) => (inst.id === id ? { ...inst, ...data } : inst)));\\n  };\\n\\n  // JSON export & backup\\n  const exportDataJson = () => {\\n    const exportData = {\\n      exportDate: new Date().toISOString(),\\n      firm: \'BDCM Abogados\',\\n      country: \'Chile\',\\n      clients,\\n      cases,\\n      deadlines,\\n      hearings,\\n      feeAgreements,\\n      installments,\\n    };\\n    const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: \'application/json\' });\\n    const url = URL.createObjectURL(blob);\\n    const link = document.createElement(\'a\');\\n    link.href = url;\\n    link.download = `BDCM_Abogados_Respaldo_${new Date().toISOString().split(\'T\')[0]}.json`;\\n    document.body.appendChild(link);\\n    link.click();\\n    document.body.removeChild(link);\\n  };\\n\\n  const importDataJson = (jsonString: string): boolean => {\\n    try {\\n      const data = JSON.parse(jsonString);\\n      if (!data.clients || !data.cases) {\\n        throw new Error(\'Estructura de archivo no v\303\241lida\');\\n      }\\n      setClients(data.clients || []);\\n      setCases(data.cases || []);\\n      setDeadlines(data.deadlines || []);\\n      setHearings(data.hearings || []);\\n      setFeeAgreements(data.feeAgreements || []);\\n      setInstallments(data.installments || []);\\n      soundManager.playChime();\\n      return true;\\n    } catch (e) {\\n      console.error(\'Error importing backup:\', e);\\n      return false;\\n    }\\n  };\\n\\n  const resetAllData = () => {\\n    const confirmed = window.confirm(\\n      \'\302\277Restablecer todos los datos del despacho a los valores de ejemplo de BDCM Abogados?\'\\n    );\\n    if (!confirmed) return;\\n    setClients(INITIAL_CLIENTS);\\n    setCases(INITIAL_CASES);\\n    setDeadlines(INITIAL_DEADLINES);\\n    setHearings(INITIAL_HEARINGS);\\n    setFeeAgreements(INITIAL_FEE_AGREEMENTS);\\n    setInstallments(INITIAL_INSTALLMENTS);\\n    soundManager.playChime();\\n  };\\n\\n  return (\\n    <LegalContext.Provider\\n      value={{\\n        activeTab,\\n        setActiveTab,\\n        selectedCaseId,\\n        setSelectedCaseId,\\n        searchQuery,\\n        setSearchQuery,\\n        clients,\\n        cases,\\n        deadlines,\\n        hearings,\\n        feeAgreements,\\n        installments,\\n        lawyers,\\n        googleUser,\\n        googleAccessToken,\\n        isConnectingGoogle,\\n        googleSyncMessage,\\n        connectGoogle,\\n        disconnectGoogle,\\n        syncDeadlineToCalendar,\\n        syncHearingToCalendar,\\n        syncAllToCalendar,\\n        addClient,\\n        updateClient,\\n        deleteClient,\\n        addCase,\\n        updateCase,\\n        deleteCase,\\n        addCaseEvent,\\n        addDeadline,\\n        updateDeadline,\\n        toggleDeadlineStatus,\\n        deleteDeadline,\\n        addHearing,\\n        updateHearing,\\n        deleteHearing,\\n        addFeeAgreementWithInstallments,\\n        markInstallmentPaid,\\n        updateInstallment,\\n        exportDataJson,\\n        importDataJson,\\n        resetAllData,\\n        notificationsEnabled,\\n        enableNotifications,\\n      }}\\n    >\\n      {children}\\n    </LegalContext.Provider>\\n  );\\n};\\n\\nexport const useLegal = (): LegalContextType => {\\n  const context = useContext(LegalContext);\\n  if (!context) {\\n    throw new Error(\'useLegal must be used within a LegalProvider\');\\n  }\\n  return context;\\n};\\n\",\"Description\":\"Contexto y Store de estado global de BDCM Abogados con persistencia local y sincronizaci\303\263n Google Calendar\",\"Overwrite\":true,\"TargetFile\":\"/src/context/LegalContext.tsx\",\"toolAction\":\"Creando contexto LegalContext\",\"toolSummary\":\"Crear LegalContext.tsx\"}"
      thinking_signature: "\022\213\f\n\210\f\001i\024}\023\212\031\253\340\302\263\235$\256\234\351\024\355K\311l8\035\3240\251\265\022BFD\217\220\226\340Q\026z\255J.\205~\250D\334\334\b\330{Z/\2135V\261\211\327\006\016\325\255T\357sC6\271\204\'\362\302\306\021M\020:\335\206\343\372\017\354\221\356\274\212d\242\2725\342\355\317\214\335\300\305\025\264\235c\367f8(\a\347\324-93\345\343m\236\b\016\347\250\333\257\'\211*\313\360\322\373\246t\347\205[\252\212\327\311\205_\337CG\374\v\340\232#\314\331\f\346}\215\204\023>\213\250\324\027\260;\'\246\253\273\204N\240\225{\311\257\300v\253m\201:A\343G\t\221\374\245\337\310\224\247\225\261\2162\0017(}\025\224\320\201K\"\257\303;\230\2232\274\004^\340Q\301.9F\345\370\313\336{8\244\373+3\360\344\273\365\203\302\2505\3529\022\354\326\356\212\362\354\344I 4lX~3\332.o6\356\220{\250\262\364g\325\261\020\375\264\362\220\250\203\260\324*\230k\374\351\031\177\255\222\242\222M1\271:\313\a-\354_\243\314\215,\225\254k\341N\304\334\223e\241\276\v\020M\266\t\333bU>^\366\365n\353|\002\3708\240VRv]cF\330\263MJ\255\333\002\n\357\325p\037I\215H\376\3425(c\376\020\3150\340F\201\000\352x\336u\255;\272\016SEeX1D-\203\217\367I;\221|\000\275!\252\230\270Y\303}X\227j\353\307\222F\343\267\034\235\212\n\201\016\337\324\344\222S\225\216\210h\365\361\372\f\362\261L\r\177=\326\243\302\202\341\n\334\3344Y\034RA\315Y\367\374\261%\220\240b\370Q%\001.\002*\221\342?\005\313\264\373n^\337\244y\3643\2779\352\371;\265\261\r\234\344\234\276\a\n\367\001U<!\332t\000\337\n\203 \255j\362:\212\322\373\242j\033>\"tP\231\215lj81\355\310S\366\224V8\213\205V\252\251\027f\363\327\025\017\227a[l\222\2405\257\264\345\300l\245\r\2759\255\017\202\233+\306l\027\232\036\356\322]\373)\240<\224ei+\303\201\027\327[\247r\016\254\251`\026\306&\344A5\372\234,\301\315\315w\016?P\031\002\224N\2573d\230\317\315J\271:N\b\261L\330<\256\227$\305}LFP2R^>B\365\376\342X2\262\265\335{\210/\304\266{\250+\225\224\3749\250TA\377\225\277A\346B6\245\207E\325\2153Uj\273\376\357;*\033\311 \273\261\261