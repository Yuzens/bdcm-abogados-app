  planner_response {
    thinking: "**Designing the Legal Tool**\n\nI\'m currently focused on the `src/components/views/ToolsView.tsx` component. The initial build is for a Chilean Legal Deadlines Calculator. The core inputs will be the Notification Date and the number of days, with options for 3, 5, 10, and 15 days.\n\n\n**Expanding the Calculator\'s Scope**\n\nI\'ve been adding details. I\'m incorporating the nuances of different legal contexts: civil, labor, and penal. I\'m also including clear explanations of how the calculations work, noting skipped non-working days. A button for direct deadline creation in the dispatch is also added. Finally, there\'s a section with links to essential Chilean legal portals. The addition of JSON backup/restore functionality is on the horizon.\n\n\n"
    tool_calls {
      id: "call_393238"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useLegal } from \'../../context/LegalContext\';\\nimport {\\n  Wrench,\\n  Calculator,\\n  Calendar,\\n  ExternalLink,\\n  Download,\\n  Upload,\\n  RefreshCw,\\n  Scale,\\n  Sparkles,\\n  ShieldAlert,\\n  Info,\\n  CheckCircle,\\n} from \'lucide-react\';\\nimport { calculateLegalDeadline, formatDateCL } from \'../../utils/chileanLegal\';\\n\\ninterface Props {\\n  onOpenNewDeadlineWithDate: (computedDate: string, daysType: any, daysCount: number) => void;\\n}\\n\\nexport const ToolsView: React.FC<Props> = ({ onOpenNewDeadlineWithDate }) => {\\n  const { exportDataJson, importDataJson, resetAllData } = useLegal();\\n\\n  // Estado Calculadora\\n  const [startDate, setStartDate] = useState(() => new Date().toISOString().split(\'T\')[0]);\\n  const [daysCount, setDaysCount] = useState<number>(5);\\n  const [computationType, setComputationType] = useState<\'HABILES_CIVIL\' | \'HABILES_LABORAL\' | \'CORRIDOS\'>(\'HABILES_CIVIL\');\\n  const [calculationResult, setCalculationResult] = useState<{ deadlineDate: string; breakdown: string[] } | null>(null);\\n\\n  const [importStatus, setImportStatus] = useState<string | null>(null);\\n\\n  const handleCalculate = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const result = calculateLegalDeadline(startDate, daysCount, computationType);\\n    setCalculationResult(result);\\n  };\\n\\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n\\n    const reader = new FileReader();\\n    reader.onload = (event) => {\\n      const content = event.target?.result as string;\\n      const ok = importDataJson(content);\\n      if (ok) {\\n        setImportStatus(\'\302\241Datos de respaldo restaurados con \303\251xito!\');\\n        setTimeout(() => setImportStatus(null), 4000);\\n      } else {\\n        setImportStatus(\'Error: el archivo no tiene un formato v\303\241lido.\');\\n      }\\n    };\\n    reader.readAsText(file);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-8 pb-16\\\">\\n      <div>\\n        <h1 className=\\\"text-xl sm:text-2xl font-bold font-legal-heading text-slate-100 flex items-center gap-2.5\\\">\\n          <Wrench className=\\\"w-6 h-6 text-amber-400\\\" />\\n          Herramientas Jur\303\255dicas & Calculadora Procesal\\n        </h1>\\n        <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n          C\303\263mputo de plazos seg\303\272n legislaci\303\263n chilena (CPC y C\303\263digo del Trabajo), accesos al PJUD y copias de seguridad\\n        </p>\\n      </div>\\n\\n      {/* 1. CALCULADORA DE PLAZOS JUDICIALES CHILENOS */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6\\\">\\n        <div className=\\\"flex items-center gap-3 border-b border-slate-800 pb-4\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400\\\">\\n            <Calculator className=\\\"w-5 h-5\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-100 font-legal-heading\\\">\\n              Calculadora de Plazos Judiciales Chilenos\\n            </h2>\\n            <p className=\\\"text-xs text-slate-400\\\">\\n              Descuenta autom\303\241ticamente domingos, festivos oficiales de Chile y s\303\241bados seg\303\272n la materia\\n            </p>\\n          </div>\\n        </div>\\n\\n        <form onSubmit={handleCalculate} className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              Fecha de Notificaci\303\263n / Resoluci\303\263n\\n            </label>\\n            <input\\n              type=\\\"date\\\"\\n              value={startDate}\\n              onChange={(e) => setStartDate(e.target.value)}\\n              className=\\\"w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\\\"\\n              required\\n            />\\n            <span className=\\\"text-[10px] text-slate-500 mt-1 block\\\">\\n              El plazo comienza a correr al d\303\255a h\303\241bil siguiente (Art. 67 CPC).\\n            </span>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              D\303\255as de Plazo Legal\\n            </label>\\n            <input\\n              type=\\\"number\\\"\\n              min=\\\"1\\\"\\n              max=\\\"365\\\"\\n              value={daysCount}\\n              onChange={(e) => setDaysCount(Number(e.target.value))}\\n              className=\\\"w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\\\"\\n              required\\n            />\\n            <div className=\\\"flex gap-1.5 mt-1.5\\\">\\n              {[3, 5, 8, 10, 15, 18].map((preset) => (\\n                <button\\n                  key={preset}\\n                  type=\\\"button\\\"\\n                  onClick={() => setDaysCount(preset)}\\n                  className=\\\"px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[10px] font-mono-legal\\\"\\n                >\\n                  {preset}d\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-300 mb-1\\\">\\n              R\303\251gimen de C\303\263mputo\\n            </label>\\n            <select\\n              value={computationType}\\n              onChange={(e) => setComputationType(e.target.value as any)}\\n              className=\\\"w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\\\"\\n            >\\n              <option value=\\\"HABILES_CIVIL\\\">Civil (CPC Art. 66: Lunes a S\303\241bado)</option>\\n              <option value=\\\"HABILES_LABORAL\\\">Laboral / Penal (Lunes a Viernes)</option>\\n              <option value=\\\"CORRIDOS\\\">D\303\255as Corridos (Prorroga al h\303\241bil sgte)</option>\\n            </select>\\n          </div>\\n\\n          <div className=\\\"md:col-span-3 flex justify-end\\\">\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"px-5 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2 cursor-pointer\\\"\\n            >\\n              <Sparkles className=\\\"w-4 h-4\\\" />\\n              Calcular Fecha Fatal\\n            </button>\\n          </div>\\n        </form>\\n\\n        {calculationResult && (\\n          <div className=\\\"p-5 bg-slate-950 border border-amber-500/30 rounded-xl space-y-4\\\">\\n            <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <div>\\n                <span className=\\\"text-xs text-slate-400 block font-medium\\\">Fecha de Vencimiento Fatal:</span>\\n                <div className=\\\"text-2xl font-bold text-amber-300 font-mono-legal mt-0.5\\\">\\n                  {formatDateCL(calculationResult.deadlineDate)} (23:59 hrs)\\n                </div>\\n                <span className=\\\"text-xs text-slate-400\\\">\\n                  Total de {daysCount} d\303\255as calculados bajo r\303\251gimen{\' \'}\\n                  <span className=\\\"text-slate-200 font-semibold\\\">{computationType}</span>\\n                </span>\\n              </div>\\n\\n              <button\\n                onClick={() => onOpenNewDeadlineWithDate(calculationResult.deadlineDate, computationType, daysCount)}\\n                className=\\\"px-4 py-2 bg-rose-500 hover:bg-rose-400 text-white font-bold text-xs rounded-xl shadow-md shadow-rose-500/20 transition-colors flex items-center gap-2 self-start cursor-pointer\\\"\\n              >\\n                <Calendar className=\\\"w-4 h-4\\\" />\\n                Crear Plazo con esta Fecha\\n              </button>\\n            </div>\\n\\n            <div className=\\\"border-t border-slate-800 pt-3\\\">\\n              <span className=\\\"text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2\\\">\\n                Desglose Cronol\303\263gico del C\303\263mputo Judicial:\\n              </span>\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 text-xs font-mono-legal text-slate-300\\\">\\n                {calculationResult.breakdown.map((item, idx) => (\\n                  <div\\n                    key={idx}\\n                    className={`p-2 rounded-lg border text-[11px] ${\\n                      item.includes(\'Inh\303\241bil\') || item.includes(\'Feriado\') || item.includes(\'Domingo\')\\n                        ? \'bg-rose-950/20 border-rose-500/30 text-rose-300\'\\n                        : item.includes(\'Prorroga\')\\n                        ? \'bg-amber-950/20 border-amber-500/30 text-amber-300\'\\n                        : \'bg-slate-900 border-slate-800 text-slate-300\'\\n                    }`}\\n                  >\\n                    {item}\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* 2. ACCESOS DIRECTOS A INSTITUCIONES JUDICIALES CHILENAS */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4\\\">\\n        <div className=\\\"flex items-center gap-3 border-b border-slate-800 pb-4\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400\\\">\\n            <Scale className=\\\"w-5 h-5\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-100 font-legal-heading\\\">\\n              Portales del Poder Judicial de Chile\\n            </h2>\\n            <p className=\\\"text-xs text-slate-400\\\">\\n              Acceso r\303\241pido a tramitaci\303\263n telem\303\241tica, jurisprudencia y registros p\303\272blicos\\n            </p>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs\\\">\\n          <a\\n            href=\\\"https://ojv.pjud.cl/kpitec-ojv-web/login\\\"\\n            target=\\\"_blank\\\"\\n            rel=\\\"noopener noreferrer\\\"\\n            className=\\\"p-4 bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 rounded-xl transition-all group flex items-start justify-between\\\"\\n          >\\n            <div>\\n              <p className=\\\"font-bold text-slate-200 group-hover:text-amber-400 transition-colors text-sm\\\">\\n                Oficina Judicial Virtual (OJV)\\n              </p>\\n              <p className=\\\"text-slate-400 mt-1\\\">\\n                Ingreso de demandas, escritos, poderes y revisi\303\263n de expedientes digitales con Clave\303\232nica.\\n              </p>\\n            </div>\\n            <ExternalLink className=\\\"w-4 h-4 text-slate-500 group-hover:text-amber-400 shrink-0 ml-2\\\" />\\n          </a>\\n\\n          <a\\n            href=\\\"https://civil.pjud.cl\\\"\\n            target=\\\"_blank\\\"\\n            rel=\\\"noopener noreferrer\\\"\\n            className=\\\"p-4 bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 rounded-xl transition-all group flex items-start justify-between\\\"\\n          >\\n            <div>\\n              <p className=\\\"font-bold text-slate-200 group-hover:text-amber-400 transition-colors text-sm\\\">\\n                Consulta Unificada de Causas\\n              </p>\\n              <p className=\\\"text-slate-400 mt-1\\\">\\n                B\303\272squeda p\303\272blica por ROL, RIT o RUC en tribunales civiles, laborales, penal y familia.\\n              </p>\\n            </div>\\n            <ExternalLink className=\\\"w-4 h-4 text-slate-500 group-hover:text-amber-400 shrink-0 ml-2\\\" />\\n          </a>\\n\\n          <a\\n            href=\\\"https://www.diarioficial.interior.gob.cl\\\"\\n            target=\\\"_blank\\\"\\n            rel=\\\"noopener noreferrer\\\"\\n            className=\\\"p-4 bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 rounded-xl transition-all group flex items-start justify-between\\\"\\n          >\\n            <div>\\n              <p className=\\\"font-bold text-slate-200 group-hover:text-amber-400 transition-colors text-sm\\\">\\n                Diario Oficial de Chile\\n              </p>\\n              <p className=\\\"text-slate-400 mt-1\\\">\\n                Notificaciones por avisos, publicaciones de quiebras, extractos de sociedades y leyes.\\n              </p>\\n            </div>\\n            <ExternalLink className=\\\"w-4 h-4 text-slate-500 group-hover:text-amber-400 shrink-0 ml-2\\\" />\\n          </a>\\n\\n          <a\\n            href=\\\"https://www.bcn.cl/leychile/\\\"\\n            target=\\\"_blank\\\"\\n            rel=\\\"noopener noreferrer\\\"\\n            className=\\\"p-4 bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 rounded-xl transition-all group flex items-start justify-between\\\"\\n          >\\n            <div>\\n              <p className=\\\"font-bold text-slate-200 group-hover:text-amber-400 transition-colors text-sm\\\">\\n                Ley Chile (BCN)\\n              </p>\\n              <p className=\\\"text-slate-400 mt-1\\\">\\n                Biblioteca del Congreso Nacional: C\303\263digos Civil, Procesal Civil, Penal y del Trabajo vigentes.\\n              </p>\\n            </div>\\n            <ExternalLink className=\\\"w-4 h-4 text-slate-500 group-hover:text-amber-400 shrink-0 ml-2\\\" />\\n          </a>\\n\\n          <a\\n            href=\\\"https://www.cbrsantiago.cl\\\"\\n            target=\\\"_blank\\\"\\n            rel=\\\"noopener noreferrer\\\"\\n            className=\\\"p-4 bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 rounded-xl transition-all group flex items-start justify-between\\\"\\n          >\\n            <div>\\n              <p className=\\\"font-bold text-slate-200 group-hover:text-amber-400 transition-colors text-sm\\\">\\n                Conservador de Bienes Ra\303\255ces\\n              </p>\\n              <p className=\\\"text-slate-400 mt-1\\\">\\n                CBR Santiago: certificados de dominio vigente, hipotecas, grav\303\241menes e interdicciones.\\n              </p>\\n            </div>\\n            <ExternalLink className=\\\"w-4 h-4 text-slate-500 group-hover:text-amber-400 shrink-0 ml-2\\\" />\\n          </a>\\n\\n          <a\\n            href=\\\"https://www.cmfchile.cl\\\"\\n            target=\\\"_blank\\\"\\n            rel=\\\"noopener noreferrer\\\"\\n            className=\\\"p-4 bg-slate-950/60 hover:bg-slate-800/80 border border-slate-800 rounded-xl transition-all group flex items-start justify-between\\\"\\n          >\\n            <div>\\n              <p className=\\\"font-bold text-slate-200 group-hover:text-amber-400 transition-colors text-sm\\\">\\n                Comisi\303\263n Mercado Financiero (CMF)\\n              </p>\\n              <p className=\\\"text-slate-400 mt-1\\\">\\n                Consulta de entidades reguladas, acreencias bancarias y estados financieros corporativos.\\n              </p>\\n            </div>\\n            <ExternalLink className=\\\"w-4 h-4 text-slate-500 group-hover:text-amber-400 shrink-0 ml-2\\\" />\\n          </a>\\n        </div>\\n      </div>\\n\\n      {/* 3. RESPALDO Y RESTAURACI\303\223N DE DATOS DEL DESPACHO */}\\n      <div className=\\\"bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4\\\">\\n        <div className=\\\"flex items-center gap-3 border-b border-slate-800 pb-4\\\">\\n          <div className=\\\"w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400\\\">\\n            <Download className=\\\"w-5 h-5\\\" />\\n          </div>\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-100 font-legal-heading\\\">\\n              Seguridad, Respaldos & Exportaci\303\263n\\n            </h2>\\n            <p className=\\\"text-xs text-slate-400\\\">\\n              Descarga una copia completa de las causas, clientes, audiencias y honorarios de BDCM Abogados\\n            </p>\\n          </div>\\n        </div>\\n\\n        {importStatus && (\\n          <div className=\\\"p-3 bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 rounded-xl text-xs font-semibold flex items-center gap-2\\\">\\n            <CheckCircle className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>{importStatus}</span>\\n          </div>\\n        )}\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\\\">\\n          <div className=\\\"p-4 bg-slate-950/60 border border-slate-800 rounded-xl space-y-3\\\">\\n            <span className=\\\"font-bold text-slate-200 block text-sm\\\">Exportar Respaldo</span>\\n            <p className=\\\"text-slate-400\\\">\\n              Descarga un archivo JSON cifrado localmente con toda la informaci\303\263n de causas y clientes.\\n            </p>\\n            <button\\n              onClick={exportDataJson}\\n              className=\\\"w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n            >\\n              <Download className=\\\"w-4 h-4\\\" />\\n              Descargar Respaldo JSON\\n            </button>\\n          </div>\\n\\n          <div className=\\\"p-4 bg-slate-950/60 border border-slate-800 rounded-xl space-y-3\\\">\\n            <span className=\\\"font-bold text-slate-200 block text-sm\\\">Restaurar Copia</span>\\n            <p className=\\\"text-slate-400\\\">\\n              Sube un archivo de respaldo previamente exportado para recuperar datos.\\n            </p>\\n            <label className=\\\"w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg flex items-center justify-center gap-2 transition-colors cursor-pointer border border-slate-700\\\">\\n              <Upload className=\\\"w-4 h-4\\\" />\\n              <span>Seleccionar Archivo</span>\\n              <input type=\\\"file\\\" accept=\\\".json\\\" onChange={handleFileUpload} className=\\\"hidden\\\" />\\n            </label>\\n          </div>\\n\\n          <div className=\\\"p-4 bg-slate-950/60 border border-slate-800 rounded-xl space-y-3\\\">\\n            <span className=\\\"font-bold text-slate-200 block text-sm\\\">Restablecer Muestra</span>\\n            <p className=\\\"text-slate-400\\\">\\n              Reinicia los datos a los expedientes iniciales de prueba de BDCM Abogados en Chile.\\n            </p>\\n            <button\\n              onClick={resetAllData}\\n              className=\\\"w-full py-2 bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 font-semibold rounded-lg border border-rose-500/30 flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n            >\\n              <RefreshCw className=\\\"w-4 h-4\\\" />\\n              Restablecer Datos de Ejemplo\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Herramientas procesales: Calculadora legal chilena de plazos CPC/Laboral, accesos oficiales PJUD y respaldo de datos\",\"Overwrite\":true,\"TargetFile\":\"/src/components/views/ToolsView.tsx\",\"toolAction\":\"Creando ToolsView\",\"toolSummary\":\"Crear ToolsView.tsx\"}"
      thinking_signature: "\022\220\r\n\215\r\001i\024}\023\207\016\307\267\363K\246\356d\r\255*\320\212,b\367\247\342/\326\366\274*\236~\376\33489Z\200\275\356\204\310\036\233\267C\021`G\245UF\225E\303b\234\323\001>\270\312L\310\372t\275\317x\021\276j\264Z\\\344\240\314\016SL\243\362-\207]|\336\351eA\201[\267\347C}\361\220\350\220 W\215\360\273\fN\fM^\253\'\000\255*\2324\352\242\267P\372%\235\220E}|\250\377\264\273>\253\307\222/\346E\'\004\032\000\323_\310q\030\204Q\333\307\257\3373H@\353Ho\266\274\335b\373kn*F\332\034\310\324\203\236O\272%*+&\316:o\350\236\r\'\335\367GU\342&2\260\t\261\024W3\254\223:u\331\000\b\355\254$\250\304\224\220K\225=,z%\017\236\006GF02\00417\235Y\235\234\307\225\323 5\020\355i\3411\217\374H\241\242\356K\236\"c\316\n\031FA\377\235V\v\247\225},B\360V\331\324\224x&\213\b\b\by\017\260\\\255\302\302~9\027Jb\317K\373\336\026\344\351/\322\367\247\203\265ik\270)uU\337\331?\231E\002ZxA\272\236;{\000\343\351\336\005\306:\316\363\222\341\366\337\375\337n\242\246\263\272\207\345\312\366\220\005\265\320\345\034o\371!\274mS\022\203L\2035\327\232\275M\332\323\021\206\345\376\272\375q\363p\027\037\304\307\n\023N\367N\301\\R\342\244\030\241\214\\\016\337\222\200\\(\000\343G\366\341\356\331h\b\374\336\n\b\000#\324d\025\f\023^\214\347!\314O\214\350\313q\2515\036\363G\t\335\373\366\000\253\365F>\036N\n\356T\356Y\bx\323\303\3133e\263jE\021\3239\230.[\264q\022_\021C\224=\251\260\311\230Zf\256\263\201\221\207\0176\000\\&UK\214\346\232\3639\3161.\266\200x\317\200n\344\210F)\372V\306x\347\240\212)\2475\320\025j\370\000W\371CL:\255\025Ps\025\274\371\215\0050O\204\201\253\315y\210\256P\351]\315M7\035]A\027\347\017Ew\344\'\211Y\204Q\210U\275S&\355\325\324\225B\000V\030\350d\250*\204oz,\275Lp\0279@ \217o\356\241\036\331\360\301\346ojo4\355w\222%\200/w4\aU\215}i\375\213\376\vWA\361>Z\201\261\205|P|\205\240\323\365w\354u\334\016\360\'S^\2043\2307\204p\355\300\240\2772O\v\177\340\320\016\"\026\026U\324\324k\214b\033N\203\235\310\272%\375\335\371cD\307\243\267\361[\210\36