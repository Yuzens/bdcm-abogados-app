  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport { LegalCase, LegalSubject, CaseStatus, CaseEvent } from \'../../types\';\nimport {\n  Briefcase,\n  Search,\n  Plus,\n  Scale,\n  ExternalLink,\n  Calendar,\n  Clock,\n  DollarSign,\n  User,\n  Building2,\n  FileText,\n  Trash2,\n  Edit,\n  ChevronRight,\n  MessageSquare,\n  CheckCircle,\n  AlertCircle,\n  Send,\n  X,\n} from \'lucide-react\';\nimport { formatCurrency, formatDateCL } from \'../../utils/chileanLegal\';\n\ninterface Props {\n  onOpenNewCase: () => void;\n  onOpenNewDeadline: (caseId?: string) => void;\n  onOpenNewHearing: (caseId?: string) => void;\n  onOpenNewFee: (caseId?: string) => void;\n}\n\nexport const CasesView: React.FC<Props> = ({\n  onOpenNewCase,\n  onOpenNewDeadline,\n  onOpenNewHearing,\n  onOpenNewFee,\n}) => {\n  const {\n    cases,\n    clients,\n    deadlines,\n    hearings,\n    feeAgreements,\n    installments,\n    selectedCaseId,\n    setSelectedCaseId,\n    searchQuery,\n    setSearchQuery,\n    deleteCase,\n    addCaseEvent,\n    toggleDeadlineStatus,\n  } = useLegal();\n\n  const [subjectFilter, setSubjectFilter] = useState<string>(\'TODAS\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'TODAS\');\n  const [detailTab, setDetailTab] = useState<\'timeline\' | \'deadlines\' | \'hearings\' | \'fees\'>(\'timeline\');\n\n  // Nuevo evento en bit\303\241cora\n  const [newActionTitle, setNewActionTitle] = useState(\'\');\n  const [newActionDesc, setNewActionDesc] = useState(\'\');\n  const [newActionActor, setNewActionActor] = useState(\'Abogado BDCM\');\n\n  const selectedCase = cases.find((c) => c.id === selectedCaseId);\n\n  // Filtrado\n  const filteredCases = cases.filter((c) => {\n    if (subjectFilter !== \'TODAS\' && c.subject !== subjectFilter) return false;\n    if (statusFilter !== \'TODAS\' && c.status !== statusFilter) return false;\n\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      const client = clients.find((cli) => cli.id === c.clientId);\n      const matchesRol = c.rol.toLowerCase().includes(q);\n      const matchesCaratula = c.caratula.toLowerCase().includes(q);\n      const matchesCourt = c.court.toLowerCase().includes(q);\n      const matchesClient = client?.name.toLowerCase().includes(q) || client?.rut.toLowerCase().includes(q);\n      const matchesOpposing = c.opposingParty.toLowerCase().includes(q);\n      return matchesRol || matchesCaratula || matchesCourt || matchesClient || matchesOpposing;\n    }\n\n    return true;\n  });\n\n  const handleAddTimelineEvent = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedCaseId || !newActionTitle.trim()) return;\n\n    addCaseEvent(selectedCaseId, {\n      date: new Date().toISOString().split(\'T\')[0],\n      title: newActionTitle.trim(),\n      description: newActionDesc.trim() || \'Actuaci\303\263n procesal registrada.\',\n      actor: newActionActor,\n    });\n\n    setNewActionTitle(\'\');\n    setNewActionDesc(\'\');\n  };\n\n  const getStatusBadge = (status: CaseStatus) => {\n    switch (status) {\n      case \'TRAMITACION\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-blue-500/15 text-blue-300 border border-blue-500/30\">En Tramitaci\303\263n</span>;\n      case \'CITACION_SENTENCIA\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30\">Citaci\303\263n Sentencia</span>;\n      case \'EN_ACUERDO\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-purple-500/15 text-purple-300 border border-purple-500/30\">En Acuerdo</span>;\n      case \'APELACION\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-indigo-500/15 text-indigo-300 border border-indigo-500/30\">En Apelaci\303\263n</span>;\n      case \'TERMINADA\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\">Terminada</span>;\n      case \'ARCHIVADA\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-700 text-slate-300\">Archivada</span>;\n      case \'SUSPENDIDA\':\n        return <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold bg-rose-500/15 text-rose-300 border border-rose-500/30\">Suspendida</span>;\n      default:\n        return null;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      {/* Encabezado */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold font-legal-heading text-slate-100 flex items-center gap-2.5\">\n            <Briefcase className=\"w-6 h-6 text-amber-400\" />\n            Causas & Expedientes Judiciales\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Gesti\303\263n de litigios en tribunales chilenos, ROL/RIT, bit\303\241cora y seguimiento\n          </p>\n        </div>\n\n        <button\n          onClick={onOpenNewCase}\n          className=\"px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-semibold text-xs rounded-xl shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2 self-start cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          Nueva Causa\n        </button>\n      </div>\n\n      {/* Filtros */}\n      <div className=\"flex flex-wrap items-center gap-2 border-b border-slate-800 pb-4\">\n        <span className=\"text-xs text-slate-500 mr-2\">Materia:</span>\n        {[\'TODAS\', \'Civil\', \'Laboral\', \'Penal\', \'Familia\', \'Constitucional\', \'Comercial\'].map((sub) => (\n          <button\n            key={sub}\n            onClick={() => setSubjectFilter(sub)}\n            className={`px-3 py-1 rounded-lg text-xs font-medium transition-colors cursor-pointer ${\n              subjectFilter === sub\n                ? \'bg-amber-500 text-slate-950 font-semibold\'\n                : \'bg-slate-900 border border-slate-800 text-slate-400 hover:text-slate-200 hover:border-slate-700\'\n            }`}\n          >\n            {sub}\n          </button>\n        ))}\n\n        <div className=\"ml-auto flex items-center gap-2\">\n          <select\n            value={statusFilter}\n            onChange={(e) => setStatusFilter(e.target.value)}\n            className=\"bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1 text-xs text-slate-300 focus:outline-hidden focus:border-amber-400\"\n          >\n            <option value=\"TODAS\">Todos los Estados</option>\n            <option value=\"TRAMITACION\">En Tramitaci\303\263n</option>\n            <option value=\"CITACION_SENTENCIA\">Citaci\303\263n a Sentencia</option>\n            <option value=\"APELACION\">En Apelaci\303\263n</option>\n            <option value=\"TERMINADA\">Terminadas</option>\n            <option value=\"ARCHIVADA\">Archivadas</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Grid: Lista de causas a la izquierda, Detalle a la derecha si est\303\241 seleccionada */}\n      <div className={`grid grid-cols-1 ${selectedCase ? \'lg:grid-cols-12\' : \'\'} gap-6`}>\n        {/* Columna Lista de Causas */}\n        <div className={`${selectedCase ? \'lg:col-span-5\' : \'w-full\'} space-y-3`}>\n          {filteredCases.length === 0 ? (\n            <div className=\"bg-slate-900/60 border border-slate-800 rounded-2xl p-8 text-center space-y-3\">\n              <Scale className=\"w-10 h-10 text-slate-600 mx-auto\" />\n              <p className=\"text-sm font-semibold text-slate-300\">No se encontraron expedientes</p>\n              <p className=\"text-xs text-slate-500\">Prueba ajustando los filtros o registra una nueva causa.</p>\n              <button\n                onClick={onOpenNewCase}\n                className=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-semibold rounded-lg border border-amber-500/30\"\n              >\n                + Registrar Causa\n              </button>\n            </div>\n          ) : (\n            filteredCases.map((c) => {\n              const client = clients.find((cli) => cli.id === c.clientId);\n              const isSelected = selectedCaseId === c.id;\n              const caseDeadlines = deadlines.filter((d) => d.caseId === c.id && d.status === \'PENDIENTE\');\n\n              return (\n                <div\n                  key={c.id}\n                  onClick={() => setSelectedCaseId(c.id)}\n                  className={`p-4 rounded-xl border transition-all cursor-pointer relative overflow-hidden group ${\n                    isSelected\n                      ? \'bg-slate-850 border-amber-500/60 shadow-md shadow-amber-500/5\'\n                      : \'bg-slate-900/80 hover:bg-slate-850/80 border-slate-800 hover:border-slate-700\'\n                  }`}\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <div>\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"font-mono-legal text-xs font-bold text-amber-400\">\n                          {c.rol}\n                        </span>\n                        {getStatusBadge(c.status)}\n                      </div>\n                      <h3 className=\"text-sm font-semibold text-slate-100 mt-1 line-clamp-1\">\n                        {c.caratula}\n                      </h3>\n                    </div>\n                    <ChevronRight className={`w-4 h-4 text-slate-500 transition-transform ${isSelected ? \'translate-x-1 text-amber-400\' : \'group-hover:translate-x-0.5\'}`} />\n                  </div>\n\n                  <p className=\"text-xs text-slate-400 mt-1.5 truncate\">\n                    {c.court}\n                  </p>\n\n                  <div className=\"flex items-center justify-between text-[11px] text-slate-400 pt-2.5 mt-2.5 border-t border-slate-800/80\">\n                    <span className=\"truncate max-w-[160px] text-slate-300\">\n                      Cliente: {client?.name.split(\' \')[0]}\n                    </span>\n                    <div className=\"flex items-center gap-3\">\n                      {caseDeadlines.length > 0 && (\n                        <span className=\"text-rose-400 font-mono-legal font-medium flex items-center gap-1\">\n                          <Clock className=\"w-3 h-3\" />\n                          {caseDeadlines.length} {caseDeadlines.length === 1 ? \'plazo\' : \'plazos\'}\n                        </span>\n                      )}\n                      <span className=\"text-slate-400 font-medium\">\n                        {c.subject}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })\n          )}\n        </div>\n\n        {/* Columna Detalle Completo de Causa */}\n        {selectedCase && (\n          <div className=\"lg:col-span-7 bg-slate-900 border border-slate-700/80 rounded-2xl p-6 space-y-6 shadow-2xl relative\">\n            {/* Header del expediente */}\n            <div className=\"flex items-start justify-between gap-4 border-b border-slate-800 pb-4\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"px-2.5 py-1 bg-amber-500/15 border border-amber-500/30 rounded-lg text-xs font-mono-legal font-bold text-amber-300\">\n                    ROL {selectedCase.rol}\n                  </span>\n                  {getStatusBadge(selectedCase.status)}\n                  <span className=\"text-xs text-slate-400 uppercase tracking-wider font-semibold\">\n                    {selectedCase.subject}\n                  </span>\n                </div>\n                <h2 className=\"text-lg font-bold text-slate-100 mt-2 font-legal-heading\">\n                  {selectedCase.caratula}\n                </h2>\n                <p className=\"text-xs text-slate-400 mt-0.5\">\n                  Radicada en: <span className=\"text-slate-200 font-medium\">{selectedCase.court}</span>\n                </p>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <a\n                  href={selectedCase.pjudLink || \'https://ojv.pjud.cl\'}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-blue-400 text-xs font-semibold rounded-lg border border-slate-700 flex items-center gap-1.5 transition-colors\"\n                  title=\"Abrir en Oficina Judicial Virtual\"\n                >\n                  <ExternalLink className=\"w-3.5 h-3.5\" />\n                  PJUD\n                </a>\n                <button\n                  onClick={() => deleteCase(selectedCase.id)}\n                  className=\"p-1.5 text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors\"\n                  title=\"Eliminar causa\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n                <button\n                  onClick={() => setSelectedCaseId(null)}\n                  className=\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Ficha Resumen de Partes */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 bg-slate-950/60 border border-slate-800/80 rounded-xl text-xs\">\n              <div>\n                <span className=\"text-[10px] uppercase font-bold text-slate-400 block mb-1\">\n                  Cliente Patrocinado ({selectedCase.clientRole})\n                </span>\n                <p className=\"font-semibold text-slate-200\">\n                  {clients.find((cli) => cli.id === selectedCase.clientId)?.name || \'Cliente\'}\n                </p>\n                <p className=\"text-slate-400 font-mono-legal\">\n                  RUT: {clients.find((cli) => cli.id === selectedCase.clientId)?.rut || \'Sin RUT\'}\n                </p>\n                <p className=\"text-amber-400 font-medium mt-1\">\n                  Abogado a Cargo: {selectedCase.assignedLawyer}\n                </p>\n              </div>\n\n              <div>\n                <span className=\"text-[10px] uppercase font-bold text-slate-400 block mb-1\">\n                  Contraparte\n                </span>\n                <p className=\"font-semibold text-slate-200\">{selectedCase.opposingParty}</p>\n                {selectedCase.opposingLawyer && (\n                  <p className=\"text-slate-400\">Abogado: {selectedCase.opposingLawyer}</p>\n                )}\n                {selectedCase.amount ? (\n                  <p className=\"text-emerald-400 font-mono-legal mt-1\">\n                    Cuant\303\255a: {formatCurrency(selectedCase.amount, selectedCase.currency)}\n                  </p>\n                ) : (\n                  <p className=\"text-slate-500 mt-1\">Cuant\303\255a: Indeterminada / Sin cuant\303\255a</p>\n                )}\n              </div>\n            </div>\n\n            {/* Pesta\303\261as del Expediente */}\n            <div className=\"border-b border-slate-800 flex items-center gap-1 text-xs font-semibold\">\n              <button\n                onClick={() => setDetailTab(\'timeline\')}\n                className={`py-2 px-3 border-b-2 transition-colors cursor-pointer ${\n                  detailTab === \'timeline\'\n                    ? \'border-amber-400 text-amber-300\'\n                    : \'border-transparent text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                Bit\303\241cora Procesal ({selectedCase.timeline.length})\n              </button>\n              <button\n                onClick={() => setDetailTab(\'deadlines\')}\n                className={`py-2 px-3 border-b-2 transition-colors cursor-pointer ${\n                  detailTab === \'deadlines\'\n                    ? \'border-amber-400 text-amber-300\'\n                    : \'border-transparent text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                Plazos ({deadlines.filter((d) => d.caseId === selectedCase.id).length})\n              </button>\n              <button\n                onClick={() => setDetailTab(\'hearings\')}\n                className={`py-2 px-3 border-b-2 transition-colors cursor-pointer ${\n                  detailTab === \'hearings\'\n                    ? \'border-amber-400 text-amber-300\'\n                    : \'border-transparent text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                Audiencias ({hearings.filter((h) => h.caseId === selectedCase.id).length})\n              </button>\n              <button\n                onClick={() => setDetailTab(\'fees\')}\n                className={`py-2 px-3 border-b-2 transition-colors cursor-pointer ${\n                  detailTab === \'fees\'\n                    ? \'border-amber-400 text-amber-300\'\n                    : \'border-transparent text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                Honorarios & Cuotas\n              </button>\n            </div>\n\n            {/* Contenido Pesta\303\261a 1: Bit\303\241cora Procesal */}\n            {detailTab === \'timeline\' && (\n              <div className=\"space-y-4\">\n                {/* Formulario r\303\241pido para nueva actuaci\303\263n */}\n                <form\n                  onSubmit={handleAddTimelineEvent}\n                  className=\"p-3 bg-slate-950/70 border border-slate-800 rounded-xl space-y-2\"\n                >\n                  <span className=\"text-xs font-semibold text-slate-300 block\">\n                    + Registrar Actuaci\303\263n Judicial / Escrito\n                  </span>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <input\n                      type=\"text\"\n                      value={newActionTitle}\n                      onChange={(e) => setNewActionTitle(e.target.value)}\n                      placeholder=\"T\303\255tulo: ej. Acompa\303\261a documentos o Resoluci\303\263n traslado\"\n                      className=\"sm:col-span-2 bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400\"\n                      required\n                    />\n                    <select\n                      value={newActionActor}\n                      onChange={(e) => setNewActionActor(e.target.value)}\n                      className=\"bg-slate-800 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-slate-100\"\n                    >\n                      <option value=\"Abogado BDCM\">Abogado BDCM</option>\n                      <option value=\"Tribunal\">Tribunal / Juez</option>\n                      <option value=\"Contraparte\">Contraparte</option>\n                      <option value=\"Receptor Judicial\">Receptor Judicial</option>\n                    </select>\n                  </div>\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"text\"\n                      value={newActionDesc}\n                      onChange={(e) => setNewActionDesc(e.target.value)}\n                      placeholder=\"Detalles de la resoluci\303\263n, foja o s\303\255ntesis...\"\n                      className=\"flex-1 bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400\"\n                    />\n                    <button\n                      type=\"submit\"\n                      className=\"px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-lg transition-colors flex items-center gap-1 cursor-pointer\"\n                    >\n                      <Send className=\"w-3 h-3\" />\n                      Guardar\n                    </button>\n                  </div>\n                </form>\n\n                {/* Lista de Eventos */}\n                <div className=\"space-y-3 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-slate-800\">\n                  {selectedCase.timeline.map((evt) => (\n                    <div key={evt.id} className=\"relative flex items-start gap-3 pl-1\">\n                      <div className=\"w-6 h-6 rounded-full bg-slate-900 border-2 border-amber-500 flex items-center justify-center shrink-0 z-10\">\n                        <div className=\"w-2 h-2 rounded-full bg-amber-400\"></div>\n                      </div>\n                      <div className=\"flex-1 bg-slate-950/60 border border-slate-800/80 rounded-xl p-3 text-xs space-y-1\">\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-slate-200\">{evt.title}</span>\n                          <span className=\"font-mono-legal text-[10px] text-slate-400\">\n                            {formatDateCL(evt.date)}\n                          </span>\n                        </div>\n                        <p className=\"text-slate-400 leading-relaxed\">{evt.description}</p>\n                        <div className=\"text-[10px] text-amber-400/80 font-medium\">\n                          Actu\303\263: {evt.actor}\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {/* Contenido Pesta\303\261a 2: Plazos */}\n            {detailTab === \'deadlines\' && (\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs text-slate-400\">Plazos procesales vinculados a esta causa</span>\n                  <button\n                    onClick={() => onOpenNewDeadline(selectedCase.id)}\n                    className=\"text-xs text-amber-400 hover:text-amber-300 font-semibold cursor-pointer\"\n                  >\n                    + Agregar Plazo Fatal\n                  </button>\n                </div>\n\n                {deadlines.filter((d) => d.caseId === selectedCase.id).length === 0 ? (\n                  <p className=\"text-xs text-slate-500 py-4 text-center\">No hay plazos registrados para esta causa.</p>\n                ) : (\n                  deadlines\n                    .filter((d) => d.caseId === selectedCase.id)\n                    .map((dl) => (\n                      <div\n                        key={dl.id}\n                        className=\"p-3 bg-slate-950/60 border border-slate-800 rounded-xl flex items-center justify-between gap-3 text-xs\"\n                      >\n                        <div>\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"font-bold text-slate-100\">{dl.title}</span>\n                            {dl.isFatal && (\n                              <span className=\"px-1.5 py-0.2 rounded-sm bg-rose-500/20 text-rose-300 text-[10px] font-bold\">\n                                FATAL\n                              </span>\n                            )}\n                          </div>\n                          <p className=\"text-slate-400 font-mono-legal mt-0.5\">\n                            Vence: {formatDateCL(dl.deadlineDate)} ({dl.deadlineTime}) \342\200\242 {dl.daysType}\n                          </p>\n                        </div>\n\n                        <button\n                          onClick={() => toggleDeadlineStatus(dl.id)}\n                          className={`px-2 py-1 rounded-md text-[11px] font-semibold transition-colors ${\n                            dl.status === \'CUMPLIDO\'\n                              ? \'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30\'\n                              : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n                          }`}\n                        >\n                          {dl.status === \'CUMPLIDO\' ? \'\342\234\223 Cumplido\' : \'Pendiente\'}\n                        </button>\n                      </div>\n                    ))\n                )}\n              </div>\n            )}\n\n            {/* Contenido Pesta\303\261a 3: Audiencias */}\n            {detailTab === \'hearings\' && (\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs text-slate-400\">Audiencias fijadas por el tribunal</span>\n                  <button\n                    onClick={() => onOpenNewHearing(selectedCase.id)}\n                    className=\"text-xs text-amber-400 hover:text-amber-300 font-semibold cursor-pointer\"\n                  >\n                    + Agendar Audiencia\n                  </button>\n                </div>\n\n                {hearings.filter((h) => h.caseId === selectedCase.id).length === 0 ? (\n                  <p className=\"text-xs text-slate-500 py-4 text-center\">No hay audiencias agendadas.</p>\n                ) : (\n                  hearings\n                    .filter((h) => h.caseId === selectedCase.id)\n                    .map((hr) => (\n                      <div\n                        key={hr.id}\n                        className=\"p-3 bg-slate-950/60 border border-slate-800 rounded-xl space-y-1 text-xs\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-slate-100\">{hr.title}</span>\n                          <span className=\"text-blue-400 font-mono-legal\">\n                            {formatDateCL(hr.date)} {hr.startTime} hrs\n                          </span>\n                        </div>\n                        <p className=\"text-slate-400\">Modalidad: {hr.modality} \342\200\242 Sala/Link: {hr.courtRoomOrLink}</p>\n                      </div>\n                    ))\n                )}\n              </div>\n            )}\n\n            {/* Contenido Pesta\303\261a 4: Honorarios */}\n            {detailTab === \'fees\' && (\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs text-slate-400\">Convenios y cuotas de honorarios</span>\n                  <button\n                    onClick={() => onOpenNewFee(selectedCase.id)}\n                    className=\"text-xs text-amber-400 hover:text-amber-300 font-semibold cursor-pointer\"\n                  >\n                    + Pactar Honorarios\n                  </button>\n                </div>\n\n                {installments.filter((i) => i.caseId === selectedCase.id).length === 0 ? (\n                  <p className=\"text-xs text-slate-500 py-4 text-center\">No hay cuotas registradas para esta causa.</p>\n                ) : (\n                  installments\n                    .filter((i) => i.caseId === selectedCase.id)\n                    .map((inst) => (\n                      <div\n                        key={inst.id}\n                        className=\"p-3 bg-slate-950/60 border border-slate-800 rounded-xl flex items-center justify-between text-xs\"\n                      >\n                        <div>\n                          <span className=\"font-semibold text-slate-200\">\n                            Cuota {inst.installmentNumber} / {inst.totalInstallments}\n                          </span>\n                          <p className=\"text-slate-400 font-mono-legal\">\n                            Vencimiento: {formatDateCL(inst.dueDate)}\n                          </p>\n                        </div>\n                        <div className=\"text-right\">\n                          <div className=\"font-bold font-mono-legal text-emerald-400\">\n                            {formatCurrency(inst.amount, inst.currency)}\n                          </div>\n                          <span\n                            className={`text-[10px] font-semibold uppercase ${\n                              inst.status === \'PAGADA\'\n                                ? \'text-emerald-400\'\n                                : inst.status === \'ATRASADA\'\n                                ? \'text-rose-400\'\n                                : \'text-slate-400\'\n                            }`}\n                          >\n                            {inst.status}\n                          </span>\n                        </div>\n                      </div>\n                    ))\n                )}\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
