y: \'CLP\',\\n    amount: 16500000,\\n    pjudLink: \'https://ojv.pjud.cl/kpitec-ojv-web/login\',\\n    notes: \'Demanda de despido improcedente con tutela laboral por vulneraci\303\263n del derecho a la honra y cobro de indemnizaciones sustitutivas.\',\\n    createdAt: \'2024-03-22\',\\n    updatedAt: \'2024-11-03\',\\n    timeline: [\\n      {\\n        id: \'t-4\',\\n        date: \'2024-03-22\',\\n        title: \'Interposici\303\263n de Demanda Laboral\',\\n        description: \'Se ingresa libelo laboral ante los Juzgados del Trabajo de Santiago.\',\\n        actor: \'Abogado BDCM\',\\n      },\\n      {\\n        id: \'t-5\',\\n        date: \'2024-04-05\',\\n        title: \'Fijaci\303\263n de Audiencia Preparatoria\',\\n        description: \'El tribunal cita a las partes a audiencia preparatoria telem\303\241tica por Zoom PJUD.\',\\n        actor: \'Tribunal\',\\n      },\\n    ],\\n  },\\n  {\\n    id: \'case-3\',\\n    rol: \'RUC 2400198273-1 / RIT 3421-2024\',\\n    caratula: \'Ministerio P\303\272blico c/ Silva\',\\n    court: \'7\302\260 Juzgado de Garant\303\255a de Santiago\',\\n    courtType: \'GARANTIA\',\\n    subject: \'Penal\',\\n    clientId: \'cli-5\',\\n    clientRole: \'IMPUTADO\',\\n    opposingParty: \'Fiscal\303\255a Centro Norte / Querellante Grupo Renta S.A.\',\\n    opposingLawyer: \'Fiscal Patricio Cooper / Andr\303\251s Err\303\241zuriz\',\\n    status: \'TRAMITACION\',\\n    assignedLawyer: \'Enrique Blanco Zambrano\',\\n    currency: \'UF\',\\n    amount: 150,\\n    pjudLink: \'https://ojv.pjud.cl/kpitec-ojv-web/login\',\\n    notes: \'Defensa penal privada. Querella infundada por presunto fraude contractual mercantil.\',\\n    createdAt: \'2024-08-15\',\\n    updatedAt: \'2024-11-01\',\\n    timeline: [\\n      {\\n        id: \'t-6\',\\n        date: \'2024-08-15\',\\n        title: \'Asunci\303\263n de Patrocinio y Poder\',\\n        description: \'Se presenta escrito de patrocinio y poder con firma electr\303\263nica avanzada.\',\\n        actor: \'Abogado BDCM\',\\n      },\\n      {\\n        id: \'t-7\',\\n        date: \'2024-10-18\',\\n        title: \'Petici\303\263n de Copia de Carpeta Investigativa\',\\n        description: \'Se solicita acceso completo a las diligencias reservadas del Ministerio P\303\272blico.\',\\n        actor: \'Abogado BDCM\',\\n      },\\n    ],\\n  },\\n  {\\n    id: \'case-4\',\\n    rol: \'F-1204-2024\',\\n    caratula: \'Mu\303\261oz c/ Valenzuela\',\\n    court: \'Juzgado de Familia de San Miguel\',\\n    courtType: \'FAMILIA\',\\n    subject: \'Familia\',\\n    clientId: \'cli-4\',\\n    clientRole: \'DEMANDANTE\',\\n    opposingParty: \'Crist\303\263bal Valenzuela Hurtado\',\\n    opposingLawyer: \'Beatriz Matte (Defensor\303\255a Local)\',\\n    status: \'TRAMITACION\',\\n    assignedLawyer: \'Rodrigo Donoso Castro\',\\n    currency: \'CLP\',\\n    amount: 0,\\n    pjudLink: \'https://ojv.pjud.cl/kpitec-ojv-web/login\',\\n    notes: \'Cuidado personal y pensi\303\263n de alimentos provisoria fijada en 1,8 UTM.\',\\n    createdAt: \'2024-06-10\',\\n    updatedAt: \'2024-10-28\',\\n    timeline: [\\n      {\\n        id: \'t-8\',\\n        date: \'2024-06-10\',\\n        title: \'Demanda de Cuidado Personal\',\\n        description: \'Presentada ante Juzgado de Familia de San Miguel tras mediaci\303\263n frustrada.\',\\n        actor: \'Abogado BDCM\',\\n      },\\n    ],\\n  },\\n  {\\n    id: \'case-5\',\\n    rol: \'ROL 1823-2024\',\\n    caratula: \'Distribuidora Austral c/ Seremi de Salud RM\',\\n    court: \'Corte de Apelaciones de Santiago\',\\n    courtType: \'CORTE_APELACIONES\',\\n    subject: \'Constitucional\',\\n    clientId: \'cli-3\',\\n    clientRole: \'RECURRENTE\',\\n    opposingParty: \'Secretar\303\255a Regional Ministerial de Salud RM\',\\n    opposingLawyer: \'Abogado del Consejo de Defensa del Estado (CDE)\',\\n    status: \'TRAMITACION\',\\n    assignedLawyer: \'Carolina Morales Vidal\',\\n    currency: \'CLP\',\\n    amount: 25000000,\\n    pjudLink: \'https://ojv.pjud.cl/kpitec-ojv-web/login\',\\n    notes: \'Recurso de Protecci\303\263n por clausura arbitraria de bodega de almacenamiento.\',\\n    createdAt: \'2024-05-02\',\\n    updatedAt: \'2024-11-02\',\\n    timeline: [\\n      {\\n        id: \'t-9\',\\n        date: \'2024-05-02\',\\n        title: \'Ingreso de Recurso de Protecci\303\263n\',\\n        description: \'Interpuesto con solicitud de orden de no innovar (ONI).\',\\n        actor: \'Abogado BDCM\',\\n      },\\n      {\\n        id: \'t-10\',\\n        date: \'2024-05-08\',\\n        title: \'Acogida Orden de No Innovar (ONI)\',\\n        description: \'La Corte acoge la ONI y permite el funcionamiento provisorio de la distribuidora.\',\\n        actor: \'Tribunal\',\\n      },\\n    ],\\n  },\\n];\\n\\n// Helper para calcular fechas relativas a hoy\\nconst today = new Date();\\nconst formatDate = (offsetDays: number) => {\\n  const d = new Date(today);\\n  d.setDate(d.getDate() + offsetDays);\\n  return d.toISOString().split(\'T\')[0];\\n};\\n\\nexport const INITIAL_DEADLINES: CaseDeadline[] = [\\n  {\\n    id: \'dl-1\',\\n    caseId: \'case-1\',\\n    title: \'Plazo Fatal: Evacuar traslado sobre excepci\303\263n de incompetencia\',\\n    deadlineDate: formatDate(1), // Ma\303\261ana\\n    deadlineTime: \'23:59\',\\n    isFatal: true,\\n    daysType: \'HABILES_CIVIL\',\\n    daysCount: 3,\\n    status: \'PENDIENTE\',\\n    priority: \'ALTA\',\\n    alertDaysBefore: 2,\\n    notes: \'Art. 308 CPC chileno. Debe solicitarse rechazo con costas por pr\303\263rroga t\303\241cita de competencia.\',\\n    syncedToCalendar: true,\\n    createdAt: \'2024-11-01\',\\n  },\\n  {\\n    id: \'dl-2\',\\n    caseId: \'case-2\',\\n    title: \'Acompa\303\261ar minuta de testigos y prueba documental laboral\',\\n    deadlineDate: formatDate(3), // En 3 d\303\255as\\n    deadlineTime: \'12:00\',\\n    isFatal: true,\\n    daysType: \'HABILES_LABORAL\',\\n    daysCount: 5,\\n    status: \'PENDIENTE\',\\n    priority: \'ALTA\',\\n    alertDaysBefore: 3,\\n    notes: \'Art. 453 C\303\263digo del Trabajo. Individualizar con nombre, profesi\303\263n y domicilio a 3 testigos.\',\\n    syncedToCalendar: false,\\n    createdAt: \'2024-11-02\',\\n  },\\n  {\\n    id: \'dl-3\',\\n    caseId: \'case-3\',\\n    title: \'Presentar solicitud de sobreseimiento definitivo / no perseverar\',\\n    deadlineDate: formatDate(7), // En 7 d\303\255as\\n    deadlineTime: \'23:59\',\\n    isFatal: false,\\n    daysType: \'HABILES_LABORAL\',\\n    daysCount: 10,\\n    status: \'PENDIENTE\',\\n    priority: \'MEDIA\',\\n    alertDaysBefore: 2,\\n    notes: \'Acompa\303\261ar informes periciales contables de parte que acreditan inexistencia de dolo.\',\\n    syncedToCalendar: false,\\n    createdAt: \'2024-10-25\',\\n  },\\n  {\\n    id: \'dl-4\',\\n    caseId: \'case-5\',\\n    title: \'Alegar sobre la cuenta / Anotarse en tabla de la Corte\',\\n    deadlineDate: formatDate(2), // En 2 d\303\255as\\n    deadlineTime: \'08:30\',\\n    isFatal: true,\\n    daysType: \'HABILES_CIVIL\',\\n    daysCount: 1,\\n    status: \'PENDIENTE\',\\n    priority: \'ALTA\',\\n    alertDaysBefore: 1,\\n    notes: \'Inscribirse telem\303\241ticamente antes de las 08:30 hrs para comparecer en la 3\302\252 Sala de la Corte.\',\\n    syncedToCalendar: true,\\n    createdAt: \'2024-11-03\',\\n  },\\n  {\\n    id: \'dl-5\',\\n    caseId: \'case-4\',\\n    title: \'Acompa\303\261ar liquidaci\303\263n de pensiones del BancoEstado\',\\n    deadlineDate: formatDate(-2), // Hace 2 d\303\255as\\n    deadlineTime: \'14:00\',\\n    isFatal: false,\\n    daysType: \'CORRIDOS\',\\n    daysCount: 5,\\n    status: \'CUMPLIDO\',\\n    priority: \'MEDIA\',\\n    alertDaysBefore: 1,\\n    notes: \'Escrito ingresado satisfactoriamente con certificado de dep\303\263sitos adjunto.\',\\n    syncedToCalendar: true,\\n    createdAt: \'2024-10-28\',\\n  },\\n];\\n\\nexport const INITIAL_HEARINGS: Hearing[] = [\\n  {\\n    id: \'hr-1\',\\n    caseId: \'case-2\',\\n    title: \'Audiencia Preparatoria Laboral - Pavez c/ Retail\',\\n    type: \'PREPARATORIA\',\\n    date: formatDate(4),\\n    startTime: \'09:30\',\\n    endTime: \'11:00\',\\n    modality: \'TELEMATICA_ZOOM\',\\n    courtRoomOrLink: \'https://pjud-cl.zoom.us/j/98412039148?pwd=bdcm\',\\n    attendees: \'Rodrigo Donoso (BDCM), Manuel Pavez (Cliente), Abogada de Contraparte, Juez Laboral\',\\n    notes: \'Llevar preparada propuesta de bases de conciliaci\303\263n por un piso de $ 9.500.000.\',\\n    status: \'PROGRAMADA\',\\n    syncedToCalendar: true,\\n  },\\n  {\\n    id: \'hr-2\',\\n    caseId: \'case-3\',\\n    title: \'Audiencia de Formalizaci\303\263n y Medidas Cautelares\',\\n    type: \'MEDIDAS_CAUTELARES\',\\n    date: formatDate(6),\\n    startTime: \'11:30\',\\n    endTime: \'13:00\',\\n    modality: \'PRESENCIAL\',\\n    courtRoomOrLink: \'Centro de Justicia de Santiago, Edificio C, Sala 402\',\\n    attendees: \'Enrique Blanco (BDCM), Jorge Silva (Imputado), Fiscal Cooper\',\\n    notes: \'Oponerse tajantemente a la prisi\303\263n preventiva solicitando arraigo nacional y firma mensual.\',\\n    status: \'PROGRAMADA\',\\n    syncedToCalendar: true,\\n  },\\n  {\\n    id: \'hr-3\',\\n    caseId: \'case-5\',\\n    title: \'Alegatos Recurso de Protecci\303\263n - 3\302\252 Sala Corte de Apelaciones\',\\n    type: \'ALEGATOS\',\\n    date: formatDate(8),\\n    startTime: \'10:00\',\\n    endTime: \'10:45\',\\n    modality: \'TELEMATICA_ZOOM\',\\n    courtRoomOrLink: \'https://pjud-cl.zoom.us/j/91238472911\',\\n    attendees: \'Carolina Morales (BDCM), Abogado CDE, Ministros de Corte\',\\n    notes: \'Tiempo anunciado de alegato: 15 minutos. Enfatizar arbitrariedad del acto administrativo.\',\\n    status: \'PROGRAMADA\',\\n    syncedToCalendar: false,\\n  },\\n  {\\n    id: \'hr-4\',\\n    title: \'Reuni\303\263n de Directorio BDCM - Planificaci\303\263n Estrat\303\251gica Semanal\',\\n    type: \'REUNION_CLIENTE\',\\n    date: formatDate(1),\\n    startTime: \'16:00\',\\n    endTime: \'17:30\',\\n    modality: \'GOOGLE_MEET\',\\n    courtRoomOrLink: \'https://meet.google.com/bdc-mabo-gad\',\\n    attendees: \'Enrique Blanco, Rodrigo Donoso, Carolina Morales\',\\n    notes: \'Revisi\303\263n de plazos fatales de la semana, flujo de cobranzas y asignaci\303\263n de nuevas causas.\',\\n    status: \'PROGRAMADA\',\\n    syncedToCalendar: false,\\n  },\\n];\\n\\nexport const INITIAL_FEE_AGREEMENTS: FeeAgreement[] = [\\n  {\\n    id: \'fee-1\',\\n    caseId: \'case-1\',\\n    clientId: \'cli-1\',\\n    feeType: \'MIXTO\',\\n    currency: \'CLP\',\\n    totalAmount: 4500000,\\n    installmentsCount: 3,\\n    notes: \'Honorario fijo de $ 4.500.000 pagadero en 3 cuotas mensuales, m\303\241s cuota litis de 10% sobre suma recuperada.\',\\n    createdAt: \'2024-02-05\',\\n  },\\n  {\\n    id: \'fee-2\',\\n    caseId: \'case-2\',\\n    clientId: \'cli-2\',\\n    feeType: \'CUOTA_LITIS\',\\n    currency: \'CLP\',\\n    totalAmount: 1800000,\\n    installmentsCount: 2,\\n    notes: \'Gasto inicial de tramitaci\303\263n $ 600.000 + cuota litis del 20% al \303\251xito del juicio.\',\\n    createdAt: \'2024-03-25\',\\n  },\\n  {\\n    id: \'fee-3\',\\n    caseId: \'case-3\',\\n    clientId: \'cli-5\',\\n    feeType: \'FIJO\',\\n    currency: \'UF\',\\n    totalAmount: 120,\\n    installmentsCount: 4,\\n    notes: \'Honorario integral de defensa penal etapa de investigaci\303\263n formalizada: 120 UF en 4 cuotas de 30 UF.\',\\n    createdAt: \'2024-08-18\',\\n  },\\n  {\\n    id: \'fee-4\',\\n    caseId: \'case-5\',\\n    clientId: \'cli-3\',\\n    feeType: \'FIJO\',\\n    currency: \'CLP\',\\n    totalAmount: 3200000,\\n    installmentsCount: 2,\\n    notes: \'Patrocinio en Recurso de Protecci\303\263n: 2 cuotas de $ 1.600.000.\',\\n    createdAt: \'2024-05-05\',\\n  },\\n];\\n\\nexport const INITIAL_INSTALLMENTS: FeeInstallment[] = [\\n  // Causa 1: Inversiones del Sur ($4.500.000 en 3 cuotas)\\n  {\\n    id: \'inst-1\',\\n    feeAgreementId: \'fee-1\',\\n    caseId: \'case-1\',\\n    clientId: \'cli-1\',\\n    installmentNumber: 1,\\n    totalInstallments: 3,\\n    dueDate: \'2024-03-05\',\\n    amount: 1500000,\\n    currency: \'CLP\',\\n    status: \'PAGADA\',\\n    paidDate: \'2024-03-04\',\\n    paymentMethod: \'TRANSFERENCIA\',\\n    receiptFolio: \'BHE-842\',\\n    notes: \'Transferencia Banco de Chile recibida.\',\\n  },\\n  {\\n    id: \'inst-2\',\\n    feeAgreementId: \'fee-1\',\\n    caseId: \'case-1\',\\n    clientId: \'cli-1\',\\n    installmentNumber: 2,\\n    totalInstallments: 3,\\n    dueDate: formatDate(-15),\\n    amount: 1500000,\\n    currency: \'CLP\',\\n    status: \'ATRASADA\',\\n    notes: \'Se envi\303\263 aviso cordial al departamento de finanzas de Inversiones del Sur.\',\\n  },\\n  {\\n    id: \'inst-3\',\\n    feeAgreementId: \'fee-1\',\\n    caseId: \'case-1\',\\n    clientId: \'cli-1\',\\n    installmentNumber: 3,\\n    totalInstallments: 3,\\n    dueDate: formatDate(15),\\n    amount: 1500000,\\n    currency: \'CLP\',\\n    status: \'PENDIENTE\',\\n    notes: \'Cuota final sujeta a t\303\251rmino del probatorio.\',\\n  },\\n\\n  // Causa 2: Manuel Pavez ($1.800.000 en 2 cuotas)\\n  {\\n    id: \'inst-4\',\\n    feeAgreementId: \'fee-2\',\\n    caseId: \'case-2\',\\n    clientId: \'cli-2\',\\n    installmentNumber: 1,\\n    totalInstallments: 2,\\n    dueDate: \'2024-04-10\',\\n    amount: 900000,\\n    currency: \'CLP\',\\n    status: \'PAGADA\',\\n    paidDate: \'2024-04-09\',\\n    paymentMethod: \'TRANSFERENCIA\',\\n    receiptFolio: \'BHE-870\',\\n    notes: \'Pago inicial pactado.\',\\n  },\\n  {\\n    id: \'inst-5\',\\n    feeAgreementId: \'fee-2\',\\n    caseId: \'case-2\',\\n    clientId: \'cli-2\',\\n    installmentNumber: 2,\\n    totalInstallments: 2,\\n    dueDate: formatDate(5),\\n    amount: 900000,\\n    currency: \'CLP\',\\n    status: \'PENDIENTE\',\\n    notes: \'Vence previo a la audiencia preparatoria.\',\\n  },\\n\\n  // Causa 3: Jorge Silva (Defensa Penal 120 UF en 4 cuotas de 30 UF)\\n  {\\n    id: \'inst-6\',\\n    feeAgreementId: \'fee-3\',\\n    caseId: \'case-3\',\\n    clientId: \'cli-5\',\\n    installmentNumber: 1,\\n    totalInstallments: 4,\\n    dueDate: \'2024-09-01\',\\n    amount: 30,\\n    currency: \'UF\',\\n    status: \'PAGADA\',\\n    paidDate: \'2024-09-01\',\\n    paymentMethod: \'TRANSFERENCIA\',\\n    receiptFolio: \'BHE-910\',\\n    notes: \'Pago valor UF observado del d\303\255a.\',\\n  },\\n  {\\n    id: \'inst-7\',\\n    feeAgreementId: \'fee-3\',\\n    caseId: \'case-3\',\\n    clientId: \'cli-5\',\\n    installmentNumber: 2,\\n    totalInstallments: 4,\\n    dueDate: formatDate(-5),\\n    amount: 30,\\n    currency: \'UF\',\\n    status: \'ATRASADA\',\\n    notes: \'Pendiente de confirmaci\303\263n bancaria.\',\\n  },\\n  {\\n    id: \'inst-8\',\\n    feeAgreementId: \'fee-3\',\\n    caseId: \'case-3\',\\n    clientId: \'cli-5\',\\n    installmentNumber: 3,\\n    totalInstallments: 4,\\n    dueDate: formatDate(25),\\n    amount: 30,\\n    currency: \'UF\',\\n    status: \'PENDIENTE\',\\n  },\\n  {\\n    id: \'inst-9\',\\n    feeAgreementId: \'fee-3\',\\n    caseId: \'case-3\',\\n    clientId: \'cli-5\',\\n    installmentNumber: 4,\\n    totalInstallments: 4,\\n    dueDate: formatDate(55),\\n    amount: 30,\\n    currency: \'UF\',\\n    status: \'PENDIENTE\',\\n  },\\n\\n  // Causa 5: Distribuidora Austral ($3.200.000)\\n  {\\n    id: \'inst-10\',\\n    feeAgreementId: \'fee-4\',\\n    caseId: \'case-5\',\\n    clientId: \'cli-3\',\\n    installmentNumber: 1,\\n    totalInstallments: 2,\\n    dueDate: \'2024-05-15\',\\n    amount: 1600000,\\n    currency: \'CLP\',\\n    status: \'PAGADA\',\\n    paidDate: \'2024-05-14\',\\n    paymentMethod: \'TRANSFERENCIA\',\\n    receiptFolio: \'FACT-104\',\\n  },\\n  {\\n    id: \'inst-11\',\\n    feeAgreementId: \'fee-4\',\\n    caseId: \'case-5\',\\n    clientId: \'cli-3\',\\n    installmentNumber: 2,\\n    totalInstallments: 2,\\n    dueDate: formatDate(10),\\n    amount: 1600000,\\n    currency: \'CLP\',\\n    status: \'PENDIENTE\',\\n    notes: \'Segunda cuota condicionada a alegatos en la Corte.\',\\n  },\\n];\\n\",\"Description\":\"Datos iniciales realistas para el estudio BDCM Abogados en Chile con causas, clientes, plazos fatales, audiencias y cuotas de honorarios\",\"Overwrite\":true,\"TargetFile\":\"/src/data/initialData.ts\",\"toolAction\":\"Creando datos iniciales de BDCM Abogados\",\"toolSummary\":\"Crear initialData.ts\"}"
