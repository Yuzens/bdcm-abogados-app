  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport {\n  Calendar,\n  Plus,\n  Video,\n  MapPin,\n  Clock,\n  ExternalLink,\n  Download,\n  Trash2,\n  Users,\n  CheckCircle,\n  AlertCircle,\n  Building2,\n} from \'lucide-react\';\nimport {\n  formatDateCL,\n  buildGoogleCalendarUrl,\n  downloadIcsFile,\n} from \'../../utils/chileanLegal\';\n\ninterface Props {\n  onOpenNewHearing: () => void;\n}\n\nexport const HearingsView: React.FC<Props> = ({ onOpenNewHearing }) => {\n  const {\n    hearings,\n    cases,\n    deleteHearing,\n    syncHearingToCalendar,\n    googleAccessToken,\n    setSelectedCaseId,\n    setActiveTab,\n  } = useLegal();\n\n  const [syncingId, setSyncingId] = useState<string | null>(null);\n\n  const sortedHearings = [...hearings].sort((a, b) =>\n    `${a.date} ${a.startTime}`.localeCompare(`${b.date} ${b.startTime}`)\n  );\n\n  const handleSyncGoogle = async (hearingId: string) => {\n    setSyncingId(hearingId);\n    await syncHearingToCalendar(hearingId);\n    setSyncingId(null);\n  };\n\n  const handleDownloadIcs = (hr: any, c: any) => {\n    downloadIcsFile({\n      filename: `Audiencia_BDCM_${hr.id}`,\n      title: `[AUDIENCIA] ${hr.title}`,\n      description: `Audiencia Judicial:\\nCausa: ${c?.rol || \'\'} - ${c?.caratula || \'\'}\\nTribunal: ${c?.court || \'\'}\\nModalidad: ${hr.modality}\\nConexi\303\263n: ${hr.courtRoomOrLink}\\nComparecen: ${hr.attendees}\\nBDCM Abogados`,\n      startDate: hr.date,\n      startTime: hr.startTime || \'09:00\',\n      endTime: hr.endTime || \'10:30\',\n      location: hr.courtRoomOrLink,\n    });\n  };\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold font-legal-heading text-slate-100 flex items-center gap-2.5\">\n            <Calendar className=\"w-6 h-6 text-blue-400\" />\n            Audiencias & Agenda Judicial\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Audiencias telem\303\241ticas en Zoom PJUD, alegatos en Corte y reuniones de coordinaci\303\263n en BDCM Abogados\n          </p>\n        </div>\n\n        <button\n          onClick={onOpenNewHearing}\n          className=\"px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-400 hover:to-blue-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-blue-500/20 transition-all flex items-center gap-2 self-start cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          Agendar Audiencia\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {sortedHearings.map((hr) => {\n          const c = cases.find((item) => item.id === hr.caseId);\n          const isZoom = hr.modality === \'TELEMATICA_ZOOM\';\n          const isMeet = hr.modality === \'GOOGLE_MEET\';\n          const isPresencial = hr.modality === \'PRESENCIAL\';\n\n          const googleDirectUrl = buildGoogleCalendarUrl({\n            title: `[AUDIENCIA BDCM] ${hr.title}`,\n            details: `Causa: ${c?.rol || \'\'} - ${c?.caratula || \'\'}\\nTribunal: ${c?.court || \'\'}\\nModalidad: ${hr.modality}\\nConexi\303\263n: ${hr.courtRoomOrLink}\\nComparecen: ${hr.attendees}\\nNotas: ${hr.notes || \'\'}`,\n            location: hr.courtRoomOrLink,\n            startDate: hr.date,\n            startTime: hr.startTime,\n            endTime: hr.endTime,\n          });\n\n          return (\n            <div\n              key={hr.id}\n              className=\"bg-slate-900/80 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 space-y-4 shadow-sm transition-all flex flex-col justify-between\"\n            >\n              <div className=\"space-y-3\">\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase bg-blue-500/10 text-blue-300 border border-blue-500/20\">\n                      {hr.type}\n                    </span>\n                    <span className=\"text-xs font-mono-legal text-slate-300 font-semibold\">\n                      {formatDateCL(hr.date)}\n                    </span>\n                  </div>\n\n                  <span className=\"text-xs font-mono-legal text-amber-400 font-bold\">\n                    {hr.startTime} - {hr.endTime} hrs\n                  </span>\n                </div>\n\n                <div>\n                  <h3 className=\"text-sm font-bold text-slate-100\">{hr.title}</h3>\n                  {c && (\n                    <button\n                      onClick={() => {\n                        setSelectedCaseId(c.id);\n                        setActiveTab(\'cases\');\n                      }}\n                      className=\"text-xs font-mono-legal text-amber-400 hover:underline mt-1 block\"\n                    >\n                      {c.rol} \342\200\242 {c.court}\n                    </button>\n                  )}\n                </div>\n\n                {/* Modalidad y Enlace */}\n                <div className=\"p-3 bg-slate-950/60 border border-slate-800 rounded-xl space-y-2 text-xs\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-slate-400 flex items-center gap-1.5\">\n                      {isZoom || isMeet ? (\n                        <Video className=\"w-3.5 h-3.5 text-blue-400\" />\n                      ) : (\n                        <MapPin className=\"w-3.5 h-3.5 text-amber-400\" />\n                      )}\n                      {isZoom\n                        ? \'Telem\303\241tica (Zoom PJUD)\'\n                        : isMeet\n                        ? \'Google Meet\'\n                        : isPresencial\n                        ? \'Presencial en Tribunal\'\n                        : \'Otra\'}\n                    </span>\n\n                    {(isZoom || isMeet) && hr.courtRoomOrLink && (\n                      <a\n                        href={hr.courtRoomOrLink}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"px-2 py-1 bg-blue-500/20 hover:bg-blue-500/30 text-blue-300 font-semibold rounded-md flex items-center gap-1 transition-colors\"\n                      >\n                        <Video className=\"w-3 h-3\" />\n                        Ingresar a Sala\n                      </a>\n                    )}\n                  </div>\n\n                  <p className=\"text-[11px] text-slate-300 truncate font-mono-legal\">\n                    {hr.courtRoomOrLink}\n                  </p>\n                </div>\n\n                <div className=\"text-xs text-slate-400 space-y-1\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <Users className=\"w-3.5 h-3.5 text-slate-500\" />\n                    <span>Comparecen: {hr.attendees}</span>\n                  </div>\n                  {hr.notes && (\n                    <p className=\"text-[11px] text-slate-400 italic\">\n                      \"{hr.notes}\"\n                    </p>\n                  )}\n                </div>\n              </div>\n\n              {/* Acciones y Sincronizaci\303\263n */}\n              <div className=\"pt-3 border-t border-slate-800 flex items-center justify-between text-xs\">\n                <div>\n                  {hr.syncedToCalendar ? (\n                    <span className=\"text-[11px] text-emerald-400 flex items-center gap-1\">\n                      <CheckCircle className=\"w-3.5 h-3.5\" />\n                      Sincronizado a Google Cal\n                    </span>\n                  ) : (\n                    <span className=\"text-[11px] text-slate-500\">No sincronizado</span>\n                  )}\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  {googleAccessToken ? (\n                    <button\n                      onClick={() => handleSyncGoogle(hr.id)}\n                      disabled={syncingId === hr.id}\n                      className=\"px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-semibold rounded-lg border border-slate-700 transition-colors flex items-center gap-1 cursor-pointer\"\n                    >\n                      <Calendar className=\"w-3 h-3 text-amber-400\" />\n                      Google Cal\n                    </button>\n                  ) : (\n                    <a\n                      href={googleDirectUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-semibold rounded-lg border border-slate-700 transition-colors flex items-center gap-1\"\n                    >\n                      <ExternalLink className=\"w-3 h-3 text-amber-400\" />\n                      Google Cal\n                    </a>\n                  )}\n\n                  <button\n                    onClick={() => handleDownloadIcs(hr, c)}\n                    className=\"p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg border border-slate-700 transition-colors\"\n                    title=\"Exportar archivo .ics\"\n                  >\n                    <Download className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <button\n                    onClick={() => deleteHearing(hr.id)}\n                    className=\"p-1.5 text-slate-500 hover:text-rose-400 rounded-lg transition-colors\"\n                    title=\"Eliminar audiencia\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
