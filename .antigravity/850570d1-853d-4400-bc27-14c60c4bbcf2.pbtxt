  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport {\n  Users,\n  UserPlus,\n  Phone,\n  Mail,\n  MapPin,\n  Briefcase,\n  Building2,\n  User,\n  Trash2,\n  MessageCircle,\n  DollarSign,\n  Plus,\n} from \'lucide-react\';\nimport { formatCurrency } from \'../../utils/chileanLegal\';\n\ninterface Props {\n  onOpenNewClient: () => void;\n  onOpenNewCaseForClient: (clientId: string) => void;\n}\n\nexport const ClientsView: React.FC<Props> = ({ onOpenNewClient, onOpenNewCaseForClient }) => {\n  const { clients, cases, installments, searchQuery, deleteClient, setSelectedCaseId, setActiveTab } = useLegal();\n\n  const filteredClients = clients.filter((cli) => {\n    if (!searchQuery.trim()) return true;\n    const q = searchQuery.toLowerCase();\n    return (\n      cli.name.toLowerCase().includes(q) ||\n      cli.rut.toLowerCase().includes(q) ||\n      cli.email.toLowerCase().includes(q) ||\n      cli.phone.toLowerCase().includes(q)\n    );\n  });\n\n  return (\n    <div className=\"space-y-6 pb-12\">\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold font-legal-heading text-slate-100 flex items-center gap-2.5\">\n            <Users className=\"w-6 h-6 text-amber-400\" />\n            Directorio de Clientes\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Personas naturales y jur\303\255dicas patrocinadas por BDCM Abogados\n          </p>\n        </div>\n\n        <button\n          onClick={onOpenNewClient}\n          className=\"px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-semibold text-xs rounded-xl shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2 self-start cursor-pointer\"\n        >\n          <UserPlus className=\"w-4 h-4\" />\n          Nuevo Cliente\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredClients.map((cli) => {\n          const clientCases = cases.filter((c) => c.clientId === cli.id);\n          const clientInstallments = installments.filter((i) => i.clientId === cli.id);\n          const pendingBalance = clientInstallments\n            .filter((i) => i.status !== \'PAGADA\' && i.currency === \'CLP\')\n            .reduce((acc, curr) => acc + curr.amount, 0);\n\n          const cleanPhone = cli.phone.replace(/[^0-9]/g, \'\');\n\n          return (\n            <div\n              key={cli.id}\n              className=\"bg-slate-900/80 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 flex flex-col justify-between space-y-4 shadow-sm transition-all\"\n            >\n              <div className=\"space-y-3\">\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <div className=\"w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-amber-400\">\n                      {cli.clientType === \'PERSONA_JURIDICA\' ? (\n                        <Building2 className=\"w-5 h-5\" />\n                      ) : (\n                        <User className=\"w-5 h-5\" />\n                      )}\n                    </div>\n                    <div>\n                      <h3 className=\"text-sm font-bold text-slate-100 line-clamp-1\">{cli.name}</h3>\n                      <p className=\"text-xs font-mono-legal text-amber-400\">{cli.rut}</p>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => deleteClient(cli.id)}\n                    className=\"p-1.5 text-slate-500 hover:text-rose-400 rounded-lg transition-colors\"\n                    title=\"Eliminar cliente\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n\n                {cli.representativeName && (\n                  <div className=\"text-[11px] bg-slate-950/60 p-2 rounded-lg text-slate-400 border border-slate-800\">\n                    <span className=\"text-slate-300 font-medium\">Rep. Legal: </span>\n                    {cli.representativeName} {cli.representativeRut && `(${cli.representativeRut})`}\n                  </div>\n                )}\n\n                <div className=\"space-y-1.5 text-xs text-slate-300\">\n                  {cli.email && (\n                    <div className=\"flex items-center gap-2 text-slate-400 truncate\">\n                      <Mail className=\"w-3.5 h-3.5 text-slate-500 shrink-0\" />\n                      <a href={`mailto:${cli.email}`} className=\"hover:text-amber-400 truncate\">\n                        {cli.email}\n                      </a>\n                    </div>\n                  )}\n\n                  {cli.phone && (\n                    <div className=\"flex items-center justify-between text-slate-400\">\n                      <div className=\"flex items-center gap-2\">\n                        <Phone className=\"w-3.5 h-3.5 text-slate-500 shrink-0\" />\n                        <span>{cli.phone}</span>\n                      </div>\n                      <a\n                        href={`https://wa.me/${cleanPhone}`}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"px-2 py-0.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 rounded-md text-[10px] font-semibold flex items-center gap-1 transition-colors\"\n                      >\n                        <MessageCircle className=\"w-3 h-3\" />\n                        WhatsApp\n                      </a>\n                    </div>\n                  )}\n\n                  {cli.address && (\n                    <div className=\"flex items-center gap-2 text-slate-400 truncate\">\n                      <MapPin className=\"w-3.5 h-3.5 text-slate-500 shrink-0\" />\n                      <span className=\"truncate\">\n                        {cli.address}, {cli.commune}\n                      </span>\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Causas y Honorarios del cliente */}\n              <div className=\"pt-3 border-t border-slate-800 space-y-2\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <span className=\"text-slate-400\">Causas radicadas:</span>\n                  <span className=\"font-bold text-slate-200\">{clientCases.length}</span>\n                </div>\n\n                {clientCases.length > 0 && (\n                  <div className=\"space-y-1\">\n                    {clientCases.slice(0, 2).map((c) => (\n                      <div\n                        key={c.id}\n                        onClick={() => {\n                          setSelectedCaseId(c.id);\n                          setActiveTab(\'cases\');\n                        }}\n                        className=\"text-[11px] p-1.5 bg-slate-950/40 rounded-md text-amber-300 hover:bg-slate-800 transition-colors cursor-pointer flex items-center justify-between\"\n                      >\n                        <span className=\"font-mono-legal truncate max-w-[170px]\">{c.rol}</span>\n                        <span className=\"text-[10px] text-slate-400\">{c.subject}</span>\n                      </div>\n                    ))}\n                  </div>\n                )}\n\n                <div className=\"flex items-center justify-between pt-1 text-xs\">\n                  <span className=\"text-slate-400\">Saldo pendiente:</span>\n                  <span className=\"font-mono-legal font-bold text-emerald-400\">\n                    {formatCurrency(pendingBalance, \'CLP\')}\n                  </span>\n                </div>\n\n                <button\n                  onClick={() => onOpenNewCaseForClient(cli.id)}\n                  className=\"w-full py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-300 text-xs font-semibold rounded-lg border border-slate-700 transition-colors flex items-center justify-center gap-1.5 cursor-pointer\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  Abrir Expediente para este Cliente\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/views/ClientsView.tsx"
        }
        overwrite: true
      }
    }
