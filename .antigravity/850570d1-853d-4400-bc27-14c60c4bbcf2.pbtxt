  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport { FeeInstallment } from \'../../types\';\nimport { formatCurrency, formatDateCL } from \'../../utils/chileanLegal\';\nimport { X, CheckCircle, Receipt, CreditCard } from \'lucide-react\';\n\ninterface Props {\n  installment: FeeInstallment | null;\n  onClose: () => void;\n  onReceiptOpen?: (inst: FeeInstallment) => void;\n}\n\nexport const RegisterPaymentModal: React.FC<Props> = ({ installment, onClose, onReceiptOpen }) => {\n  const { markInstallmentPaid } = useLegal();\n\n  const [paymentMethod, setPaymentMethod] = useState<\'TRANSFERENCIA\' | \'VALE_VISTA\' | \'CHEQUE\' | \'WEBPAY\' | \'EFECTIVO\'>(\'TRANSFERENCIA\');\n  const [receiptFolio, setReceiptFolio] = useState(\'\');\n  const [notes, setNotes] = useState(\'\');\n\n  if (!installment) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    markInstallmentPaid(installment.id, {\n      paymentMethod,\n      receiptFolio: receiptFolio.trim() || undefined,\n      notes: notes.trim() || undefined,\n    });\n\n    if (onReceiptOpen) {\n      onReceiptOpen({\n        ...installment,\n        status: \'PAGADA\',\n        paymentMethod,\n        receiptFolio: receiptFolio.trim() || undefined,\n        paidDate: new Date().toISOString().split(\'T\')[0],\n      });\n    }\n\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150\">\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400\">\n              <CheckCircle className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-slate-100 font-legal-heading\">Registrar Pago</h2>\n              <p className=\"text-xs text-slate-400\">\n                Cuota {installment.installmentNumber} de {installment.totalInstallments}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-4\">\n          <div className=\"bg-emerald-950/30 border border-emerald-500/30 rounded-xl p-4 text-center\">\n            <span className=\"text-xs text-emerald-400 font-medium block mb-1\">Monto de la Cuota</span>\n            <div className=\"text-2xl font-bold text-emerald-300 font-mono-legal\">\n              {formatCurrency(installment.amount, installment.currency)}\n            </div>\n            <span className=\"text-[11px] text-slate-400 mt-1 block\">\n              Vencimiento original: {formatDateCL(installment.dueDate)}\n            </span>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Medio de Pago <span className=\"text-amber-400\">*</span>\n            </label>\n            <select\n              value={paymentMethod}\n              onChange={(e) => setPaymentMethod(e.target.value as any)}\n              className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              required\n            >\n              <option value=\"TRANSFERENCIA\">Transferencia Bancaria Electr\303\263nica</option>\n              <option value=\"VALE_VISTA\">Vale Vista Bancario</option>\n              <option value=\"CHEQUE\">Cheque al D\303\255a / Nominativo</option>\n              <option value=\"WEBPAY\">Webpay / Tarjeta de D\303\251bito o Cr\303\251dito</option>\n              <option value=\"EFECTIVO\">Efectivo en Despacho</option>\n            </select>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              N\302\260 Boleta de Honorarios SII / Factura Exenta\n            </label>\n            <input\n              type=\"text\"\n              value={receiptFolio}\n              onChange={(e) => setReceiptFolio(e.target.value)}\n              placeholder=\"Ej: BHE-1048 o Factura N\302\260 350\"\n              className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 font-mono-legal\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Observaciones del Comprobante\n            </label>\n            <textarea\n              rows={2}\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              placeholder=\"Banco origen, c\303\263digo de operaci\303\263n bancaria o notas...\"\n              className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 resize-none\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 text-sm text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-5 py-2 bg-linear-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-semibold text-sm rounded-lg shadow-lg shadow-emerald-500/20 transition-all flex items-center gap-2 cursor-pointer\"\n            >\n              <Receipt className=\"w-4 h-4\" />\n              Confirmar Pago\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
        path {
