  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useLegal } from \'../../context/LegalContext\';\nimport { FeeType } from \'../../types\';\nimport { formatCurrency } from \'../../utils/chileanLegal\';\nimport { X, DollarSign, Calculator, Layers } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  preselectedCaseId?: string;\n}\n\nexport const NewFeeAgreementModal: React.FC<Props> = ({ isOpen, onClose, preselectedCaseId }) => {\n  const { cases, clients, addFeeAgreementWithInstallments } = useLegal();\n\n  const [caseId, setCaseId] = useState(preselectedCaseId || (cases[0]?.id || \'\'));\n  const selectedCase = cases.find((c) => c.id === caseId);\n  const [feeType, setFeeType] = useState<FeeType>(\'FIJO\');\n  const [currency, setCurrency] = useState<\'CLP\' | \'UF\'>(\'CLP\');\n  const [totalAmount, setTotalAmount] = useState<number>(1500000);\n  const [installmentsCount, setInstallmentsCount] = useState<number>(3);\n  const [notes, setNotes] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const clientId = selectedCase?.clientId || clients[0]?.id || \'\';\n  const installmentAmount = Math.round(totalAmount / (installmentsCount || 1));\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!caseId || !totalAmount || installmentsCount < 1) {\n      alert(\'Por favor completa todos los campos requeridos.\');\n      return;\n    }\n\n    addFeeAgreementWithInstallments({\n      caseId,\n      clientId,\n      feeType,\n      currency,\n      totalAmount,\n      installmentsCount,\n      notes: notes.trim(),\n    });\n\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-150\">\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400\">\n              <DollarSign className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-slate-100 font-legal-heading\">Convenio de Honorarios</h2>\n              <p className=\"text-xs text-slate-400\">Pacto de honorarios y calendario de cuotas</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-4 max-h-[75vh] overflow-y-auto\">\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Causa Judicial Asociada <span className=\"text-amber-400\">*</span>\n            </label>\n            <select\n              value={caseId}\n              onChange={(e) => setCaseId(e.target.value)}\n              className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              required\n            >\n              {cases.map((c) => (\n                <option key={c.id} value={c.id}>\n                  {c.rol} - {c.caratula}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Modalidad de Cobro\n              </label>\n              <select\n                value={feeType}\n                onChange={(e) => setFeeType(e.target.value as FeeType)}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              >\n                <option value=\"FIJO\">Suma Fija Pactada</option>\n                <option value=\"MIXTO\">Fijo + Cuota Litis</option>\n                <option value=\"CUOTA_LITIS\">Cuota Litis al \303\211xito</option>\n                <option value=\"MENSUAL\">Retainer / Mensual</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Moneda\n              </label>\n              <select\n                value={currency}\n                onChange={(e) => setCurrency(e.target.value as \'CLP\' | \'UF\')}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400\"\n              >\n                <option value=\"CLP\">Pesos Chilenos (CLP $)</option>\n                <option value=\"UF\">Unidades de Fomento (UF)</option>\n              </select>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                Monto Total Convenido <span className=\"text-amber-400\">*</span>\n              </label>\n              <input\n                type=\"number\"\n                min=\"0\"\n                value={totalAmount}\n                onChange={(e) => setTotalAmount(Number(e.target.value))}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\"\n                required\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n                N\303\272mero de Cuotas <span className=\"text-amber-400\">*</span>\n              </label>\n              <input\n                type=\"number\"\n                min=\"1\"\n                max=\"36\"\n                value={installmentsCount}\n                onChange={(e) => setInstallmentsCount(Number(e.target.value))}\n                className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-hidden focus:border-amber-400 font-mono-legal\"\n                required\n              />\n            </div>\n          </div>\n\n          {/* Resumen del plan de cuotas */}\n          <div className=\"bg-slate-950/70 border border-slate-800 rounded-xl p-4 space-y-2\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span className=\"flex items-center gap-1.5 font-medium text-slate-300\">\n                <Layers className=\"w-3.5 h-3.5 text-amber-400\" />\n                Estructura de Cuotas\n              </span>\n              <span className=\"text-emerald-400 font-semibold font-mono-legal\">\n                {installmentsCount} cuotas de {formatCurrency(installmentAmount, currency)}\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-400 leading-relaxed\">\n              Las cuotas se programar\303\241n con vencimientos mensuales a partir del mes en curso, con seguimiento autom\303\241tico de cobranza en BDCM Abogados.\n            </p>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-300 mb-1\">\n              Estipulaciones del Convenio\n            </label>\n            <textarea\n              rows={2}\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              placeholder=\"Ej: Incluye gastos de receptor judicial hasta $150.000, 10% adicional sobre suma recuperada en sentencia o transacci\303\263n...\"\n              className=\"w-full bg-slate-800/90 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-hidden focus:border-amber-400 resize-none\"\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 text-sm text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-5 py-2 bg-linear-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-semibold text-sm rounded-lg shadow-lg shadow-emerald-500/20 transition-all flex items-center gap-2 cursor-pointer\"\n            >\n              <DollarSign className=\"w-4 h-4\" />\n              Generar Cuotas\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/modals/NewFeeAgreementModal.tsx"
        }
        overwrite: true
      }
    }
