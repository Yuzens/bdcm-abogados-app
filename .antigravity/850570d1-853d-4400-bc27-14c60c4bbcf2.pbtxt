            }
            lines {
              text: "export function getDaysRemaining(targetDateStr: string): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [y, m, d] = targetDateStr.split(\'-\').map(Number);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const target = new Date(y, m - 1, d);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const today = new Date();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  today.setHours(0, 0, 0, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target.setHours(0, 0, 0, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const diffTime = target.getTime() - today.getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.round(diffTime / (1000 * 60 * 60 * 24));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
