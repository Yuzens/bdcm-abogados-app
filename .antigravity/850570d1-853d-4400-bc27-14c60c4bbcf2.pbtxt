  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { useLegal } from \'../context/LegalContext\';\nimport {\n  LayoutDashboard,\n  Briefcase,\n  Users,\n  Clock,\n  Calendar,\n  DollarSign,\n  Wrench,\n  Shield,\n  Scale,\n} from \'lucide-react\';\n\ninterface Props {\n  onCloseMobile?: () => void;\n}\n\nexport const Sidebar: React.FC<Props> = ({ onCloseMobile }) => {\n  const { activeTab, setActiveTab, cases, clients, deadlines, hearings, installments } = useLegal();\n\n  // Calcular contadores\n  const todayStr = new Date().toISOString().split(\'T\')[0];\n  const activeCasesCount = cases.filter((c) => c.status !== \'TERMINADA\' && c.status !== \'ARCHIVADA\').length;\n  const urgentDeadlinesCount = deadlines.filter((d) => d.status === \'PENDIENTE\' && d.deadlineDate <= todayStr).length;\n  const upcomingHearingsCount = hearings.filter((h) => h.status === \'PROGRAMADA\').length;\n  const overdueInstallmentsCount = installments.filter((i) => i.status === \'ATRASADA\').length;\n\n  const navItems = [\n    {\n      id: \'dashboard\',\n      label: \'Escritorio\',\n      icon: LayoutDashboard,\n      badge: null,\n      badgeColor: \'\',\n    },\n    {\n      id: \'cases\',\n      label: \'Causas & Expedientes\',\n      icon: Briefcase,\n      badge: activeCasesCount,\n      badgeColor: \'bg-slate-800 text-slate-300\',\n    },\n    {\n      id: \'clients\',\n      label: \'Clientes\',\n      icon: Users,\n      badge: clients.length,\n      badgeColor: \'bg-slate-800 text-slate-300\',\n    },\n    {\n      id: \'deadlines\',\n      label: \'Plazos Procesales\',\n      icon: Clock,\n      badge: urgentDeadlinesCount > 0 ? `${urgentDeadlinesCount} hoy` : deadlines.filter((d) => d.status === \'PENDIENTE\').length,\n      badgeColor: urgentDeadlinesCount > 0 ? \'bg-rose-500/20 text-rose-300 border border-rose-500/30\' : \'bg-slate-800 text-slate-300\',\n    },\n    {\n      id: \'hearings\',\n      label: \'Audiencias & Agenda\',\n      icon: Calendar,\n      badge: upcomingHearingsCount,\n      badgeColor: \'bg-blue-500/20 text-blue-300 border border-blue-500/30\',\n    },\n    {\n      id: \'fees\',\n      label: \'Honorarios & Cuotas\',\n      icon: DollarSign,\n      badge: overdueInstallmentsCount > 0 ? `${overdueInstallmentsCount} mora` : null,\n      badgeColor: \'bg-amber-500/20 text-amber-300 border border-amber-500/30\',\n    },\n    {\n      id: \'tools\',\n      label: \'Herramientas & PJUD\',\n      icon: Wrench,\n      badge: \'Calculadora\',\n      badgeColor: \'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20\',\n    },\n  ];\n\n  const handleNav = (tabId: any) => {\n    setActiveTab(tabId);\n    if (onCloseMobile) onCloseMobile();\n  };\n\n  return (\n    <aside className=\"w-64 bg-slate-950 border-r border-slate-800/90 flex flex-col justify-between shrink-0 h-[calc(100vh-4rem)] sticky top-16 select-none\">\n      <div className=\"p-4 space-y-1.5 overflow-y-auto\">\n        <div className=\"px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-slate-400\">\n          M\303\263dulos del Despacho\n        </div>\n\n        {navItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeTab === item.id;\n\n          return (\n            <button\n              key={item.id}\n              onClick={() => handleNav(item.id)}\n              className={`w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${\n                isActive\n                  ? \'bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-xs shadow-amber-500/10 font-semibold\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-900/80 border border-transparent\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <Icon className={`w-4 h-4 ${isActive ? \'text-amber-400\' : \'text-slate-400\'}`} />\n                <span>{item.label}</span>\n              </div>\n\n              {item.badge !== null && (\n                <span className={`px-2 py-0.5 rounded-md text-[10px] font-mono-legal font-medium ${item.badgeColor}`}>\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Footer Info Despacho */}\n      <div className=\"p-4 border-t border-slate-900 bg-slate-950/60\">\n        <div className=\"bg-slate-900/70 border border-slate-800/80 rounded-xl p-3 space-y-1.5\">\n          <div className=\"flex items-center gap-2 text-xs font-semibold text-slate-200\">\n            <Shield className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>BDCM Abogados</span>\n          </div>\n          <p className=\"text-[10px] text-slate-400 leading-tight\">\n            Jurisdicci\303\263n Nacional \342\200\242 Poder Judicial de Chile\n          </p>\n          <div className=\"pt-1 flex items-center gap-1.5 text-[10px] text-slate-400\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span>\n            <span>Sistema Local & Cloud Sync</span>\n          </div>\n        </div>\n      </div>\n    </aside>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Sidebar.tsx"
        }
        overwrite: true
      }
    }
